.env
.env.local
.env.*.local
!.env.example

# Build artifacts
dist/
build/

# Generated files
internal/web/templates/**/*_templ.go
static/css/output.css

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
.tmp/

