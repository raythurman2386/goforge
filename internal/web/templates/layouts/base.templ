package layouts

import (
	"fmt"

	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
)

templ Base(title, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - GoForge</title>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="icon" href="/favicon.ico" sizes="any"/>
			<link rel="preload" href="/static/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="theme-color" content="#f9fafb" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#030712" media="(prefers-color-scheme: dark)"/>
			<link rel="stylesheet" href={ cssHref() }/>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/htmx-sse.js"></script>
			<script src="/static/js/app.js"></script>
			<script src="/static/js/ui.js"></script>
		</head>
		<body class="min-h-screen bg-gray-50 dark:bg-gray-950"
			if csrfToken != "" {
				hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken) }
			}
		>
			{ children... }
			<!-- Toast live region: server toasts swap in via hx-swap-oob, client toasts via app.js -->
			<div id="toast" role="status" aria-live="polite" class="fixed bottom-5 right-5 z-50 flex flex-col items-end space-y-2"></div>
			<!-- The kit confirm dialog for every hx-confirm (static/js/ui.js). Outside every polled region. -->
			@ui.ConfirmDialog()
		</body>
	</html>
}

templ AuthLayout(title, csrfToken string) {
	@Base(title, csrfToken) {
		<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-8">
				{ children... }
			</div>
		</div>
	}
}

templ AppLayout(title, csrfToken string) {
	@Base(title, csrfToken) {
		<div class="min-h-screen flex flex-col md:flex-row bg-gray-50/50 relative dark:bg-gray-950">
			<!-- Mobile header: the menu button opens the navigation Sheet (components.MobileNav). -->
			<div class="md:hidden flex items-center justify-between bg-white/95 backdrop-blur-sm border-b border-gray-200/60 px-4 py-3 shadow-sm z-30 sticky top-0 dark:bg-gray-900/95 dark:border-gray-800/60">
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, Size: ui.ButtonIcon, Label: "Open navigation menu", Class: "-ml-2", Attrs: ui.Attrs(ui.OpenSheetAttrs(components.MobileNavID), templ.Attributes{"id": "mobile-menu-btn"})}) {
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
				}
				<span class="text-lg font-bold tracking-tight text-gray-900 dark:text-gray-100">GoForge</span>
				<div class="w-10"></div> <!-- Placeholder to balance flex (width matches button) -->
			</div>
			@components.Sidebar(csrfToken)
			<!-- Main content -->
			<main class="flex-1 overflow-auto">
				<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
					{ children... }
				</div>
			</main>
		</div>
		@components.MobileNav(csrfToken)
	}
}
