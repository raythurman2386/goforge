package pages

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

templ Login(csrfToken, errorMessage string, enableRegistration bool) {
	@layouts.AuthLayout("Login", csrfToken) {
		@authHeader("Sign in to GoForge", "Deploy your applications with ease")
		@ui.Card(ui.CardProps{Class: "space-y-6"}) {
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Href: "/auth/github", Class: "w-full border-transparent bg-gray-900 text-white hover:bg-gray-800 dark:bg-gray-800 dark:hover:bg-gray-700 dark:ring-1 dark:ring-gray-700"}) {
				<svg class="-ml-1 mr-2 h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
				</svg>
				Sign in with GitHub
			}

			<div class="relative">
				<div class="absolute inset-0 flex items-center" aria-hidden="true">
					<div class="w-full border-t border-gray-200 dark:border-gray-800"></div>
				</div>
				<div class="relative flex justify-center text-sm">
					<span class="bg-white px-2 text-gray-500 dark:bg-gray-900 dark:text-gray-400">Or continue with email</span>
				</div>
			</div>

			<form class="space-y-5" action="/auth/login" method="POST">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div>
					<label for="email-address" class="label">Email address</label>
					<input id="email-address" name="email" type="email" autocomplete="email" required class="input" placeholder="you@example.com"/>
				</div>
				<div>
					<label for="password" class="label">Password</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required class="input"/>
				</div>
				<div class="flex items-center">
					<input id="remember-me" name="remember_me" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-700 dark:text-primary-400"/>
					<label for="remember-me" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">Remember me</label>
				</div>
				if errorMessage != "" {
					@ui.AlertMessage(ui.AlertError, errorMessage)
				}
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit", Class: "w-full"}) {
					Sign in
				}
			</form>
		}

		if enableRegistration {
			<p class="text-center text-sm text-gray-600 dark:text-gray-400">
				Don't have an account?
				<a href="/auth/register" class="font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400">Sign up</a>
			</p>
		}
	}
}
