package projects

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

templ List(projects []*models.Project, csrfToken string) {
	@layouts.AppLayout("Projects", csrfToken) {
		@components.PageHeader("Projects", "View and manage your application projects.") {
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonPrimary,
					Attrs: templ.Attributes{
						"hx-get": "/projects/new",
						"hx-target": "body",
						"hx-push-url": "true",
					},
				}) {
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					New Project
				}
		}

		if len(projects) == 0 {
			@components.EmptyState(components.EmptyStateProps{
				Title:       "No projects",
				Description: "Get started by creating your first project.",
				ButtonText:  "Create Project",
				ButtonURL:   "/projects/new",
				Icon:        "folder",
			})
		} else {
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
				for _, p := range projects {
					@ui.Card(ui.CardProps{
						Href: templ.URL("/projects/" + p.ID),
						Class: "hover:shadow-lg hover:shadow-primary-100/30 transition-all duration-300 group",
					}) {
						<div class="flex items-center justify-between mb-4">
							<div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center text-primary-600 group-hover:bg-primary-600 group-hover:text-white transition-colors dark:bg-primary-900/30 dark:text-primary-400">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
								</svg>
							</div>
						</div>
						<h3 class="text-lg font-bold text-foreground truncate tracking-tight">{ p.Name }</h3>
						<p class="mt-2 text-sm text-muted-foreground truncate font-mono bg-muted/50 p-2 rounded-md">
							{ p.RepositoryURL }
						</p>
						<div class="mt-6 pt-4 border-t border-divider flex items-center justify-between text-[11px] font-medium text-muted-foreground">
							<div class="flex items-center">
								<svg class="mr-1.5 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								{ p.UpdatedAt.Format("Jan 02, 2006") }
							</div>
							<div class="flex items-center text-primary-700 group-hover:translate-x-1 transition-transform dark:text-primary-400">
								View Details
								<svg class="ml-1 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
								</svg>
							</div>
						</div>
					}
				}
			</div>
		}
	}
}
