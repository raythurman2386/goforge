package projects

import (
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

templ List(projects []*models.Project, csrfToken string) {
	@layouts.AppLayout("Projects", csrfToken) {
		<div class="md:flex md:items-center md:justify-between mb-8">
			<div class="flex-1 min-w-0">
				<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
					Projects
				</h2>
				<p class="mt-2 text-sm text-gray-500">View and manage your application projects.</p>
			</div>
			<div class="mt-4 flex md:mt-0 md:ml-4">
				<button hx-get="/projects/new" hx-target="body" hx-push-url="true" class="btn-primary">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					New Project
				</button>
			</div>
		</div>

		if len(projects) == 0 {
			@components.EmptyState(
				"No projects",
				"Get started by creating your first project.",
				"Create Project",
				"/projects/new",
			)
		} else {
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
				for _, p := range projects {
					<a href={ templ.URL("/projects/" + p.ID) } class="card hover:shadow-lg hover:shadow-primary-100/30 transition-all duration-300 group">
						<div class="flex items-center justify-between mb-4">
							<div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center text-primary-600 group-hover:bg-primary-600 group-hover:text-white transition-colors">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
								</svg>
							</div>
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
								Active
							</span>
						</div>
						<h3 class="text-lg font-bold text-gray-900 truncate tracking-tight">{ p.Name }</h3>
						<p class="mt-2 text-sm text-gray-500 truncate font-mono bg-gray-50 p-2 rounded-md">
							{ p.RepositoryURL }
						</p>
						<div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-[11px] font-medium text-gray-400">
							<div class="flex items-center">
								<svg class="mr-1.5 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								{ p.UpdatedAt.Format("Jan 02, 2006") }
							</div>
							<div class="flex items-center text-primary-600 group-hover:translate-x-1 transition-transform">
								View Details
								<svg class="ml-1 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
								</svg>
							</div>
						</div>
					</a>
				}
			</div>
		}
	}
}
