package projects

import (
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

templ New(sources []*models.GitSource, csrfToken string) {
	@layouts.AppLayout("New Project", csrfToken) {
		<div class="max-w-3xl mx-auto">
			<div class="md:flex md:items-center md:justify-between mb-8">
				<div class="flex-1 min-w-0">
					<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
						Create Project
					</h2>
					<p class="mt-2 text-sm text-gray-500">Connect your repository to start deploying your application.</p>
				</div>
			</div>

			<div class="card">
				<form class="space-y-8" action="/projects" method="POST">
					<input type="hidden" name="csrf_token" value={ csrfToken } />
					
					@components.Input("Project Name", "name", "text", "", true)
					
					@components.GitRepositoryBrowser(sources)
					
					<div class="grid grid-cols-1 gap-y-6 gap-x-6 sm:grid-cols-6 border-t border-gray-100 pt-8">
						<div class="sm:col-span-2">
							<label class="label">Default Branch</label>
							<select name="default_branch" id="default_branch" class="select">
								<option value="main">main</option>
								<option value="master">master</option>
							</select>
						</div>
						<div class="sm:col-span-2">
							@components.Input("Dockerfile Path", "dockerfile_path", "text", "Dockerfile", true)
						</div>
						<div class="sm:col-span-2">
							@components.Input("Build Context", "build_context", "text", ".", true)
						</div>
					</div>
					
					<div class="pt-8 border-t border-gray-100 flex justify-end space-x-3">
						<a href="/projects" class="btn-secondary">
							Cancel
						</a>
						@components.Button("Create Project", "primary")
					</div>
				</form>
			</div>
		</div>
	}
}
