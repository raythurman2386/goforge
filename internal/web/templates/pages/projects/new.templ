package projects

import (
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

templ New(sources []*models.GitSource, serviceInstances []*models.ServiceInstance, csrfToken string) {
	@layouts.AppLayout("New Project", csrfToken) {
		<div class="max-w-3xl mx-auto">
			<div class="md:flex md:items-center md:justify-between mb-8">
				<div class="flex-1 min-w-0">
					<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
						Create Project
					</h2>
					<p class="mt-2 text-sm text-gray-500">Connect your repository to start deploying your application.</p>
				</div>
			</div>

			<div class="card">
				<form class="space-y-8" action="/projects" method="POST">
					<input type="hidden" name="csrf_token" value={ csrfToken } />
					
					@components.Input("Project Name", "name", "text", "", true)
					
					@components.GitRepositoryBrowser(sources)
					
					<div class="grid grid-cols-1 gap-y-6 gap-x-6 sm:grid-cols-6 border-t border-gray-100 pt-8">
						<div class="sm:col-span-2">
							<label class="label">Default Branch</label>
							<select name="default_branch" id="default_branch" class="select">
								<option value="main">main</option>
								<option value="master">master</option>
							</select>
						</div>
						<div class="sm:col-span-2">
							@components.Input("Dockerfile Path", "dockerfile_path", "text", "Dockerfile", true)
						</div>
						<div class="sm:col-span-2">
							@components.Input("Build Context", "build_context", "text", ".", true)
						</div>
					</div>

					if len(serviceInstances) > 0 {
						<div class="border-t border-gray-100 pt-8">
							<div class="mb-4">
								<h4 class="text-xs font-semibold text-primary-600 uppercase tracking-wider">Link Services</h4>
								<p class="mt-1 text-sm text-gray-500">Optionally link running services to inject their connection strings as environment variables during deployment.</p>
							</div>
							<div class="space-y-3">
								for _, inst := range serviceInstances {
									<label class="flex items-center space-x-3 p-3 rounded-lg border border-gray-200 hover:border-primary-300 hover:bg-primary-50/30 transition-colors cursor-pointer">
										<input type="checkbox" name="service_ids" value={ inst.ID } class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
										<div class="flex-1 min-w-0">
											<div class="flex items-center space-x-2">
												<span class="text-sm font-medium text-gray-900">{ inst.Name }</span>
												<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200">{ inst.TemplateName }</span>
											</div>
										</div>
										<span class="px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">running</span>
									</label>
								}
							</div>
						</div>
					}
					
					<div class="pt-8 border-t border-gray-100 flex justify-end space-x-3">
						<a href="/projects" class="btn-secondary">
							Cancel
						</a>
						@components.Button("Create Project", "primary")
					</div>
				</form>
			</div>
		</div>
	}
}
