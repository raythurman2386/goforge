package projects

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

templ New(sources []*models.GitSource, serviceInstances []*models.ServiceInstance, csrfToken string) {
	@layouts.AppLayout("New Project", csrfToken) {
		<div class="max-w-3xl mx-auto">
			<div class="md:flex md:items-center md:justify-between mb-8">
				<div class="flex-1 min-w-0">
					<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">
						Create Project
					</h2>
					<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Connect your repository to start deploying your application.</p>
				</div>
			</div>

			if len(sources) == 0 {
				<div class="mb-8">
					@ui.Alert(ui.AlertProps{Tone: ui.AlertInfo}) {
						<div class="md:flex md:justify-between md:gap-6">
							<p>
								You don't have any Git Sources configured. You can still use public repositories manually, or add a Git Source to select private repositories.
							</p>
							<p class="mt-3 md:mt-0">
								<a href="/settings/git" class="whitespace-nowrap font-semibold underline-offset-2 hover:underline">
									Add Git Source <span aria-hidden="true">&rarr;</span>
								</a>
							</p>
						</div>
					}
				</div>
			}

			@ui.Card(ui.CardProps{}) {
				<form class="space-y-8" action="/projects" method="POST">
					<input type="hidden" name="csrf_token" value={ csrfToken } />
					
					@components.Input("Project Name", "name", "text", "", true)
					
					@components.GitRepositoryBrowser(sources)
					
					<div class="grid grid-cols-1 gap-y-6 gap-x-6 sm:grid-cols-6 border-t border-gray-100 pt-8 dark:border-gray-800">
						<div class="sm:col-span-2">
							<label class="label">Default Branch</label>
							<select name="default_branch" id="default_branch" class="select">
								<option value="main">main</option>
								<option value="master">master</option>
							</select>
						</div>
						<div class="sm:col-span-2">
							@components.Input("Dockerfile Path", "dockerfile_path", "text", "Dockerfile", true)
						</div>
						<div class="sm:col-span-2">
							@components.Input("Build Context", "build_context", "text", ".", true)
						</div>
					</div>

					if len(serviceInstances) > 0 {
						<div class="border-t border-gray-100 pt-8 dark:border-gray-800">
							<div class="mb-4">
								<h4 class="text-xs font-semibold text-primary-600 uppercase tracking-wider dark:text-primary-400">Link Services</h4>
								<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Optionally link running services to inject their connection strings as environment variables during deployment.</p>
							</div>
							<div class="space-y-3">
								for _, inst := range serviceInstances {
									<label class="flex items-center space-x-3 p-3 rounded-lg border border-gray-200 hover:border-primary-300 hover:bg-primary-50/30 transition-colors cursor-pointer dark:border-gray-800 dark:hover:bg-primary-900/30">
										<input type="checkbox" name="service_ids" value={ inst.ID } class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-700 dark:text-primary-400" />
										<div class="flex-1 min-w-0">
											<div class="flex items-center space-x-2">
												<span class="text-sm font-medium text-gray-900 dark:text-gray-100">{ inst.Name }</span>
												<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-800">{ inst.TemplateName }</span>
											</div>
										</div>
										@ui.Badge(ui.BadgeProps{Tone: ui.BadgeSuccess, Class: "px-2"}) {
											running
										}
									</label>
								}
							</div>
						</div>
					}
					
					<div class="pt-8 border-t border-gray-100 flex justify-end space-x-3 dark:border-gray-800">
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Href: "/projects"}) {
							Cancel
						}
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
							Create Project
							@components.Spinner()
						}
					</div>
				</form>
			}
		</div>
	}
}
