package projects

import (
	"github.com/raythurman2386/gocool/internal/web/templates/layouts"
	"github.com/raythurman2386/gocool/internal/web/templates/components"
)

templ New(csrfToken string) {
	@layouts.AppLayout("New Project", csrfToken) {
		<div class="max-w-2xl mx-auto bg-white shadow sm:rounded-lg">
			<div class="px-4 py-5 sm:p-6">
				<h3 class="text-lg font-medium leading-6 text-gray-900">Create a New Project</h3>
				<div class="mt-2 max-w-xl text-sm text-gray-500">
					<p>Connect your repository to start deploying.</p>
				</div>
				<form class="mt-5 space-y-4" action="/projects" method="POST">
					<input type="hidden" name="csrf_token" value={ csrfToken } />
					
					@components.Input("Project Name", "name", "text", "", true)
					@components.Input("Repository URL", "repository_url", "text", "", true)
					
					<div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
						<div class="sm:col-span-2">
							@components.Input("Default Branch", "default_branch", "text", "main", true)
						</div>
						<div class="sm:col-span-2">
							@components.Input("Dockerfile Path", "dockerfile_path", "text", "Dockerfile", true)
						</div>
						<div class="sm:col-span-2">
							@components.Input("Build Context", "build_context", "text", ".", true)
						</div>
					</div>
					
					<div class="pt-4 border-t border-gray-200 flex justify-end space-x-3">
						<a href="/projects" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
							Cancel
						</a>
						@components.Button("Create Project", "primary")
					</div>
				</form>
			</div>
		</div>
	}
}
