package projects

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"time"

	"github.com/raythurman2386/goforge/internal/docker"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

templ Detail(project *models.Project, envs []*models.Environment, currentEnv *models.Environment, latestDeployment *models.Deployment, deployments []*models.Deployment, activeContainer *models.Container, containerSummary *docker.InspectSummary, linkedServices []*models.ServiceInstance, availableServices []*models.ServiceInstance, maskedConn map[string]map[string]string, activeTab string, csrfToken string) {
	@layouts.AppLayout(project.Name, csrfToken) {
		@ui.Breadcrumb([]ui.Crumb{
			{Label: "Projects", Href: "/projects"},
			{Label: project.Name},
		})
		<div class="md:flex md:items-center md:justify-between mb-8">
			<div class="flex-1 min-w-0">
				<div class="flex items-center space-x-4">
					<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">
						{ project.Name }
					</h2>
					if currentEnv != nil {
						@components.EnvironmentSwitcher(project.ID, envs, currentEnv.ID)
					} else {
						@components.EnvironmentSwitcher(project.ID, envs, "")
					}
				</div>
			</div>
			<div class="mt-4 flex md:mt-0 md:ml-4">
				if currentEnv != nil {
					@ui.Button(ui.ButtonProps{
						Variant: ui.ButtonPrimary,
						Attrs: templ.Attributes{
							"hx-post": "/projects/" + project.ID + "/deployments?env_id=" + currentEnv.ID,
							"hx-headers": `{"X-CSRF-Token":"` + csrfToken + `"}`,
							"hx-disabled-elt": "this",
							"hx-indicator": "find .htmx-indicator",
						},
					}) {
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
						Deploy Now
						@components.Spinner()
					}
				}
			</div>
		</div>

		// Show deployment status banner if there's an active deployment
		if latestDeployment != nil && isActiveDeployment(latestDeployment.Status) {
			@DeploymentStatusBanner(project.ID, latestDeployment)
		}

		@ui.NavTabs(ui.NavTabsProps{Label: "Project sections", Class: "mb-8"}) {
			@ui.NavTab(ui.NavTabProps{Href: templ.URL("/projects/" + project.ID + "?env=" + envID(currentEnv)), Current: activeTab == "overview"}) {
				Overview
			}
			@ui.NavTab(ui.NavTabProps{Href: templ.URL("/projects/" + project.ID + "/deployments?env=" + envID(currentEnv)), Current: activeTab == "deployments"}) {
				Deployments
			}
			@ui.NavTab(ui.NavTabProps{Href: templ.URL("/projects/" + project.ID + "/services"), Current: activeTab == "services"}) {
				Services
				if len(linkedServices) > 0 {
					@ui.Badge(ui.BadgeProps{Tone: ui.BadgePrimary, Variant: ui.BadgeSubtle, Class: "ml-2 px-1.5"}) {
						{ fmt.Sprintf("%d", len(linkedServices)) }
					}
				}
			}
			@ui.NavTab(ui.NavTabProps{Href: templ.URL("/projects/" + project.ID + "/settings?env=" + envID(currentEnv)), Current: activeTab == "settings"}) {
				Settings
			}
		}

		if activeTab == "overview" {
			@Overview(project, latestDeployment, activeContainer, containerSummary)
		} else if activeTab == "deployments" {
			@Deployments(project, deployments)
		} else if activeTab == "services" {
			@Services(project, linkedServices, availableServices, maskedConn, csrfToken)
		} else if activeTab == "settings" {
			@ProjectSettings(project, currentEnv, csrfToken)
		}
	}
}

// envID safely returns the environment ID, or an empty string if env is nil.
func envID(env *models.Environment) string {
	if env == nil {
		return ""
	}
	return env.ID
}

func isActiveDeployment(status models.DeploymentStatus) bool {
	return status == models.DeploymentStatusPending ||
		status == models.DeploymentStatusCloning ||
		status == models.DeploymentStatusBuilding ||
		status == models.DeploymentStatusDeploying
}

templ DeploymentStatusBanner(projectID string, deployment *models.Deployment) {
	<div 
		id="deployment-status-banner"
		class="mb-6 p-4 rounded-lg border bg-blue-50 border-blue-200 dark:bg-blue-950/40 dark:border-blue-900"
		hx-get={ "/projects/" + projectID + "/deployments/" + deployment.ID + "/status" }
		hx-trigger="every 3s"
		hx-swap="outerHTML"
	>
		<div class="flex items-center">
			<div class="flex-shrink-0">
				<svg class="animate-spin h-5 w-5 text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
			</div>
			<div class="ml-3">
				<p class="text-sm font-medium text-blue-800 dark:text-blue-200">
					Deployment in progress: 
					<span class="font-bold">{ string(deployment.Status) }</span>
				</p>
			</div>
			<div class="ml-auto">
				<a href={ templ.URL("/projects/" + projectID + "/deployments/" + deployment.ID) } class="text-sm text-blue-600 hover:text-blue-800 font-medium dark:text-blue-400 dark:hover:text-blue-200">
					View Logs
				</a>
			</div>
		</div>
	</div>
}

templ Overview(project *models.Project, latestDeployment *models.Deployment, activeContainer *models.Container, containerSummary *docker.InspectSummary) {
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
		// Main info card
		@ui.Card(ui.CardProps{Flush: true, Class: "lg:col-span-2 overflow-hidden"}) {
			<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 dark:border-gray-800 dark:bg-gray-800/50">
				<h3 class="text-lg font-bold text-gray-900 tracking-tight dark:text-gray-100">Project Overview</h3>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Details and configuration for the current environment.</p>
			</div>
			<dl class="divide-y divide-gray-100 dark:divide-gray-800">
				<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
					<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider dark:text-gray-400">Repository</dt>
					<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono bg-gray-50 p-2 rounded-md border border-gray-100 dark:text-gray-100 dark:bg-gray-800/50 dark:border-gray-800">{ project.RepositoryURL }</dd>
				</div>
				<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
					<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider dark:text-gray-400">Default Branch</dt>
					<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-medium dark:text-gray-100">{ project.DefaultBranch }</dd>
				</div>
				<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
					<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider dark:text-gray-400">Dockerfile</dt>
					<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono dark:text-gray-100">{ project.DockerfilePath }</dd>
				</div>
				<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
					<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider dark:text-gray-400">Build Context</dt>
					<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono dark:text-gray-100">{ project.BuildContext }</dd>
				</div>
			</dl>
		}

		// Latest deployment card
		@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
			<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 dark:border-gray-800 dark:bg-gray-800/50">
				<h3 class="text-lg font-bold text-gray-900 tracking-tight dark:text-gray-100">Latest Deployment</h3>
			</div>
			<div class="p-6">
				if latestDeployment != nil {
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Status</span>
							@components.DeploymentStatusBadge(latestDeployment.Status)
						</div>
						if latestDeployment.Branch.Valid {
							<div class="flex items-center justify-between">
								<span class="text-sm text-gray-500 dark:text-gray-400">Branch</span>
								<span class="text-sm font-mono text-gray-900 dark:text-gray-100">{ latestDeployment.Branch.String }</span>
							</div>
						}
						if latestDeployment.CommitSHA.Valid && latestDeployment.CommitSHA.String != "" {
							<div class="flex items-center justify-between">
								<span class="text-sm text-gray-500 dark:text-gray-400">Commit</span>
								<span class="text-sm font-mono text-gray-900 dark:text-gray-100">{ truncateCommit(latestDeployment.CommitSHA.String) }</span>
							</div>
						}
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Started</span>
							<span class="text-sm text-gray-900 dark:text-gray-100">{ formatTime(latestDeployment.CreatedAt) }</span>
						</div>
						if latestDeployment.ErrorMessage.Valid && latestDeployment.ErrorMessage.String != "" {
							<div class="mt-4">
								@ui.AlertMessage(ui.AlertError, latestDeployment.ErrorMessage.String)
							</div>
						}
						<div class="mt-4 pt-4 border-t border-gray-100 flex justify-end dark:border-gray-800">
							<a href={ templ.URL("/projects/" + project.ID + "/deployments/" + latestDeployment.ID) } class="text-sm text-primary-700 hover:text-primary-800 font-medium hover:underline dark:text-primary-400 dark:hover:text-primary-200">
								View Logs &rarr;
							</a>
						</div>
					</div>
				} else {
					<div class="text-center py-8">
						<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
						<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">No deployments yet</p>
						<p class="text-xs text-gray-500 dark:text-gray-400">Click "Deploy Now" to get started</p>
					</div>
				}
			</div>
		}

		// activeContainer is only ever a running container (see
		// handlers.activeContainer); otherwise the card shows an empty state.
		if activeContainer != nil {
			@components.ResourceUsageCard(activeContainer.DockerID, "lg:col-span-3")
			@components.ContainerCard(activeContainer.DockerID, containerSummary, "lg:col-span-3")
		} else if latestDeployment != nil {
			@components.NoRunningContainer("lg:col-span-3")
		}
	</div>
}

func truncateCommit(sha string) string {
	if len(sha) > 7 {
		return sha[:7]
	}
	return sha
}

func formatTime(t time.Time) string {
	return t.Format("Jan 2, 15:04")
}

templ Deployments(project *models.Project, deployments []*models.Deployment) {
	if len(deployments) == 0 {
		<div class="text-center py-12">
			<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
			</svg>
			<h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-gray-100">No deployments</h3>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Get started by triggering a new deployment.</p>
		</div>
	} else {
		@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
			@ui.Table(ui.TableProps{Caption: "Deployments of " + project.Name})  {
				@ui.THead(nil) {
					@ui.TR(nil) {
						@ui.TH(ui.CellProps{}) { Status }
						@ui.TH(ui.CellProps{}) { Branch / Commit }
						@ui.TH(ui.CellProps{}) { Date }
						@ui.TH(ui.CellProps{}) { Duration }
						@ui.TH(ui.CellProps{Align: ui.CellEnd}) {
							<span class="sr-only">View</span>
						}
					}
				}
				@ui.TBody(nil) {
					for _, d := range deployments {
						@ui.TR(nil) {
							@ui.TD(ui.CellProps{Class: "whitespace-nowrap"}) {
								@components.DeploymentStatusBadge(d.Status)
							}
							@ui.TD(ui.CellProps{Class: "whitespace-nowrap"}) {
								<div class="text-gray-900 dark:text-gray-100">{ d.Branch.String }</div>
								<div class="text-gray-500 font-mono dark:text-gray-400">{ truncateCommit(d.CommitSHA.String) }</div>
							}
							@ui.TD(ui.CellProps{Class: "whitespace-nowrap text-gray-500 dark:text-gray-400"}) {
								{ formatTime(d.CreatedAt) }
							}
							@ui.TD(ui.CellProps{Class: "whitespace-nowrap text-gray-500 dark:text-gray-400"}) {
								if d.FinishedAt.Valid {
									{ formatDuration(d.FinishedAt.Time.Sub(d.StartedAt.Time)) }
								} else if isActiveDeployment(d.Status) {
									<span class="animate-pulse">Running...</span>
								} else {
									-
								}
							}
							@ui.TD(ui.CellProps{Align: ui.CellEnd, Class: "whitespace-nowrap font-medium"}) {
								<a href={ templ.URL("/projects/" + project.ID + "/deployments/" + d.ID) } class="text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-200">View Logs</a>
							}
						}
					}
				}
			}
		}
	}
}

func formatDuration(d time.Duration) string {
	if d < time.Second {
		return "less than 1s"
	}
	d = d.Round(time.Second)
	m := d / time.Minute
	d -= m * time.Minute
	s := d / time.Second
	if m > 0 {
		return fmt.Sprintf("%dm %ds", m, s)
	}
	return fmt.Sprintf("%ds", s)
}

templ Services(project *models.Project, linkedServices []*models.ServiceInstance, availableServices []*models.ServiceInstance, maskedConn map[string]map[string]string, csrfToken string) {
	<div class="space-y-6">
		// Linked services
		@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
			<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center justify-between dark:border-gray-800 dark:bg-gray-800/50">
				<div>
					<h3 class="text-lg font-bold text-gray-900 tracking-tight dark:text-gray-100">Linked Services</h3>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Services attached to this project. Connection strings are auto-injected as environment variables on deploy.</p>
				</div>
			</div>
			<div class="divide-y divide-gray-100 dark:divide-gray-800">
				if len(linkedServices) == 0 {
					<div class="text-center py-12 px-6">
						<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
						</svg>
						<h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-gray-100">No linked services</h3>
						<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Attach a running service below to inject its connection string into deployments.</p>
					</div>
				} else {
					for _, svc := range linkedServices {
						<div class="px-6 py-4 flex items-center justify-between">
							<div class="flex items-center space-x-4 min-w-0">
								<div class="flex-shrink-0">
									<span class="inline-flex items-center justify-center h-10 w-10 rounded-lg bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
										<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
										</svg>
									</span>
								</div>
								<div class="min-w-0">
									<p class="text-sm font-semibold text-gray-900 truncate dark:text-gray-100">{ svc.Name }</p>
									<div class="flex items-center space-x-2 mt-1">
										@ui.Badge(ui.BadgeProps{Square: true, Class: "px-2"}) {
											{ svc.TemplateName }
										}
										@components.StatusBadge("service", string(svc.Status))
									</div>
									if connInfo := maskedConn[svc.ID]; len(connInfo) > 0 {
										<div class="mt-2 space-y-1">
											for key, val := range connInfo {
												<div class="flex items-center space-x-2">
													<span class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">{ key }:</span>
													<code class="text-xs bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-700 font-mono truncate max-w-xs dark:bg-gray-800/50 dark:border-gray-800 dark:text-gray-300">{ val }</code>
												</div>
											}
										</div>
									}
								</div>
							</div>
							@ui.Button(ui.ButtonProps{
								Variant: ui.ButtonGhostDanger,
								Size:    ui.ButtonSM,
								Class:   "ml-4 shrink-0 text-red-700 dark:text-red-300",
								Attrs: templ.Attributes{
									"hx-delete":  "/projects/" + project.ID + "/services/" + svc.ID,
									"hx-confirm": "Detach this service? The connection string will no longer be injected on next deploy.",
									"data-ui-confirm-tone": "danger",
									"data-ui-confirm-label": "Detach",
									"hx-headers": `{"X-CSRF-Token":"` + csrfToken + `"}`,
								},
							}) {
								<svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-5 0-9.27-3.11-11-7.5a11.72 11.72 0 013.168-4.477M6.343 6.343l11.314 11.314"></path>
								</svg>
								Detach
							}
						</div>
					}
				}
			</div>
		}

		// Attach new service
		if len(availableServices) > 0 {
			@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
				<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 dark:border-gray-800 dark:bg-gray-800/50">
					<h3 class="text-lg font-bold text-gray-900 tracking-tight dark:text-gray-100">Attach Service</h3>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Link a running service instance to this project.</p>
				</div>
				<div class="p-6">
					<form hx-post={ "/projects/" + project.ID + "/services" } hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` } hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator" class="flex items-end space-x-4">
						@ui.Select(ui.SelectProps{ID: "attach-service", Name: "service_instance_id", Label: "Service", Options: serviceOptions(availableServices), Blank: true, BlankLabel: "Select a service...", Required: true, Class: "flex-1"})
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.172 13.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.102 1.101"></path>
							</svg>
							Attach
							@components.Spinner()
						}
					</form>
				</div>
			}
		} else if len(linkedServices) == 0 {
			@ui.Card(ui.CardProps{Class: "text-center py-8"}) {
				<p class="text-sm text-gray-500 dark:text-gray-400">No running service instances available to attach.</p>
				<a href="/services" class="mt-2 inline-block text-sm text-primary-700 hover:text-primary-800 font-medium dark:text-primary-400 dark:hover:text-primary-200">
					Deploy a service &rarr;
				</a>
			}
		}
	</div>
}

templ ProjectSettings(project *models.Project, currentEnv *models.Environment, csrfToken string) {
	if currentEnv != nil {
		@ui.Card(ui.CardProps{Class: "mb-8"}) {
			<h3 class="text-lg font-bold text-gray-900 tracking-tight mb-6 dark:text-gray-100">Configuration</h3>
			
			<form hx-put={ "/projects/" + project.ID + "/settings" } hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` } hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
				<input type="hidden" name="env_id" value={ currentEnv.ID } />
				
				<div class="space-y-8 divide-y divide-gray-100 dark:divide-gray-800">
					<!-- Project Defaults Section -->
					<div class="grid grid-cols-1 gap-y-6 sm:grid-cols-6">
						<div class="sm:col-span-6">
							<h4 class="text-xs font-semibold text-primary-700 uppercase tracking-wider mb-2 dark:text-primary-400">Global Defaults</h4>
							<p class="text-sm text-gray-500 dark:text-gray-400">Settings applied to all environments unless overridden.</p>
						</div>

						@ui.Input(ui.InputProps{ID: "settings-custom-domain", Name: "custom_domain", Label: "Default Domain", Value: project.CustomDomain.String, Placeholder: "example.com", Class: "sm:col-span-4"})
					</div>

					<!-- Environment Overrides Section -->
					<div class="pt-8 grid grid-cols-1 gap-y-6 sm:grid-cols-6">
						<div class="sm:col-span-6">
							<div class="flex items-center space-x-2 mb-2">
								<h4 class="text-xs font-semibold text-primary-700 uppercase tracking-wider dark:text-primary-400">Environment Overrides</h4>
								<span class="px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-800">
									{ currentEnv.Name }
								</span>
							</div>
							<p class="text-sm text-gray-500 dark:text-gray-400">Specific settings for this environment.</p>
						</div>

						@ui.Input(ui.InputProps{ID: "settings-domain", Name: "domain", Label: "Domain", Value: currentEnv.Domain.String, Placeholder: "env.example.com", Help: "Overrides global default.", Class: "sm:col-span-3"})
						@ui.Input(ui.InputProps{ID: "settings-port", Name: "port", Type: "number", Label: "Application Port", Value: getPort(currentEnv), Placeholder: "80", Help: "Internal port (e.g., 3000). Default: 80.", Class: "sm:col-span-3"})
						@ui.Input(ui.InputProps{ID: "settings-branch", Name: "branch", Label: "Git Branch", Value: currentEnv.Branch.String, Placeholder: project.DefaultBranch, Help: "Deploys from " + project.DefaultBranch + " when empty.", Class: "sm:col-span-6"})

						<div class="sm:col-span-6 flex items-center justify-between pt-4">
							<p class="inline-flex items-center gap-1.5 text-xs font-medium text-amber-700 dark:text-amber-300">
								<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								Changes to port require redeployment.
							</p>
							@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
								Save Changes
								@components.Spinner()
							}
						</div>
					</div>
				</div>
			</form>
		}
	}

	@ui.Card(ui.CardProps{Class: "border-red-100 bg-red-50/30 dark:border-red-900/60 dark:bg-red-950/40"}) {
		<div class="sm:flex sm:items-start sm:justify-between">
			<div>
				<h3 class="text-lg font-bold text-red-900 tracking-tight dark:text-red-200">Delete Project</h3>
				<div class="mt-2 text-sm text-red-700 dark:text-red-300">
					<p>Once you delete a project, all associated resources and deployments will be permanently removed. This action cannot be undone.</p>
				</div>
			</div>
			<div class="mt-5 sm:mt-0 sm:ml-6 flex-shrink-0">
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonDanger,
					Attrs: templ.Attributes{
						"data-ui-dialog-open": "delete-project-dialog",
						"aria-haspopup": "dialog",
						"data-testid": "delete-project-open",
					},
				}) {
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
					Delete Project
				}
			</div>
		</div>
	}
	@components.TypedDeleteDialog(components.TypedDeleteProps{
		ID:      "delete-project-dialog",
		Title:   "Delete project",
		Kind:    "project",
		Name:    project.Name,
		URL:     "/projects/" + project.ID,
		Warning: "All of this project's resources and deployments are removed. This cannot be undone.",
		Label:   "Delete project",
	})
}


