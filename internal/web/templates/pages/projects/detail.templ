package projects

import (
	"fmt"
	"time"

	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

templ Detail(project *models.Project, envs []*models.Environment, currentEnv *models.Environment, latestDeployment *models.Deployment, deployments []*models.Deployment, activeContainer *models.Container, linkedServices []*models.ServiceInstance, availableServices []*models.ServiceInstance, activeTab string, csrfToken string) {
	@layouts.AppLayout(project.Name, csrfToken, nil) {
		<div class="md:flex md:items-center md:justify-between mb-8">
			<div class="flex-1 min-w-0">
				<div class="flex items-center space-x-4">
					<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
						{ project.Name }
					</h2>
					if currentEnv != nil {
						@components.EnvironmentSwitcher(project.ID, envs, currentEnv.ID)
					} else {
						@components.EnvironmentSwitcher(project.ID, envs, "")
					}
				</div>
			</div>
			<div class="mt-4 flex md:mt-0 md:ml-4">
				if currentEnv != nil {
					<button hx-post={ "/projects/" + project.ID + "/deployments?env_id=" + currentEnv.ID } class="btn-primary">
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
						Deploy Now
					</button>
				}
			</div>
		</div>

		// Show deployment status banner if there's an active deployment
		if latestDeployment != nil && isActiveDeployment(latestDeployment.Status) {
			@DeploymentStatusBanner(project.ID, latestDeployment)
		}

	<div class="mb-8 border-b border-gray-200/60">
		<nav class="-mb-px flex space-x-8" aria-label="Tabs">
			<a href={ templ.URL("/projects/" + project.ID + "?env=" + envID(currentEnv)) } 
				class={ "whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm transition-all duration-200 ", 
					templ.KV("border-primary-600 text-primary-700", activeTab == "overview"),
					templ.KV("border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300", activeTab != "overview") }>
				Overview
			</a>
			<a href={ templ.URL("/projects/" + project.ID + "/deployments?env=" + envID(currentEnv)) }
				class={ "whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm transition-all duration-200 ",
					templ.KV("border-primary-600 text-primary-700", activeTab == "deployments"),
					templ.KV("border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300", activeTab != "deployments") }>
				Deployments
			</a>
			<a href={ templ.URL("/projects/" + project.ID + "/services") }
				class={ "whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm transition-all duration-200 ",
					templ.KV("border-primary-600 text-primary-700", activeTab == "services"),
					templ.KV("border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300", activeTab != "services") }>
				Services
				if len(linkedServices) > 0 {
					<span class="ml-2 px-1.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 text-primary-700">{ fmt.Sprintf("%d", len(linkedServices)) }</span>
				}
			</a>
			<a href={ templ.URL("/projects/" + project.ID + "/settings?env=" + envID(currentEnv)) }
				class={ "whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm transition-all duration-200 ",
					templ.KV("border-primary-600 text-primary-700", activeTab == "settings"),
					templ.KV("border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300", activeTab != "settings") }>
				Settings
			</a>
		</nav>
	</div>

		if activeTab == "overview" {
			@Overview(project, latestDeployment, activeContainer)
		} else if activeTab == "deployments" {
			@Deployments(project, deployments)
		} else if activeTab == "services" {
			@Services(project, linkedServices, availableServices, csrfToken)
		} else if activeTab == "settings" {
			@ProjectSettings(project, currentEnv)
		}
	}
}

// envID safely returns the environment ID, or an empty string if env is nil.
func envID(env *models.Environment) string {
	if env == nil {
		return ""
	}
	return env.ID
}

func isActiveDeployment(status models.DeploymentStatus) bool {
	return status == models.DeploymentStatusPending ||
		status == models.DeploymentStatusCloning ||
		status == models.DeploymentStatusBuilding ||
		status == models.DeploymentStatusDeploying
}

func getStatusColor(status models.DeploymentStatus) string {
	switch status {
	case models.DeploymentStatusRunning:
		return "bg-green-100 text-green-800 border-green-200"
	case models.DeploymentStatusFailed:
		return "bg-red-100 text-red-800 border-red-200"
	case models.DeploymentStatusPending, models.DeploymentStatusCloning, 
		models.DeploymentStatusBuilding, models.DeploymentStatusDeploying:
		return "bg-yellow-100 text-yellow-800 border-yellow-200"
	case models.DeploymentStatusCanceled, models.DeploymentStatusRolledBack:
		return "bg-gray-100 text-gray-800 border-gray-200"
	default:
		return "bg-gray-100 text-gray-800 border-gray-200"
	}
}

templ DeploymentStatusBanner(projectID string, deployment *models.Deployment) {
	<div 
		id="deployment-status-banner"
		class="mb-6 p-4 rounded-lg border bg-blue-50 border-blue-200"
		hx-get={ "/projects/" + projectID + "/deployments/" + deployment.ID + "/status" }
		hx-trigger="every 3s"
		hx-swap="outerHTML"
	>
		<div class="flex items-center">
			<div class="flex-shrink-0">
				<svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
			</div>
			<div class="ml-3">
				<p class="text-sm font-medium text-blue-800">
					Deployment in progress: 
					<span class="font-bold">{ string(deployment.Status) }</span>
				</p>
			</div>
			<div class="ml-auto">
				<a href={ templ.URL("/projects/" + projectID + "/deployments/" + deployment.ID) } class="text-sm text-blue-600 hover:text-blue-800 font-medium">
					View Logs
				</a>
			</div>
		</div>
	</div>
}

templ Overview(project *models.Project, latestDeployment *models.Deployment, activeContainer *models.Container) {
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
		// Main info card
		<div class="lg:col-span-2 card overflow-hidden !p-0">
			<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30">
				<h3 class="text-lg font-bold text-gray-900 tracking-tight">Project Overview</h3>
				<p class="mt-1 text-sm text-gray-500">Details and configuration for the current environment.</p>
			</div>
			<div class="divide-y divide-gray-100">
				<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
					<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider">Repository</dt>
					<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono bg-gray-50 p-2 rounded-md border border-gray-100">{ project.RepositoryURL }</dd>
				</div>
				<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
					<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider">Default Branch</dt>
					<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-medium">{ project.DefaultBranch }</dd>
				</div>
				<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
					<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider">Dockerfile</dt>
					<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono">{ project.DockerfilePath }</dd>
				</div>
				<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
					<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider">Build Context</dt>
					<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono">{ project.BuildContext }</dd>
				</div>
			</div>
		</div>

		// Latest deployment card
		<div class="card overflow-hidden !p-0">
			<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30">
				<h3 class="text-lg font-bold text-gray-900 tracking-tight">Latest Deployment</h3>
			</div>
			<div class="p-6">
				if latestDeployment != nil {
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500">Status</span>
							<span class={ "px-2.5 py-0.5 rounded-full text-xs font-medium border", getStatusColor(latestDeployment.Status) }>
								{ string(latestDeployment.Status) }
							</span>
						</div>
						if latestDeployment.Branch.Valid {
							<div class="flex items-center justify-between">
								<span class="text-sm text-gray-500">Branch</span>
								<span class="text-sm font-mono text-gray-900">{ latestDeployment.Branch.String }</span>
							</div>
						}
						if latestDeployment.CommitSHA.Valid && latestDeployment.CommitSHA.String != "" {
							<div class="flex items-center justify-between">
								<span class="text-sm text-gray-500">Commit</span>
								<span class="text-sm font-mono text-gray-900">{ truncateCommit(latestDeployment.CommitSHA.String) }</span>
							</div>
						}
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500">Started</span>
							<span class="text-sm text-gray-900">{ formatTime(latestDeployment.CreatedAt) }</span>
						</div>
						if latestDeployment.ErrorMessage.Valid && latestDeployment.ErrorMessage.String != "" {
							<div class="mt-4 p-3 bg-red-50 rounded-md border border-red-100">
								<p class="text-sm text-red-700">{ latestDeployment.ErrorMessage.String }</p>
							</div>
						}
						<div class="mt-4 pt-4 border-t border-gray-100 flex justify-end">
							<a href={ templ.URL("/projects/" + project.ID + "/deployments/" + latestDeployment.ID) } class="text-sm text-blue-600 hover:text-blue-800 font-medium hover:underline">
								View Logs &rarr;
							</a>
						</div>
					</div>
				} else {
					<div class="text-center py-8">
						<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
						<p class="mt-2 text-sm text-gray-500">No deployments yet</p>
						<p class="text-xs text-gray-400">Click "Deploy Now" to get started</p>
					</div>
				}
			</div>
		</div>

		if activeContainer != nil {
			<div class="card overflow-hidden !p-0 lg:col-span-3">
				<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30">
					<h3 class="text-lg font-bold text-gray-900 tracking-tight">Resource Usage</h3>
					<p class="mt-1 text-sm text-gray-500">Real-time container performance metrics.</p>
				</div>
				<div class="p-6" hx-ext="sse" sse-connect={ "/containers/" + activeContainer.DockerID + "/stats" }>
					<div sse-swap="stats" class="flex items-center justify-center py-12">
						<div class="flex flex-col items-center">
							<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600 mb-4"></div>
							<p class="text-sm text-gray-400 font-medium">Connecting to metrics stream...</p>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}

func truncateCommit(sha string) string {
	if len(sha) > 7 {
		return sha[:7]
	}
	return sha
}

func formatTime(t time.Time) string {
	return t.Format("Jan 2, 15:04")
}

templ Deployments(project *models.Project, deployments []*models.Deployment) {
	if len(deployments) == 0 {
		<div class="text-center py-12">
			<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
			</svg>
			<h3 class="mt-2 text-sm font-medium text-gray-900">No deployments</h3>
			<p class="mt-1 text-sm text-gray-500">Get started by triggering a new deployment.</p>
		</div>
	} else {
		<div class="flex flex-col">
			<div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
				<div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
					<div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
						<table class="min-w-full divide-y divide-gray-200">
							<thead class="bg-gray-50">
								<tr>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
										Status
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
										Branch / Commit
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
										Date
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
										Duration
									</th>
									<th scope="col" class="relative px-6 py-3">
										<span class="sr-only">View</span>
									</th>
								</tr>
							</thead>
							<tbody class="bg-white divide-y divide-gray-200">
								for _, d := range deployments {
									<tr>
										<td class="px-6 py-4 whitespace-nowrap">
											<span class={ "px-2 inline-flex text-xs leading-5 font-semibold rounded-full border", getStatusColor(d.Status) }>
												{ string(d.Status) }
											</span>
										</td>
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="text-sm text-gray-900">{ d.Branch.String }</div>
											<div class="text-sm text-gray-500 font-mono">{ truncateCommit(d.CommitSHA.String) }</div>
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
											{ formatTime(d.CreatedAt) }
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
											if d.FinishedAt.Valid {
												{ formatDuration(d.FinishedAt.Time.Sub(d.StartedAt.Time)) }
											} else if isActiveDeployment(d.Status) {
												<span class="animate-pulse">Running...</span>
											} else {
												-
											}
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
											<a href={ templ.URL("/projects/" + project.ID + "/deployments/" + d.ID) } class="text-blue-600 hover:text-blue-900">View Logs</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	}
}

func formatDuration(d time.Duration) string {
	if d < time.Second {
		return "less than 1s"
	}
	d = d.Round(time.Second)
	m := d / time.Minute
	d -= m * time.Minute
	s := d / time.Second
	if m > 0 {
		return fmt.Sprintf("%dm %ds", m, s)
	}
	return fmt.Sprintf("%ds", s)
}

templ Services(project *models.Project, linkedServices []*models.ServiceInstance, availableServices []*models.ServiceInstance, csrfToken string) {
	<div class="space-y-6">
		// Linked services
		<div class="card overflow-hidden !p-0">
			<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center justify-between">
				<div>
					<h3 class="text-lg font-bold text-gray-900 tracking-tight">Linked Services</h3>
					<p class="mt-1 text-sm text-gray-500">Services attached to this project. Connection strings are auto-injected as environment variables on deploy.</p>
				</div>
			</div>
			<div class="divide-y divide-gray-100">
				if len(linkedServices) == 0 {
					<div class="text-center py-12 px-6">
						<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
						</svg>
						<h3 class="mt-2 text-sm font-medium text-gray-900">No linked services</h3>
						<p class="mt-1 text-sm text-gray-500">Attach a running service below to inject its connection string into deployments.</p>
					</div>
				} else {
					for _, svc := range linkedServices {
						<div class="px-6 py-4 flex items-center justify-between">
							<div class="flex items-center space-x-4 min-w-0">
								<div class="flex-shrink-0">
									<span class="inline-flex items-center justify-center h-10 w-10 rounded-lg bg-primary-100 text-primary-700">
										<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
										</svg>
									</span>
								</div>
								<div class="min-w-0">
									<p class="text-sm font-semibold text-gray-900 truncate">{ svc.Name }</p>
									<div class="flex items-center space-x-2 mt-1">
										<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
											{ svc.TemplateName }
										</span>
										<span class={ "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border", serviceStatusColor(svc.Status) }>
											{ string(svc.Status) }
										</span>
									</div>
									if connInfo, err := svc.GetConnectionInfo(); err == nil && len(connInfo) > 0 {
										<div class="mt-2 space-y-1">
											for key, val := range connInfo {
												<div class="flex items-center space-x-2">
													<span class="text-xs font-medium text-gray-500 uppercase">{ key }:</span>
													<code class="text-xs bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-700 font-mono truncate max-w-xs">{ val }</code>
												</div>
											}
										</div>
									}
								</div>
							</div>
							<button
								hx-delete={ "/projects/" + project.ID + "/services/" + svc.ID }
								hx-confirm="Detach this service? The connection string will no longer be injected on next deploy."
								hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` }
								class="flex-shrink-0 ml-4 inline-flex items-center px-3 py-1.5 border border-red-200 text-xs font-medium rounded-md text-red-700 bg-red-50 hover:bg-red-100 transition-colors"
							>
								<svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-5 0-9.27-3.11-11-7.5a11.72 11.72 0 013.168-4.477M6.343 6.343l11.314 11.314"></path>
								</svg>
								Detach
							</button>
						</div>
					}
				}
			</div>
		</div>

		// Attach new service
		if len(availableServices) > 0 {
			<div class="card overflow-hidden !p-0">
				<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30">
					<h3 class="text-lg font-bold text-gray-900 tracking-tight">Attach Service</h3>
					<p class="mt-1 text-sm text-gray-500">Link a running service instance to this project.</p>
				</div>
				<div class="p-6">
					<form hx-post={ "/projects/" + project.ID + "/services" } hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` } class="flex items-end space-x-4">
						<div class="flex-1">
							<label for="service_instance_id" class="block text-sm font-medium text-gray-700 mb-1">Service</label>
							<select name="service_instance_id" id="service_instance_id" class="input-text text-sm" required>
								<option value="">Select a service...</option>
								for _, svc := range availableServices {
									<option value={ svc.ID }>{ svc.Name } ({ svc.TemplateName })</option>
								}
							</select>
						</div>
						<button type="submit" class="btn-primary">
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.172 13.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.102 1.101"></path>
							</svg>
							Attach
						</button>
					</form>
				</div>
			</div>
		} else if len(linkedServices) == 0 {
			<div class="card text-center py-8">
				<p class="text-sm text-gray-500">No running service instances available to attach.</p>
				<a href="/services" class="mt-2 inline-block text-sm text-primary-600 hover:text-primary-800 font-medium">
					Deploy a service &rarr;
				</a>
			</div>
		}
	</div>
}

func serviceStatusColor(status models.ServiceInstanceStatus) string {
	switch status {
	case models.ServiceStatusRunning:
		return "bg-green-100 text-green-800 border-green-200"
	case models.ServiceStatusFailed:
		return "bg-red-100 text-red-800 border-red-200"
	case models.ServiceStatusPending, models.ServiceStatusStarting:
		return "bg-yellow-100 text-yellow-800 border-yellow-200"
	default:
		return "bg-gray-100 text-gray-800 border-gray-200"
	}
}

templ ProjectSettings(project *models.Project, currentEnv *models.Environment) {
	if currentEnv != nil {
		<div class="card mb-8">
			<h3 class="text-lg font-bold text-gray-900 tracking-tight mb-6">Configuration</h3>
			
			<form hx-put={ "/projects/" + project.ID + "/settings" } hx-swap="none">
				<input type="hidden" name="env_id" value={ currentEnv.ID } />
				
				<div class="space-y-8 divide-y divide-gray-100">
					<!-- Project Defaults Section -->
					<div class="grid grid-cols-1 gap-y-6 sm:grid-cols-6">
						<div class="sm:col-span-6">
							<h4 class="text-xs font-semibold text-primary-600 uppercase tracking-wider mb-2">Global Defaults</h4>
							<p class="text-sm text-gray-500">Settings applied to all environments unless overridden.</p>
						</div>

						<div class="sm:col-span-4">
							<label for="custom_domain" class="block text-sm font-medium text-gray-700">Default Domain</label>
							<div class="mt-1">
								<input type="text" name="custom_domain" id="custom_domain" 
									value={ project.CustomDomain.String }
									class="input-text text-sm" 
									placeholder="example.com" />
							</div>
						</div>
					</div>

					<!-- Environment Overrides Section -->
					<div class="pt-8 grid grid-cols-1 gap-y-6 sm:grid-cols-6">
						<div class="sm:col-span-6">
							<div class="flex items-center space-x-2 mb-2">
								<h4 class="text-xs font-semibold text-primary-600 uppercase tracking-wider">Environment Overrides</h4>
								<span class="px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200">
									{ currentEnv.Name }
								</span>
							</div>
							<p class="text-sm text-gray-500">Specific settings for this environment.</p>
						</div>

						<div class="sm:col-span-3">
							<label for="domain" class="block text-sm font-medium text-gray-700">Domain</label>
							<div class="mt-1">
								<input type="text" name="domain" id="domain" 
									value={ currentEnv.Domain.String }
									class="input-text text-sm" 
									placeholder="env.example.com" />
							</div>
							<p class="mt-1 text-xs text-gray-500">
								Overrides global default.
							</p>
						</div>

						<div class="sm:col-span-3">
							<label for="port" class="block text-sm font-medium text-gray-700">Application Port</label>
							<div class="mt-1">
								<input type="number" name="port" id="port" 
									value={ getPort(currentEnv) }
									class="input-text text-sm" 
									placeholder="80" />
							</div>
							<p class="mt-1 text-xs text-gray-500">
								Internal port (e.g., 3000). Default: 80.
							</p>
						</div>

						<div class="sm:col-span-6">
							<label for="branch" class="block text-sm font-medium text-gray-700">Git Branch</label>
							<div class="mt-1">
								<input type="text" name="branch" id="branch" 
									value={ currentEnv.Branch.String }
									class="input-text text-sm" 
									placeholder={ project.DefaultBranch } />
							</div>
							<p class="mt-1 text-xs text-gray-500">
								Deploys from { project.DefaultBranch } when empty.
							</p>
						</div>

						<div class="sm:col-span-6 flex items-center justify-between pt-4">
							<div class="text-xs text-yellow-600 bg-yellow-50 px-2 py-1 rounded border border-yellow-200">
								Changes to port require redeployment.
							</div>
							<button type="submit" class="btn-primary">Save Changes</button>
						</div>
					</div>
				</div>
			</form>
		</div>
	}

	<div class="card border-red-100 bg-red-50/30">
		<div class="sm:flex sm:items-start sm:justify-between">
			<div>
				<h3 class="text-lg font-bold text-red-900 tracking-tight">Delete Project</h3>
				<div class="mt-2 text-sm text-red-700">
					<p>Once you delete a project, all associated resources and deployments will be permanently removed. This action cannot be undone.</p>
				</div>
			</div>
			<div class="mt-5 sm:mt-0 sm:ml-6 flex-shrink-0">
				<button type="button" hx-delete={ "/projects/" + project.ID } hx-confirm="Are you sure you want to delete this project?" class="btn-danger">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
					Delete Project
				</button>
			</div>
		</div>
	</div>
}


