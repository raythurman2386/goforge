package projects

import (
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

templ Detail(project *models.Project, envs []*models.Environment, currentEnv *models.Environment, activeTab string, csrfToken string) {
	@layouts.AppLayout(project.Name, csrfToken) {
		<div class="md:flex md:items-center md:justify-between mb-8">
			<div class="flex-1 min-w-0">
				<div class="flex items-center space-x-4">
					<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
						{ project.Name }
					</h2>
					if currentEnv != nil {
						@components.EnvironmentSwitcher(project.ID, envs, currentEnv.ID)
					} else {
						@components.EnvironmentSwitcher(project.ID, envs, "")
					}
				</div>
			</div>
			<div class="mt-4 flex md:mt-0 md:ml-4">
				if currentEnv != nil {
					<button hx-post={ "/projects/" + project.ID + "/deployments?env_id=" + currentEnv.ID } class="btn-primary">
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
						Deploy Now
					</button>
				}
			</div>
		</div>

		<div class="mb-8 border-b border-gray-200/60">
			<nav class="-mb-px flex space-x-8" aria-label="Tabs">
				<a href={ templ.URL("/projects/" + project.ID + "?env=" + currentEnv.ID) } 
					class={ "whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm transition-all duration-200 ", 
						templ.KV("border-primary-600 text-primary-700", activeTab == "overview"),
						templ.KV("border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300", activeTab != "overview") }>
					Overview
				</a>
				<a href={ templ.URL("/projects/" + project.ID + "/deployments?env=" + currentEnv.ID) }
					class={ "whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm transition-all duration-200 ",
						templ.KV("border-primary-600 text-primary-700", activeTab == "deployments"),
						templ.KV("border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300", activeTab != "deployments") }>
					Deployments
				</a>
				<a href={ templ.URL("/projects/" + project.ID + "/settings?env=" + currentEnv.ID) }
					class={ "whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm transition-all duration-200 ",
						templ.KV("border-primary-600 text-primary-700", activeTab == "settings"),
						templ.KV("border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300", activeTab != "settings") }>
					Settings
				</a>
			</nav>
		</div>

		if activeTab == "overview" {
			@Overview(project)
		} else if activeTab == "deployments" {
			@Deployments(project)
		} else if activeTab == "settings" {
			@Settings(project, currentEnv)
		}
	}
}

templ Overview(project *models.Project) {
	<div class="card overflow-hidden !p-0">
		<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30">
			<h3 class="text-lg font-bold text-gray-900 tracking-tight">Project Overview</h3>
			<p class="mt-1 text-sm text-gray-500">Details and configuration for the current environment.</p>
		</div>
		<div class="divide-y divide-gray-100">
			<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
				<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider">Repository</dt>
				<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono bg-gray-50 p-2 rounded-md border border-gray-100">{ project.RepositoryURL }</dd>
			</div>
			<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
				<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider">Default Branch</dt>
				<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-medium">{ project.DefaultBranch }</dd>
			</div>
			<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
				<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider">Dockerfile</dt>
				<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono">{ project.DockerfilePath }</dd>
			</div>
			<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
				<dt class="text-sm font-bold text-gray-500 uppercase tracking-wider">Build Context</dt>
				<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono">{ project.BuildContext }</dd>
			</div>
		</div>
	</div>
}

templ Deployments(project *models.Project) {
	<div class="text-center py-12">
		<p class="text-gray-500 italic">Deployment history will appear here.</p>
	</div>
}

templ Settings(project *models.Project, currentEnv *models.Environment) {
	if currentEnv != nil {
		<div class="mb-8" hx-get={ "/envs/" + currentEnv.ID + "/variables" } hx-trigger="load">
			<div class="animate-pulse bg-gray-100 h-64 rounded-lg"></div>
		</div>
	}
	<div class="card border-red-100 bg-red-50/30">
		<div class="sm:flex sm:items-start sm:justify-between">
			<div>
				<h3 class="text-lg font-bold text-red-900 tracking-tight">Delete Project</h3>
				<div class="mt-2 text-sm text-red-700">
					<p>Once you delete a project, all associated resources and deployments will be permanently removed. This action cannot be undone.</p>
				</div>
			</div>
			<div class="mt-5 sm:mt-0 sm:ml-6 flex-shrink-0">
				<button type="button" hx-delete={ "/projects/" + project.ID } hx-confirm="Are you sure you want to delete this project?" class="btn-danger">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
					Delete Project
				</button>
			</div>
		</div>
	</div>
}
