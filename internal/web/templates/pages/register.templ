package pages

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

templ Register(csrfToken, errorMessage string) {
	@layouts.AuthLayout("Register", csrfToken) {
		@authHeader("Create your account", "Start deploying in minutes")
		@ui.Card(ui.CardProps{}) {
			<form class="space-y-5" action="/auth/register" method="POST">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				@ui.Input(ui.InputProps{ID: "register-email", Name: "email", Type: "email", Label: "Email address", Autocomplete: "email", Placeholder: "you@example.com", Required: true})
				@ui.Input(ui.InputProps{ID: "register-password", Name: "password", Type: "password", Label: "Password", Autocomplete: "new-password", Required: true})
				@ui.Input(ui.InputProps{ID: "register-confirm-password", Name: "confirm_password", Type: "password", Label: "Confirm password", Autocomplete: "new-password", Required: true})
				if errorMessage != "" {
					@ui.AlertMessage(ui.AlertError, errorMessage)
				}
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit", Class: "w-full"}) {
					Register
				}
			</form>
		}

		<p class="text-center text-sm text-gray-600 dark:text-gray-400">
			Already have an account?
			<a href="/login" class="font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400">Sign in</a>
		</p>
	}
}
