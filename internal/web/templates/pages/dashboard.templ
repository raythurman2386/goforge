package pages

import (
	"fmt"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

// formatBytes converts bytes to human-readable format
func formatBytes(bytes int64) string {
	const (
		KB = 1024
		MB = 1024 * KB
		GB = 1024 * MB
	)

	switch {
	case bytes >= GB:
		return fmt.Sprintf("%.2f GB", float64(bytes)/float64(GB))
	case bytes >= MB:
		return fmt.Sprintf("%.2f MB", float64(bytes)/float64(MB))
	case bytes >= KB:
		return fmt.Sprintf("%.2f KB", float64(bytes)/float64(KB))
	default:
		return fmt.Sprintf("%d B", bytes)
	}
}

templ DashboardStatsLoader() {
	<div id="dashboard-stats" hx-get="/dashboard/stats" hx-trigger="load">
		<div class="mt-8">
			<div class="animate-pulse">
				<div class="h-6 bg-gray-200 rounded w-48 mb-4"></div>
				<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
					<div class="card h-24 bg-gray-100"></div>
					<div class="card h-24 bg-gray-100"></div>
					<div class="card h-24 bg-gray-100"></div>
					<div class="card h-24 bg-gray-100"></div>
				</div>
			</div>
		</div>
	</div>
}

templ DashboardStats(csrfToken string, stats *models.SystemStats) {
	<div id="dashboard-stats">
		if stats != nil {
			<!-- Resource Usage Section -->
			<div class="mt-8">
				<h2 class="text-lg font-semibold text-gray-900">Resource Usage</h2>
				<div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
					<div class="card">
						<dt class="text-sm font-medium text-gray-500 truncate">Total Projects</dt>
						<dd class="mt-1 text-3xl font-semibold text-gray-900">{ fmt.Sprintf("%d", stats.TotalProjects) }</dd>
					</div>
					<div class="card">
						<dt class="text-sm font-medium text-gray-500 truncate">Active Services</dt>
						<dd class="mt-1 text-3xl font-semibold text-gray-900">{ fmt.Sprintf("%d", stats.TotalServices) }</dd>
					</div>
					<div class="card">
						<dt class="text-sm font-medium text-gray-500 truncate">Running Containers</dt>
						<dd class="mt-1 text-3xl font-semibold text-gray-900">{ fmt.Sprintf("%d / %d", stats.RunningContainers, stats.TotalContainers) }</dd>
					</div>
					<div class="card">
						<dt class="text-sm font-medium text-gray-500 truncate">CPU Usage</dt>
						<dd class="mt-1 text-3xl font-semibold text-gray-900">{ fmt.Sprintf("%.1f%%", stats.TotalCPUUsage) }</dd>
					</div>
				</div>
			</div>

			<!-- Memory Usage Section -->
			<div class="mt-6">
				<h2 class="text-lg font-semibold text-gray-900">Memory Usage</h2>
				<div class="mt-4 card">
					<div class="flex items-center justify-between mb-2">
						<span class="text-sm font-medium text-gray-700">
							{ formatBytes(stats.TotalMemoryUsage) } / { formatBytes(stats.TotalMemoryLimit) }
						</span>
						<span class="text-sm font-medium text-gray-500">{ fmt.Sprintf("%.1f%%", stats.MemoryUsagePercent) }</span>
					</div>
					<div class="w-full bg-gray-200 rounded-full h-2.5">
						<div 
							class="bg-primary-600 h-2.5 rounded-full transition-all duration-300" 
							style={ fmt.Sprintf("width: %.0f%%", min(stats.MemoryUsagePercent, 100)) }
						></div>
					</div>
				</div>
			</div>

			<!-- Disk Usage Section -->
			if stats.DiskUsage != nil {
				<div class="mt-6">
					<div class="flex items-center justify-between">
						<h2 class="text-lg font-semibold text-gray-900">Docker Disk Usage</h2>
						<form method="POST" action="/dashboard/prune" class="inline">
							<input type="hidden" name="csrf_token" value={ csrfToken } />
							if stats.DiskUsage.ReclaimableSize > 0 {
								<button
									type="submit"
									class="btn-secondary text-sm"
									onclick="return confirm('This will remove all stopped containers and unused images. Continue?')"
								>
									Prune System
								</button>
							} else {
								<button
									type="button"
									class="btn-secondary text-sm opacity-50 cursor-not-allowed"
									disabled
									title="Nothing to prune"
								>
									Prune System
								</button>
							}
						</form>
					</div>
					<div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
						<div class="card bg-blue-50 border-blue-200">
							<dt class="text-sm font-medium text-blue-700 truncate">Images</dt>
							<dd class="mt-1 text-2xl font-semibold text-blue-900">{ formatBytes(stats.DiskUsage.ImagesSize) }</dd>
						</div>
						<div class="card bg-green-50 border-green-200">
							<dt class="text-sm font-medium text-green-700 truncate">Containers</dt>
							<dd class="mt-1 text-2xl font-semibold text-green-900">{ formatBytes(stats.DiskUsage.ContainersSize) }</dd>
						</div>
						<div class="card bg-purple-50 border-purple-200">
							<dt class="text-sm font-medium text-purple-700 truncate">Volumes</dt>
							<dd class="mt-1 text-2xl font-semibold text-purple-900">{ formatBytes(stats.DiskUsage.VolumesSize) }</dd>
						</div>
						<div class="card bg-orange-50 border-orange-200">
							<dt class="text-sm font-medium text-orange-700 truncate">Build Cache</dt>
							<dd class="mt-1 text-2xl font-semibold text-orange-900">{ formatBytes(stats.DiskUsage.BuildCacheSize) }</dd>
						</div>
					</div>
					if stats.DiskUsage.ReclaimableSize > 0 {
						<div class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
							<p class="text-sm text-yellow-800">
								<strong>Reclaimable Space:</strong> { formatBytes(stats.DiskUsage.ReclaimableSize) } can be freed by pruning.
							</p>
						</div>
					}
				</div>
			}
		}
	</div>
}

templ Dashboard(csrfToken string) {
	@layouts.AppLayout("Dashboard", csrfToken) {
		<div class="max-w-7xl">
			<h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">Dashboard</h1>
			<p class="mt-2 text-sm text-gray-500">Overview of your Platform as a Service.</p>

			<!-- Welcome & Quick Actions -->
			<div class="mt-8">
				<div class="card bg-gradient-to-br from-white to-gray-50/50">
					<div class="sm:flex sm:items-start sm:justify-between">
						<div>
							<h3 class="text-xl font-bold text-gray-900 tracking-tight">Welcome to GoForge</h3>
							<div class="mt-2 max-w-xl text-sm text-gray-500 leading-relaxed">
								<p>Start by creating a project or deploying a service from the catalog.</p>
							</div>
						</div>
						<div class="mt-5 sm:mt-0 sm:ml-6 sm:flex-shrink-0 flex space-x-3">
							<a href="/projects/new" class="btn-primary">
								Create Project
							</a>
							<a href="/services" class="btn-secondary">
								Deploy Service
							</a>
						</div>
					</div>
				</div>
			</div>
			
			@DashboardStatsLoader()
		</div>
	}
}
