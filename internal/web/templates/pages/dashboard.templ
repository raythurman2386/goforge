package pages

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

// formatBytes converts bytes to human-readable format
func formatBytes(bytes int64) string {
	const (
		KB = 1024
		MB = 1024 * KB
		GB = 1024 * MB
	)

	switch {
	case bytes >= GB:
		return fmt.Sprintf("%.2f GB", float64(bytes)/float64(GB))
	case bytes >= MB:
		return fmt.Sprintf("%.2f MB", float64(bytes)/float64(MB))
	case bytes >= KB:
		return fmt.Sprintf("%.2f KB", float64(bytes)/float64(KB))
	default:
		return fmt.Sprintf("%d B", bytes)
	}
}

// statCardSkeleton mirrors a loaded stat card: a .card with a text-sm label
// line (h-5) and a value line matching the dd's line height (h-9 for
// text-3xl, h-8 for text-2xl), so the swap does not change card height.
templ statCardSkeleton(valueHeight string) {
	@ui.Card(ui.CardProps{}) {
		@ui.Skeleton(ui.SkeletonLine, "h-5 w-28")
		@ui.Skeleton(ui.SkeletonLine, "mt-1 w-20 "+valueHeight)
	}
}

// DashboardStatsLoader is swapped for DashboardStats once /dashboard/stats
// answers. It mirrors that layout section by section (Resource Usage, Memory
// Usage, Docker Disk Usage) with matching line heights so the page does not
// jump when the real stats land.
templ DashboardStatsLoader() {
	<div id="dashboard-stats" hx-get="/dashboard/stats" hx-trigger="load">
		<div role="status" aria-label="Loading stats" aria-busy="true">
			<div class="mt-8">
				@ui.Skeleton(ui.SkeletonLine, "h-7 w-40")
				<div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
					for range 4 {
						@statCardSkeleton("h-9")
					}
				</div>
			</div>
			<div class="mt-6">
				@ui.Skeleton(ui.SkeletonLine, "h-7 w-36")
				@ui.Card(ui.CardProps{Class: "mt-4"}) {
					<div class="flex items-center justify-between mb-2">
						@ui.Skeleton(ui.SkeletonLine, "h-5 w-40")
						@ui.Skeleton(ui.SkeletonLine, "h-5 w-12")
					</div>
					@ui.Skeleton(ui.SkeletonLine, "h-2.5 w-full rounded-full")
				}
			</div>
			<div class="mt-6">
				<div class="flex min-h-10 items-center justify-between">
					@ui.Skeleton(ui.SkeletonLine, "h-7 w-48")
				</div>
				<div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
					for range 4 {
						@statCardSkeleton("h-8")
					}
				</div>
			</div>
		</div>
	</div>
}

templ DashboardStats(csrfToken string, stats *models.SystemStats, admin bool) {
	<div id="dashboard-stats" class="animate-fade-in">
		if stats != nil {
			<!-- Resource Usage Section -->
			<div class="mt-8">
				<h2 class="text-lg font-semibold text-foreground">Resource Usage</h2>
				<dl class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
					@ui.Card(ui.CardProps{}) {
						<dt class="text-sm font-medium text-muted-foreground truncate">Total Projects</dt>
						<dd class="mt-1 text-3xl font-semibold text-foreground">{ fmt.Sprintf("%d", stats.TotalProjects) }</dd>
					}
					@ui.Card(ui.CardProps{}) {
						<dt class="text-sm font-medium text-muted-foreground truncate">Active Services</dt>
						<dd class="mt-1 text-3xl font-semibold text-foreground">{ fmt.Sprintf("%d", stats.TotalServices) }</dd>
					}
					@ui.Card(ui.CardProps{}) {
						<dt class="text-sm font-medium text-muted-foreground truncate">Running Containers</dt>
						<dd class="mt-1 text-3xl font-semibold text-foreground">{ fmt.Sprintf("%d / %d", stats.RunningContainers, stats.TotalContainers) }</dd>
					}
					@ui.Card(ui.CardProps{}) {
						<dt class="text-sm font-medium text-muted-foreground truncate">CPU Usage</dt>
						<dd class="mt-1 text-3xl font-semibold text-foreground">{ fmt.Sprintf("%.1f%%", stats.TotalCPUUsage) }</dd>
					}
				</dl>
			</div>

			<!-- Memory Usage Section -->
			<div class="mt-6">
				<h2 class="text-lg font-semibold text-foreground">Memory Usage</h2>
				@ui.Card(ui.CardProps{Class: "mt-4"}) {
					<div class="flex items-center justify-between mb-2">
						<span class="text-sm font-medium text-foreground-secondary">
							{ formatBytes(stats.TotalMemoryUsage) } / { formatBytes(stats.TotalMemoryLimit) }
						</span>
						<span class="text-sm font-medium text-muted-foreground">{ fmt.Sprintf("%.1f%%", stats.MemoryUsagePercent) }</span>
					</div>
					<div class="w-full bg-highlight rounded-full h-2.5">
						<div 
							class="bg-primary-600 h-2.5 rounded-full transition-all duration-300" 
							style={ fmt.Sprintf("width: %.0f%%", min(stats.MemoryUsagePercent, 100)) }
						></div>
					</div>
				}
			</div>

			<!-- Disk Usage Section -->
			if stats.DiskUsage != nil {
				<div class="mt-6">
					<div class="flex min-h-10 items-center justify-between">
						<h2 class="text-lg font-semibold text-foreground">Docker Disk Usage</h2>
						if admin {
						<form method="POST" action="/dashboard/prune" class="inline">
							<input type="hidden" name="csrf_token" value={ csrfToken } />
							if stats.DiskUsage.ReclaimableSize > 0 {
								@ui.Button(ui.ButtonProps{
									Variant: ui.ButtonSecondary,
									Type: "submit",
									Class: "text-sm",
									Attrs: templ.Attributes{
										"hx-confirm": "This will remove all stopped containers and unused images. Continue?",
										"data-ui-confirm-tone": "danger",
										"data-ui-confirm-label": "Prune",
									},
								}) {
									Prune System
								}
							} else {
								@ui.Button(ui.ButtonProps{
									Variant: ui.ButtonSecondary,
									Disabled: true,
									Class: "text-sm opacity-50 cursor-not-allowed",
									Attrs: templ.Attributes{
										"title": "Nothing to prune",
									},
								}) {
									Prune System
								}
							}
						</form>
						}
					</div>
					<dl class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
						@ui.Card(ui.CardProps{}) {
							<dt class="text-sm font-medium text-muted-foreground truncate">Images</dt>
							<dd class="mt-1 text-2xl font-semibold text-foreground">{ formatBytes(stats.DiskUsage.ImagesSize) }</dd>
						}
						@ui.Card(ui.CardProps{}) {
							<dt class="text-sm font-medium text-muted-foreground truncate">Containers</dt>
							<dd class="mt-1 text-2xl font-semibold text-foreground">{ formatBytes(stats.DiskUsage.ContainersSize) }</dd>
						}
						@ui.Card(ui.CardProps{}) {
							<dt class="text-sm font-medium text-muted-foreground truncate">Volumes</dt>
							<dd class="mt-1 text-2xl font-semibold text-foreground">{ formatBytes(stats.DiskUsage.VolumesSize) }</dd>
						}
						@ui.Card(ui.CardProps{}) {
							<dt class="text-sm font-medium text-muted-foreground truncate">Build Cache</dt>
							<dd class="mt-1 text-2xl font-semibold text-foreground">{ formatBytes(stats.DiskUsage.BuildCacheSize) }</dd>
						}
					</dl>
					if stats.DiskUsage.ReclaimableSize > 0 {
						<div class="mt-4">
							@ui.Alert(ui.AlertProps{Tone: ui.AlertWarning}) {
								<p><strong>Reclaimable Space:</strong> { formatBytes(stats.DiskUsage.ReclaimableSize) } can be freed by pruning.</p>
							}
						</div>
					}
				</div>
			}
		}
	</div>
}

templ Dashboard(csrfToken string, hasProjects bool, hasGitSources bool) {
	@layouts.AppLayout("Dashboard", csrfToken) {
		<div class="max-w-7xl">
			<h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">Dashboard</h1>
			<p class="mt-2 text-sm text-muted-foreground">Overview of your Platform as a Service.</p>

			if !hasProjects && !hasGitSources {
				<!-- First-Time Onboarding Flow -->
				<div class="mt-8">
					@ui.Card(ui.CardProps{
						Class: "bg-card border-2 border-primary-200 dark:border-primary-800",
					}) {
						<div class="px-4 py-5 sm:p-6 text-center">
							<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900/50">
								<svg class="h-6 w-6 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.438 4.438 0 002.946-2.368c.162-.366.28-.75.352-1.144" />
								</svg>
							</div>
							<h3 class="mt-4 text-xl font-bold text-foreground tracking-tight">Welcome to GoForge!</h3>
							<div class="mt-2 max-w-xl mx-auto text-sm text-muted-foreground leading-relaxed">
								<p>Let's get your first application deployed. Follow these simple steps to get started.</p>
							</div>
							
							<div class="mt-8 text-left max-w-2xl mx-auto">
								<ol class="overflow-hidden space-y-8">
									<li class="relative pb-10">
										<div class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-highlight" aria-hidden="true"></div>
										<div class="relative flex space-x-3">
											<div>
												<span class="h-8 w-8 rounded-full bg-primary-600 flex items-center justify-center ring-8 ring-card">
													<span class="text-white font-medium text-sm">1</span>
												</span>
											</div>
											<div class="flex min-w-0 flex-1 justify-between space-x-4 pt-1.5">
												<div>
													<p class="text-sm text-muted-foreground">
														<span class="font-medium text-foreground">Connect Git Source</span>
														<br/>Link your GitHub, GitLab, or Gitea account to access your repositories.
													</p>
													<div class="mt-3">
														@ui.Button(ui.ButtonProps{
															Variant: ui.ButtonPrimary,
															Href: "/settings/git",
															Class: "inline-flex",
														}) {
															Add Git Source
														}
													</div>
												</div>
											</div>
										</div>
									</li>

									<li class="relative pb-10">
										<div class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-highlight" aria-hidden="true"></div>
										<div class="relative flex space-x-3">
											<div>
												<span class="h-8 w-8 rounded-full bg-muted flex items-center justify-center ring-8 ring-card">
													<span class="text-muted-foreground font-medium text-sm">2</span>
												</span>
											</div>
											<div class="flex min-w-0 flex-1 justify-between space-x-4 pt-1.5">
												<div>
													<p class="text-sm text-muted-foreground">
														<span class="font-medium text-foreground">Create Project</span>
														<br/>Select a repository and configure your build settings.
													</p>
												</div>
											</div>
										</div>
									</li>

									<li class="relative">
										<div class="relative flex space-x-3">
											<div>
												<span class="h-8 w-8 rounded-full bg-muted flex items-center justify-center ring-8 ring-card">
													<span class="text-muted-foreground font-medium text-sm">3</span>
												</span>
											</div>
											<div class="flex min-w-0 flex-1 justify-between space-x-4 pt-1.5">
												<div>
													<p class="text-sm text-muted-foreground">
														<span class="font-medium text-foreground">Deploy!</span>
														<br/>Watch your application build and deploy with zero downtime.
													</p>
												</div>
											</div>
										</div>
									</li>
								</ol>
							</div>
						</div>
					}
				</div>
			} else if !hasProjects {
				<!-- State: Has Git Source but no projects yet -->
				<div class="mt-8">
					@ui.Card(ui.CardProps{
						Class: "bg-card border-2 border-primary-200 dark:border-primary-800",
					}) {
						<div class="px-4 py-5 sm:p-6 text-center">
							<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900/50">
								<svg class="h-6 w-6 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
								</svg>
							</div>
							<h3 class="mt-4 text-xl font-bold text-foreground tracking-tight">You're ready to deploy!</h3>
							<div class="mt-2 max-w-xl mx-auto text-sm text-muted-foreground leading-relaxed">
								<p>You've connected a Git source. Next, create a project to deploy your first application.</p>
							</div>
							<div class="mt-5 sm:mt-6 flex justify-center space-x-3">
								@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Href: "/projects/new"}) {
									Create Project
								}
								@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Href: "/services"}) {
									Deploy Service Instead
								}
							</div>
						</div>
					}
				</div>
			} else {
				<!-- Standard Welcome & Quick Actions -->
				<div class="mt-8">
					@ui.Card(ui.CardProps{
						Class: "bg-gradient-to-br from-card to-muted/50",
					}) {
						<div class="sm:flex sm:items-start sm:justify-between">
							<div>
								<h3 class="text-xl font-bold text-foreground tracking-tight">Welcome to GoForge</h3>
								<div class="mt-2 max-w-xl text-sm text-muted-foreground leading-relaxed">
									<p>Start by creating a project or deploying a service from the catalog.</p>
								</div>
							</div>
							<div class="mt-5 sm:mt-0 sm:ml-6 sm:flex-shrink-0 flex space-x-3">
								@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Href: "/projects/new"}) {
									Create Project
								}
								@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Href: "/services"}) {
									Deploy Service
								}
							</div>
						</div>
					}
				</div>
			}
			
			@DashboardStatsLoader()
			@RecentAgentActionsLoader()
		</div>
	}
}

// RecentAgentActionsLoader is swapped for the recent agent actions card
// (components.ActivityCard) once /dashboard/activity answers. It reserves the
// same Flush card shell (header, then body) so the swap does not jump.
templ RecentAgentActionsLoader() {
	<div id="recent-agent-actions-loader" hx-get="/dashboard/activity" hx-trigger="load" hx-swap="outerHTML">
		<div role="status" aria-label="Loading recent agent actions" aria-busy="true">
			@ui.Card(ui.CardProps{Flush: true, Class: "mt-8 overflow-hidden"}) {
				@ui.CardHeader(nil) {
					<div class="space-y-2">
						@ui.Skeleton(ui.SkeletonLine, "h-5 w-44")
						@ui.Skeleton(ui.SkeletonLine, "h-4 w-72")
					</div>
					@ui.Skeleton(ui.SkeletonLine, "h-8 w-20")
				}
				@ui.CardContent(nil) {
					@ui.Skeleton(ui.SkeletonBlock, "h-24 w-full")
				}
			}
		</div>
	</div>
}
