package deployments

import (
	"fmt"
	"time"

	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

// DetailProps contains properties for the deployment detail page.
type DetailProps struct {
	Deployment  *models.Deployment
	Project     *models.Project
	Environment *models.Environment
	Logs        []*models.DeploymentLog
	CanRollback bool
	CSRFToken   string
}

templ Detail(props DetailProps) {
	@layouts.AppLayout(fmt.Sprintf("Deployment %s", truncateID(props.Deployment.ID)), props.CSRFToken, nil) {
		<!-- Breadcrumb -->
		<nav class="flex mb-4" aria-label="Breadcrumb">
			<ol class="flex items-center space-x-2">
				<li>
					<a href="/projects" class="text-gray-400 hover:text-gray-500">
						<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
							<path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
						</svg>
					</a>
				</li>
				<li>
					<div class="flex items-center">
						<svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
						</svg>
						<a href={ templ.URL("/projects/" + props.Project.ID) } class="ml-2 text-sm font-medium text-gray-500 hover:text-gray-700">
							{ props.Project.Name }
						</a>
					</div>
				</li>
				<li>
					<div class="flex items-center">
						<svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
						</svg>
						<a href={ templ.URL("/projects/" + props.Project.ID + "/deployments") } class="ml-2 text-sm font-medium text-gray-500 hover:text-gray-700">
							Deployments
						</a>
					</div>
				</li>
				<li>
					<div class="flex items-center">
						<svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
						</svg>
						<span class="ml-2 text-sm font-medium text-gray-700">
							{ truncateID(props.Deployment.ID) }
						</span>
					</div>
				</li>
			</ol>
		</nav>

		<!-- Header -->
		<div class="flex items-center justify-between mb-6">
			<div class="flex items-center space-x-4">
				<h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl">
					Deployment { truncateID(props.Deployment.ID) }
				</h2>
				@components.DeploymentStatusBadge(props.Deployment.Status)
			</div>
			<div class="flex space-x-3">
				if props.CanRollback && props.Deployment.Status == models.DeploymentStatusRunning {
					<button
						hx-post={ fmt.Sprintf("/projects/%s/deployments/%s/rollback", props.Project.ID, props.Deployment.ID) }
						hx-confirm="Are you sure you want to rollback this deployment?"
						class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-orange-600 hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500">
						<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
						</svg>
						Rollback
					</button>
				}
				if !props.Deployment.IsTerminal() {
					<button
						hx-post={ fmt.Sprintf("/projects/%s/deployments/%s/cancel", props.Project.ID, props.Deployment.ID) }
						hx-confirm="Are you sure you want to cancel this deployment?"
						class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
						<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
						Cancel
					</button>
				}
			</div>
		</div>

		<!-- Deployment Info Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
			<!-- Main Info Card -->
			<div class="lg:col-span-2 bg-white shadow overflow-hidden sm:rounded-lg">
				<div class="px-4 py-5 sm:px-6">
					<h3 class="text-lg leading-6 font-medium text-gray-900">Deployment Information</h3>
				</div>
				<div class="border-t border-gray-200">
					<dl>
						<div class="bg-gray-50 px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
							<dt class="text-sm font-medium text-gray-500">Status</dt>
							<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
								@components.DeploymentStatusBadge(props.Deployment.Status)
							</dd>
						</div>
						<div class="bg-white px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
							<dt class="text-sm font-medium text-gray-500">Trigger</dt>
							<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
								@components.TriggerTypeBadge(props.Deployment.TriggerType)
							</dd>
						</div>
						if props.Deployment.Branch.Valid {
							<div class="bg-gray-50 px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
								<dt class="text-sm font-medium text-gray-500">Branch</dt>
								<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-blue-100 text-blue-800">
										<svg class="-ml-0.5 mr-1.5 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
										</svg>
										{ props.Deployment.Branch.String }
									</span>
								</dd>
							</div>
						}
						if props.Deployment.CommitSHA.Valid {
							<div class="bg-white px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
								<dt class="text-sm font-medium text-gray-500">Commit</dt>
								<dd class="mt-1 text-sm sm:mt-0 sm:col-span-2">
									<code class="px-2 py-1 bg-gray-100 rounded text-gray-800 font-mono text-sm">
										{ props.Deployment.CommitSHA.String }
									</code>
								</dd>
							</div>
						}
						if props.Deployment.CommitMessage.Valid {
							<div class="bg-gray-50 px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
								<dt class="text-sm font-medium text-gray-500">Commit Message</dt>
								<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
									{ props.Deployment.CommitMessage.String }
								</dd>
							</div>
						}
						if props.Deployment.CommitAuthor.Valid {
							<div class="bg-white px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
								<dt class="text-sm font-medium text-gray-500">Author</dt>
								<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
									{ props.Deployment.CommitAuthor.String }
								</dd>
							</div>
						}
						if props.Deployment.ImageTag.Valid {
							<div class="bg-gray-50 px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
								<dt class="text-sm font-medium text-gray-500">Image Tag</dt>
								<dd class="mt-1 text-sm sm:mt-0 sm:col-span-2">
									<code class="px-2 py-1 bg-gray-100 rounded text-gray-800 font-mono text-sm">
										{ props.Deployment.ImageTag.String }
									</code>
								</dd>
							</div>
						}
						if props.Deployment.ErrorMessage.Valid {
							<div class="bg-red-50 px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
								<dt class="text-sm font-medium text-red-700">Error</dt>
								<dd class="mt-1 text-sm text-red-800 sm:mt-0 sm:col-span-2">
									{ props.Deployment.ErrorMessage.String }
								</dd>
							</div>
						}
					</dl>
				</div>
			</div>

			<!-- Timeline Card -->
			<div class="bg-white shadow overflow-hidden sm:rounded-lg">
				<div class="px-4 py-5 sm:px-6">
					<h3 class="text-lg leading-6 font-medium text-gray-900">Timeline</h3>
				</div>
				<div class="border-t border-gray-200 px-4 py-5 sm:px-6">
					<dl class="space-y-4">
						<div>
							<dt class="text-sm font-medium text-gray-500">Created</dt>
							<dd class="mt-1 text-sm text-gray-900">
								{ formatTimestamp(props.Deployment.CreatedAt) }
							</dd>
						</div>
						if props.Deployment.StartedAt.Valid {
							<div>
								<dt class="text-sm font-medium text-gray-500">Started</dt>
								<dd class="mt-1 text-sm text-gray-900">
									{ formatTimestamp(props.Deployment.StartedAt.Time) }
								</dd>
							</div>
						}
						if props.Deployment.FinishedAt.Valid {
							<div>
								<dt class="text-sm font-medium text-gray-500">Finished</dt>
								<dd class="mt-1 text-sm text-gray-900">
									{ formatTimestamp(props.Deployment.FinishedAt.Time) }
								</dd>
							</div>
						}
						<div>
							<dt class="text-sm font-medium text-gray-500">Duration</dt>
							<dd class="mt-1 text-sm text-gray-900">
								{ formatDuration(props.Deployment.Duration()) }
							</dd>
						</div>
					</dl>
				</div>
			</div>
		</div>

		<!-- Deployment Logs -->
		<div class="bg-white shadow sm:rounded-lg">
			<div class="px-4 py-5 sm:px-6 flex justify-between items-center">
				<h3 class="text-lg leading-6 font-medium text-gray-900">Deployment Logs</h3>
				if !props.Deployment.IsTerminal() {
					<span class="inline-flex items-center text-sm text-gray-500">
						<svg class="animate-pulse -ml-0.5 mr-2 h-2 w-2 text-green-400" fill="currentColor" viewBox="0 0 8 8">
							<circle cx="4" cy="4" r="3"></circle>
						</svg>
						Live
					</span>
				}
			</div>
			<div class="border-t border-gray-200">
				<div
					id="deployment-logs"
					class="bg-gray-900 text-gray-100 font-mono text-sm p-4 max-h-96 overflow-y-auto"
					if !props.Deployment.IsTerminal() {
						hx-ext="sse"
						sse-connect={ fmt.Sprintf("/projects/%s/deployments/%s/logs", props.Project.ID, props.Deployment.ID) }
						sse-swap="log"
						hx-swap="beforeend"
					}
				>
					if len(props.Logs) == 0 {
						<p class="text-gray-500 italic">No logs available yet...</p>
					} else {
						for _, log := range props.Logs {
							@LogLine(log)
						}
					}
				</div>
			</div>
		</div>
	}
}

templ LogLine(log *models.DeploymentLog) {
	<div class={ "py-0.5", logLevelClass(log.Level) }>
		<span class="text-gray-500">{ formatLogTime(log.Timestamp) }</span>
		<span class={ logLevelBadgeClass(log.Level) }>{ string(log.Level) }</span>
		if log.Source.Valid {
			<span class="text-blue-400">[{ log.Source.String }]</span>
		}
		<span>{ log.Message }</span>
	</div>
}

// Helper functions

func truncateID(id string) string {
	if len(id) > 8 {
		return id[:8]
	}
	return id
}

func formatTimestamp(t time.Time) string {
	return t.Format("Jan 2, 2006 3:04:05 PM")
}

func formatDuration(d time.Duration) string {
	if d == 0 {
		return "-"
	}
	if d < time.Minute {
		return fmt.Sprintf("%ds", int(d.Seconds()))
	}
	if d < time.Hour {
		return fmt.Sprintf("%dm %ds", int(d.Minutes()), int(d.Seconds())%60)
	}
	return fmt.Sprintf("%dh %dm", int(d.Hours()), int(d.Minutes())%60)
}

func formatLogTime(t time.Time) string {
	return t.Format("15:04:05.000")
}

func logLevelClass(level models.DeploymentLogLevel) string {
	switch level {
	case models.LogLevelError:
		return "text-red-400"
	case models.LogLevelWarn:
		return "text-yellow-400"
	case models.LogLevelDebug:
		return "text-gray-500"
	default:
		return ""
	}
}

func logLevelBadgeClass(level models.DeploymentLogLevel) string {
	switch level {
	case models.LogLevelError:
		return "px-1 rounded bg-red-900 text-red-200 text-xs"
	case models.LogLevelWarn:
		return "px-1 rounded bg-yellow-900 text-yellow-200 text-xs"
	case models.LogLevelDebug:
		return "px-1 rounded bg-gray-700 text-gray-300 text-xs"
	default:
		return "px-1 rounded bg-blue-900 text-blue-200 text-xs"
	}
}
