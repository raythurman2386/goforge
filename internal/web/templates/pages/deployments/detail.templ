package deployments

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"time"

	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

// DetailProps contains properties for the deployment detail page.
type DetailProps struct {
	Deployment  *models.Deployment
	Project     *models.Project
	Environment *models.Environment
	Logs        []*models.DeploymentLog
	CanRollback bool
	CSRFToken   string
}

templ Detail(props DetailProps) {
	@layouts.AppLayout(fmt.Sprintf("Deployment %s", truncateID(props.Deployment.ID)), props.CSRFToken) {
		<div hx-ext="sse" sse-connect={ fmt.Sprintf("/projects/%s/deployments/%s/logs", props.Project.ID, props.Deployment.ID) }>
		@ui.Breadcrumb([]ui.Crumb{
			{Label: "Projects", Href: "/projects"},
			{Label: props.Project.Name, Href: "/projects/" + props.Project.ID},
			{Label: "Deployments", Href: "/projects/" + props.Project.ID + "/deployments"},
			{Label: truncateID(props.Deployment.ID)},
		})

		@components.PageHeaderWithBadge("Deployment "+truncateID(props.Deployment.ID), "", liveStatus(props.Deployment.Status)) {
			if props.CanRollback && props.Deployment.Status == models.DeploymentStatusRunning {
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonWarning,
					Attrs: templ.Attributes{
						"hx-post": fmt.Sprintf("/projects/%s/deployments/%s/rollback", props.Project.ID, props.Deployment.ID),
						"hx-confirm": "Are you sure you want to rollback this deployment?",
						"hx-headers": fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, props.CSRFToken),
						"hx-disabled-elt": "this",
						"hx-indicator": "find .htmx-indicator",
					},
				}) {
					<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
					</svg>
					Rollback
					@components.Spinner()
				}
			}
			if !props.Deployment.IsTerminal() {
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonSecondary,
					Attrs: templ.Attributes{
						"hx-post": fmt.Sprintf("/projects/%s/deployments/%s/cancel", props.Project.ID, props.Deployment.ID),
						"hx-confirm": "Are you sure you want to cancel this deployment?",
						"hx-headers": fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, props.CSRFToken),
						"hx-disabled-elt": "this",
						"hx-indicator": "find .htmx-indicator",
					},
				}) {
					<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
					Cancel
					@components.Spinner()
				}
			}
		}

		<!-- Deployment Info Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
			<!-- Main Info Card -->
			@ui.Card(ui.CardProps{Flush: true, Class: "lg:col-span-2 overflow-hidden"}) {
				@ui.CardHeader(nil) {
					@ui.CardTitle(3, nil) {
						Deployment Information
					}
				}
				<dl class="divide-y divide-gray-100 dark:divide-gray-800">
					@infoRow("Status") {
						@liveStatus(props.Deployment.Status)
					}
					@infoRow("Trigger") {
						@components.TriggerTypeBadge(props.Deployment.TriggerType)
					}
					if props.Deployment.Branch.Valid {
						@infoRow("Branch") {
							@ui.Badge(ui.BadgeProps{Variant: ui.BadgeSubtle, Square: true, Class: "px-2 font-mono text-gray-700 dark:text-gray-300"}) {
								<svg class="h-3.5 w-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
								</svg>
								{ props.Deployment.Branch.String }
							}
						}
					}
					if props.Deployment.CommitSHA.Valid {
						@infoRow("Commit") {
							<code class="px-2 py-1 bg-gray-100 rounded text-gray-800 font-mono text-xs dark:bg-gray-800 dark:text-gray-200">{ props.Deployment.CommitSHA.String }</code>
						}
					}
					if props.Deployment.CommitMessage.Valid {
						@infoRow("Commit Message") {
							{ props.Deployment.CommitMessage.String }
						}
					}
					if props.Deployment.CommitAuthor.Valid {
						@infoRow("Author") {
							{ props.Deployment.CommitAuthor.String }
						}
					}
					if props.Deployment.ImageTag.Valid {
						@infoRow("Image Tag") {
							<code class="px-2 py-1 bg-gray-100 rounded text-gray-800 font-mono text-xs break-all dark:bg-gray-800 dark:text-gray-200">{ props.Deployment.ImageTag.String }</code>
						}
					}
				</dl>
				if props.Deployment.ErrorMessage.Valid {
					@ui.CardContent(templ.Attributes{"class": "border-t border-gray-100 dark:border-gray-800"}) {
						@ui.Alert(ui.AlertProps{Tone: ui.AlertError}) {
							<p class="font-semibold">Error</p>
							<p class="mt-1 break-words">{ props.Deployment.ErrorMessage.String }</p>
						}
					}
				}
			}

			<!-- Timeline Card -->
			@ui.Card(ui.CardProps{Flush: true}) {
				@ui.CardHeader(nil) {
					@ui.CardTitle(3, nil) {
						Timeline
					}
				}
				<dl class="card-body space-y-4">
					<div>
						<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Created</dt>
						<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{ formatTimestamp(props.Deployment.CreatedAt) }</dd>
					</div>
					if props.Deployment.StartedAt.Valid {
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Started</dt>
							<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{ formatTimestamp(props.Deployment.StartedAt.Time) }</dd>
						</div>
					}
					if props.Deployment.FinishedAt.Valid {
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Finished</dt>
							<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{ formatTimestamp(props.Deployment.FinishedAt.Time) }</dd>
						</div>
					}
					<div>
						<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Duration</dt>
						<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{ formatDuration(props.Deployment.Duration()) }</dd>
					</div>
				</dl>
			}
		</div>

		<!-- Deployment Logs -->
		@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
			@ui.CardHeader(nil) {
				@ui.CardTitle(3, nil) {
					Deployment Logs
				}
				if !props.Deployment.IsTerminal() {
					<span class="inline-flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
						<span class="h-2 w-2 rounded-full bg-green-400 animate-pulse" aria-hidden="true"></span>
						Live
					</span>
				}
			}
			<div id="deployment-logs" class="bg-gray-900 text-gray-100 font-mono text-sm p-4 max-h-96 overflow-y-auto dark:bg-gray-950">
				<div id="deployment-log-lines" sse-swap="snapshot" hx-swap="innerHTML">
					if len(props.Logs) == 0 {
						<p class="text-gray-500 italic dark:text-gray-400">No logs available yet...</p>
					} else {
						for _, log := range props.Logs {
							@LogLine(log)
						}
					}
				</div>
				<div sse-swap="log" hx-swap="beforeend" hx-target="#deployment-log-lines"></div>
			</div>
		}
		</div>
	}
}

// liveStatus is the status badge wrapped in the SSE "status" swap target.
templ liveStatus(status models.DeploymentStatus) {
	<span sse-swap="status" hx-swap="innerHTML">
		@components.DeploymentStatusBadge(status)
	</span>
}

templ infoRow(label string) {
	<div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
		<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 dark:text-gray-100">
			{ children... }
		</dd>
	</div>
}

templ LogLine(log *models.DeploymentLog) {
	<div class={ "py-0.5", logLevelClass(log.Level) }>
		<span class="text-gray-500 dark:text-gray-400">{ formatLogTime(log.Timestamp) }</span>
		<span class={ logLevelBadgeClass(log.Level) }>{ string(log.Level) }</span>
		if log.Source.Valid {
			<span class="text-primary-300">[{ log.Source.String }]</span>
		}
		<span>{ log.Message }</span>
	</div>
}

// Helper functions

func truncateID(id string) string {
	if len(id) > 8 {
		return id[:8]
	}
	return id
}

func formatTimestamp(t time.Time) string {
	return t.Format("Jan 2, 2006 3:04:05 PM")
}

func formatDuration(d time.Duration) string {
	if d == 0 {
		return "-"
	}
	if d < time.Minute {
		return fmt.Sprintf("%ds", int(d.Seconds()))
	}
	if d < time.Hour {
		return fmt.Sprintf("%dm %ds", int(d.Minutes()), int(d.Seconds())%60)
	}
	return fmt.Sprintf("%dh %dm", int(d.Hours()), int(d.Minutes())%60)
}

func formatLogTime(t time.Time) string {
	return t.Format("15:04:05.000")
}

func logLevelClass(level models.DeploymentLogLevel) string {
	switch level {
	case models.LogLevelError:
		return "text-red-400"
	case models.LogLevelWarn:
		return "text-yellow-400"
	case models.LogLevelDebug:
		return "text-gray-500 dark:text-gray-400"
	default:
		return ""
	}
}

func logLevelBadgeClass(level models.DeploymentLogLevel) string {
	switch level {
	case models.LogLevelError:
		return "px-1 rounded bg-red-900 text-red-200 text-xs"
	case models.LogLevelWarn:
		return "px-1 rounded bg-yellow-900 text-yellow-200 text-xs"
	case models.LogLevelDebug:
		return "px-1 rounded bg-gray-700 text-gray-300 text-xs"
	default:
		return "px-1 rounded bg-blue-900 text-blue-200 text-xs"
	}
}
