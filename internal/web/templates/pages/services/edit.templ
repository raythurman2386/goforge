package pages_services

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/services"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

// configValue returns the stored value for key, or fallback when unset.
func configValue(config map[string]interface{}, key string, fallback interface{}) string {
	if v, ok := config[key]; ok && v != nil {
		return fmt.Sprintf("%v", v)
	}
	if fallback == nil {
		return ""
	}
	return fmt.Sprintf("%v", fallback)
}

templ Edit(instance *models.ServiceInstance, tmpl *services.ServiceTemplate, config map[string]interface{}, csrfToken string) {
	@layouts.AppLayout("Edit "+instance.Name, csrfToken) {
		<div class="max-w-3xl mx-auto">
			<div class="md:flex md:items-center md:justify-between mb-8">
				<div class="flex-1 min-w-0">
					<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">
						Edit { instance.Name }
					</h2>
					<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Change the configuration of this { tmpl.DisplayName } service.</p>
				</div>
			</div>
			<div class="mb-6">
			@ui.Alert(ui.AlertProps{Tone: ui.AlertWarning}) {
				<p class="font-semibold">Saving recreates the container.</p>
				<p class="mt-1">The service restarts with the new settings. Its data volumes are kept and mounted again:</p>
				if len(tmpl.Docker.Volumes) > 0 {
					<ul class="mt-2 list-disc pl-5 font-mono text-xs">
						for _, v := range tmpl.Docker.Volumes {
							<li>{ services.VolumeName(instance.ID, v.Name) } → { v.Path }</li>
						}
					</ul>
				}
				<p class="mt-2">Some images read credentials only on first start. Changing a database password here does not change it inside existing data.</p>
			}
			</div>
			@ui.Card(ui.CardProps{}) {
				<form class="space-y-8" action={ templ.SafeURL("/services/" + instance.ID + "/edit") } method="POST">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					@ui.Input(ui.InputProps{ID: "svc-name", Name: "name", Label: "Service Name", Value: configValue(config, "name", instance.Name), Required: true, Class: "mb-4"})
					if tmpl.Web {
						@ui.Input(ui.InputProps{ID: "svc-domain", Name: "domain", Label: "Domain", Value: configValue(config, "domain", instance.Domain.String), Required: true, Class: "mb-4"})
					}
					for _, field := range tmpl.Config {
						if field.Immutable {
							<p class="mb-4 text-xs text-gray-500 dark:text-gray-400">{ field.Label } is set once at deploy and cannot be changed here.</p>
						} else if field.Type == "password" {
							@ui.Input(ui.InputProps{ID: "svc-" + field.Name, Name: field.Name, Type: "password", Label: field.Label, Autocomplete: "new-password", Help: "Leave blank to keep the current value.", Class: "mb-4"})
						} else if field.Type == services.FieldTypeBool {
							@ui.Checkbox(ui.CheckboxProps{ID: "svc-" + field.Name, Name: field.Name, Value: "true", Label: field.Label, Checked: services.IsTrue(configValue(config, field.Name, field.Default)), HiddenFalse: true, Class: "mb-4"})
						} else if field.Type == services.FieldTypeSelect {
							@ui.Select(ui.SelectProps{ID: "svc-" + field.Name, Name: field.Name, Label: field.Label, Options: ui.StringOptions(field.Options), Selected: configValue(config, field.Name, field.Default), Blank: !field.Required, Required: field.Required, Class: "mb-4"})
						} else if field.Type == "number" {
							@ui.Input(ui.InputProps{ID: "svc-" + field.Name, Name: field.Name, Type: "number", Label: field.Label, Value: configValue(config, field.Name, field.Default), Required: field.Required, Class: "mb-4"})
						} else {
							@ui.Input(ui.InputProps{ID: "svc-" + field.Name, Name: field.Name, Label: field.Label, Value: configValue(config, field.Name, field.Default), Required: field.Required, Class: "mb-4"})
						}
					}
					<div class="pt-8 border-t border-gray-100 flex justify-end space-x-3 dark:border-gray-800">
						@ui.Button(ui.ButtonProps{
							Variant: ui.ButtonSecondary,
							Href: templ.SafeURL("/services/" + instance.ID),
						}) {
							Cancel
						}
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
							Save and Recreate
							@components.Spinner()
						}
					</div>
				</form>
			}
		</div>
	}
}
