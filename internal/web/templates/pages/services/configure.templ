package pages_services

import (
	"fmt"
	"github.com/raythurman2386/goforge/internal/services"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

templ Configure(tmpl *services.ServiceTemplate, csrfToken string) {
	@layouts.AppLayout("Configure " + tmpl.DisplayName, csrfToken, nil) {
		<div class="max-w-3xl mx-auto">
			<div class="md:flex md:items-center md:justify-between mb-8">
				<div class="flex-1 min-w-0">
					<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
						Configure { tmpl.DisplayName }
					</h2>
					<p class="mt-2 text-sm text-gray-500">Customize your deployment settings and environment variables.</p>
				</div>
			</div>

			<div class="card">
				<form class="space-y-8" action={ templ.SafeURL("/services/" + tmpl.Name) } method="POST">
				<input type="hidden" name="csrf_token" value={ csrfToken } />
					
				@components.Input("Service Name", "name", "text", tmpl.Name, true)

				if tmpl.Web {
					@components.Input("Domain", "domain", "text", tmpl.Name+".localhost", true)
					<div class="mt-[-1rem] mb-4 text-xs text-gray-500">
						Required. Assign a custom domain (e.g., <code>gitea.localhost</code> or <code>gitea.example.com</code>) to access this service via the browser.
					</div>
				}

					for _, field := range tmpl.Config {
						if field.Type == "password" && field.Generate {
							// TODO: Client-side generation or hidden field
							@components.Input(field.Label, field.Name, "password", "", field.Required)
						} else if field.Type == "number" {
							@components.Input(field.Label, field.Name, "number", fmt.Sprintf("%v", field.Default), field.Required)
						} else {
							@components.Input(field.Label, field.Name, "text", fmt.Sprintf("%v", field.Default), field.Required)
						}
					}

					<div class="pt-8 border-t border-gray-100 flex justify-end space-x-3">
						<a href="/services" class="btn-secondary">
							Cancel
						</a>
						@components.Button("Deploy Service", "primary")
					</div>
				</form>
			</div>
		</div>
	}
}
