package pages_services

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"github.com/raythurman2386/goforge/internal/services"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

// cloudflareDomainsDocURL explains first-level hosts and the tunnel CNAME.
const cloudflareDomainsDocURL = "https://github.com/raythurman2386/goforge/blob/main/docs/configuration/cloudflare.md#service-domains"

// domainPlaceholder hints at a public first-level host in Cloudflare proxy mode.
func domainPlaceholder(templateName string, cloudflareProxyMode bool) string {
	if cloudflareProxyMode {
		return templateName + "-app.example.com"
	}
	return templateName + ".localhost"
}

// defaultValue renders a field default, or "" when there is none.
func defaultValue(v interface{}) string {
	if v == nil {
		return ""
	}
	return fmt.Sprintf("%v", v)
}

templ Configure(tmpl *services.ServiceTemplate, csrfToken string, cloudflareProxyMode bool) {
	@layouts.AppLayout("Configure " + tmpl.DisplayName, csrfToken) {
		<div class="max-w-3xl mx-auto">
			<div class="md:flex md:items-center md:justify-between mb-8">
				<div class="flex-1 min-w-0">
					<h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
						Configure { tmpl.DisplayName }
					</h2>
					<p class="mt-2 text-sm text-foreground-secondary">Customize your deployment settings and environment variables.</p>
				</div>
			</div>

			@ui.Card(ui.CardProps{}) {
				<form class="space-y-8" action={ templ.SafeURL("/services/" + tmpl.Name) } method="POST">
				<input type="hidden" name="csrf_token" value={ csrfToken } />
					
				@ui.Input(ui.InputProps{ID: "svc-name", Name: "name", Label: "Service Name", Value: tmpl.Name, Required: true, Class: "mb-4"})

				if tmpl.Web {
					@ui.Input(ui.InputProps{
						ID:          "svc-domain",
						Name:        "domain",
						Label:       "Domain",
						Value:       services.DefaultServiceDomain(tmpl.Name, cloudflareProxyMode),
						Placeholder: domainPlaceholder(tmpl.Name, cloudflareProxyMode),
						Required:    true,
						DescribedBy: "svc-domain-help",
						Class:       "mb-2",
					})
					if cloudflareProxyMode {
						<div id="svc-domain-help" class="mb-4 text-xs text-foreground-secondary space-y-1">
							<p>Required. Cloudflare Tunnel mode: use a public first-level host such as <code>{ tmpl.Name }-app.example.com</code>. Cloudflare Universal SSL covers <code>*.example.com</code> but not <code>*.apps.example.com</code>, so a deeper name fails the TLS handshake.</p>
							<p>Before you deploy, create a proxied CNAME for the host that points at <code>&lt;tunnel-id&gt;.cfargotunnel.com</code>, unless a proxied wildcard already does. <code>.localhost</code> hosts cannot be reached through the tunnel.</p>
							<p><a href={ templ.SafeURL(cloudflareDomainsDocURL) } target="_blank" rel="noopener noreferrer" class="text-primary-700 hover:underline dark:text-primary-400">Cloudflare service domains guide</a></p>
						</div>
					} else {
						<p id="svc-domain-help" class="mb-4 text-xs text-foreground-secondary">
							Required. Assign a custom domain (e.g., <code>gitea.localhost</code> or <code>gitea.example.com</code>) to access this service via the browser.
						</p>
					}
				}

					for _, field := range tmpl.Config {
						if field.Type == "password" && field.Generate {
							@ui.Input(ui.InputProps{ID: "svc-" + field.Name, Name: field.Name, Type: "password", Label: field.Label, Autocomplete: "new-password", Help: "Leave blank and GoForge generates a password. It is stored encrypted.", Class: "mb-4"})
						} else if field.Type == services.FieldTypeBool {
							@ui.Checkbox(ui.CheckboxProps{ID: "svc-" + field.Name, Name: field.Name, Value: "true", Label: field.Label, Checked: field.BoolDefault(), HiddenFalse: true, Class: "mb-4"})
						} else if field.Type == services.FieldTypeSelect {
							@ui.Select(ui.SelectProps{ID: "svc-" + field.Name, Name: field.Name, Label: field.Label, Options: ui.StringOptions(field.Options), Selected: defaultValue(field.Default), Blank: !field.Required, Required: field.Required, Class: "mb-4"})
						} else if field.Type == "number" {
							@ui.Input(ui.InputProps{ID: "svc-" + field.Name, Name: field.Name, Type: "number", Label: field.Label, Value: fmt.Sprintf("%v", field.Default), Required: field.Required, Class: "mb-4"})
						} else {
							@ui.Input(ui.InputProps{ID: "svc-" + field.Name, Name: field.Name, Label: field.Label, Value: fmt.Sprintf("%v", field.Default), Required: field.Required, Class: "mb-4"})
						}
					}

					<div class="pt-8 border-t border-divider flex justify-end space-x-3">
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Href: "/services"}) {
							Cancel
						}
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
							Deploy Service
							@components.Spinner()
						}
					</div>
				</form>
			}
		</div>
	}
}
