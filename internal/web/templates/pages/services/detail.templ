package pages_services

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"net/url"

	"github.com/raythurman2386/goforge/internal/docker"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/services"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

// isPending returns true if the instance is in a transitional state.
func isPending(instance *models.ServiceInstance) bool {
	return instance.Status == models.ServiceStatusPending || instance.Status == models.ServiceStatusStarting
}

// Detail renders a service instance. summary is the Docker inspect summary
// of container, or nil when there is no container or inspect failed.
templ Detail(instance *models.ServiceInstance, container *models.Container, summary *docker.InspectSummary, tmpl *services.ServiceTemplate, csrfToken string) {
	@layouts.AppLayout(instance.Name, csrfToken) {
		// Outside the polled region: the poll selects #service-detail-content
		// only, so the trail is rendered once.
		@ui.Breadcrumb([]ui.Crumb{
			{Label: "Services", Href: "/services"},
			{Label: instance.Name},
		})
		<div id="service-detail-content">
			// When pending/starting, poll the full detail page to pick up container
			// and status changes. The poll lives inside the swapped region, so the
			// first non-pending render drops it and polling stops.
			if isPending(instance) {
				<div
					id="service-detail-poll"
					hx-get={ "/services/" + instance.ID }
					hx-trigger="every 3s"
					hx-select="#service-detail-content"
					hx-target="#service-detail-content"
					hx-swap="outerHTML"
				></div>
			}
			<div class="md:flex md:items-center md:justify-between mb-8">
				<div class="flex-1 min-w-0">
					<h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">
						{ instance.Name }
					</h2>
					<div class="mt-2 flex items-center space-x-2">
						@ui.Badge(ui.BadgeProps{Tone: ui.BadgePrimary, Square: true, Class: "px-2 text-[10px] font-bold uppercase tracking-widest leading-none"}) {
							{ tmpl.DisplayName }
						}
						@components.StatusBadge("service", string(instance.Status))
						if isPending(instance) {
							<span class="inline-flex items-center text-xs text-amber-700 dark:text-amber-400">
								<svg class="animate-spin -ml-0.5 mr-1.5 h-3 w-3" fill="none" viewBox="0 0 24 24">
									<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
									<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
								</svg>
								Deploying...
							</span>
						}
					</div>
					if instance.LastError.Valid && instance.LastError.String != "" {
						<p id="service-last-error" class="mt-2 text-sm text-red-700 dark:text-red-400 break-words">
							<span class="font-semibold">Last error:</span> { instance.LastError.String }
						</p>
					}
				</div>
				<div class="mt-4 flex md:mt-0 md:ml-4 space-x-3">
					if !isPending(instance) {
						@ui.Button(ui.ButtonProps{
							Variant: ui.ButtonSecondary,
							Href: templ.SafeURL("/services/" + instance.ID + "/edit"),
						}) {
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
							</svg>
							Edit configuration
						}
						@ui.Button(ui.ButtonProps{
							Variant: ui.ButtonSecondary,
							Attrs: templ.Attributes{
								"hx-post": "/services/" + instance.ID + "/update",
								"hx-confirm": "Pull the latest image for this service and recreate its container? Data volumes and configuration are kept. The service is briefly unavailable while it restarts.",
								"data-ui-confirm-label": "Pull and recreate",
								"hx-swap": "none",
								"hx-disabled-elt": "this",
								"hx-indicator": "find .htmx-indicator",
								"title": "Pull the image again and recreate the container",
							},
						}) {
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
							</svg>
							Update image
							@components.Spinner()
						}
					}
					@ui.Button(ui.ButtonProps{
						Variant: ui.ButtonSecondary,
						Attrs: templ.Attributes{
							"hx-post": "/services/" + instance.ID + "/restart",
							"hx-swap": "none",
							"hx-disabled-elt": "this",
							"hx-indicator": "find .htmx-indicator",
						},
					}) {
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
						Restart
						@components.Spinner()
					}
					@ui.Button(ui.ButtonProps{
						Variant: ui.ButtonDanger,
						Attrs: templ.Attributes{
							"hx-delete": "/services/" + instance.ID,
							"hx-confirm": "Are you sure you want to delete this service? Data will be lost.",
							"data-ui-confirm-tone": "danger",
							"data-ui-confirm-label": "Delete service",
						},
					}) {
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
						Delete
					}
				</div>
			</div>

			if container != nil {
				// hx-preserve on the stream keeps it open across pending polls
				// while the Docker ID is unchanged.
				@components.ResourceUsageCard(container.DockerID, "mb-8")
				@components.ContainerCard(container.DockerID, summary, "mb-8")
			}

		@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
			<div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 dark:border-gray-800 dark:bg-gray-800/50">
				<h3 class="text-lg font-bold text-gray-900 tracking-tight dark:text-gray-100">Connection Details</h3>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Use these details to connect to and manage your service.</p>
			</div>
			<div class="divide-y divide-gray-100 dark:divide-gray-800">
				for _, row := range detailRows(instance, container, tmpl) {
					@detailRow(instance.ID, row)
				}
			</div>
		}
		</div>
		@secretControlsScript()
	}
}

// detailRows lists config rows, then connection rows, with secrets masked,
// then the host ports the container publishes.
func detailRows(instance *models.ServiceInstance, container *models.Container, tmpl *services.ServiceTemplate) []services.DetailRow {
	config, connection := services.DetailRows(tmpl, instance)
	rows := append(config, connection...)
	return append(rows, services.PublishedPortRows(container)...)
}

func secretURL(instanceID string, row services.DetailRow) string {
	q := url.Values{"source": {row.Source}, "key": {row.Key}}
	return "/services/" + instanceID + "/secret?" + q.Encode()
}

templ detailRow(instanceID string, row services.DetailRow) {
	<div class="px-6 py-5 sm:grid sm:grid-cols-3 sm:gap-4 hover:bg-gray-50/50 transition-colors dark:hover:bg-gray-800/50">
		<dt class="text-sm font-bold text-gray-500 uppercase tracking-widest dark:text-gray-400">{ row.Key }</dt>
		if row.Secret {
			<dd
				class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono bg-white p-2 border border-gray-100 rounded-md shadow-sm flex items-center justify-between gap-3 dark:text-gray-100 dark:bg-gray-900 dark:border-gray-800"
				data-secret
				data-secret-url={ secretURL(instanceID, row) }
				data-secret-mask={ row.Display }
			>
				<span class="break-all" data-secret-value>{ row.Display }</span>
				<span class="flex shrink-0 gap-2 font-sans">
					@ui.Button(ui.ButtonProps{Variant: ui.ButtonLink, Size: ui.ButtonInline, Label: "Show " + row.Key, Class: "text-xs font-semibold", Attrs: templ.Attributes{"data-secret-action": "toggle"}}) {
						Show
					}
					@ui.Button(ui.ButtonProps{Variant: ui.ButtonLink, Size: ui.ButtonInline, Label: "Copy " + row.Key, Class: "text-xs font-semibold", Attrs: templ.Attributes{"data-secret-action": "copy"}}) {
						Copy
					}
				</span>
			</dd>
		} else {
			<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono bg-white p-2 border border-gray-100 rounded-md shadow-sm select-all dark:text-gray-100 dark:bg-gray-900 dark:border-gray-800">
				{ row.Display }
			</dd>
		}
	</div>
}

// secretControlsScript wires Show and Copy on masked rows. The value is
// fetched on demand and never rendered into the page. The listener is
// delegated so the pending-state poll swap keeps working.
templ secretControlsScript() {
	<script>
		(function () {
			if (window.goforgeSecretControls) { return; }
			window.goforgeSecretControls = true;
			function fetchSecret(row) {
				return fetch(row.getAttribute('data-secret-url'), { credentials: 'same-origin', cache: 'no-store' })
					.then(function (r) { if (!r.ok) { throw new Error('HTTP ' + r.status); } return r.text(); });
			}
			function flash(btn, text, restore) {
				btn.textContent = text;
				setTimeout(function () { btn.textContent = restore; }, 2000);
			}
			document.addEventListener('click', function (e) {
				var btn = e.target.closest('[data-secret-action]');
				if (!btn) { return; }
				var row = btn.closest('[data-secret]');
				var out = row.querySelector('[data-secret-value]');
				if (btn.getAttribute('data-secret-action') === 'toggle') {
					if (out.getAttribute('data-revealed') === 'true') {
						out.textContent = row.getAttribute('data-secret-mask');
						out.removeAttribute('data-revealed');
						btn.textContent = 'Show';
						return;
					}
					fetchSecret(row).then(function (v) {
						out.textContent = v;
						out.setAttribute('data-revealed', 'true');
						btn.textContent = 'Hide';
					}).catch(function () { flash(btn, 'Error', 'Show'); });
					return;
				}
				fetchSecret(row).then(function (v) {
					if (!navigator.clipboard) { throw new Error('clipboard unavailable'); }
					return navigator.clipboard.writeText(v);
				}).then(function () { flash(btn, 'Copied!', 'Copy'); })
					.catch(function () { flash(btn, 'Copy failed', 'Copy'); });
			});
		})();
	</script>
}

