package pages_services

import (
	"github.com/user/gocool/internal/models"
	"github.com/user/gocool/internal/services"
	"github.com/user/gocool/internal/web/templates/layouts"
)

templ Detail(instance *models.ServiceInstance, tmpl *services.ServiceTemplate) {
	@layouts.AppLayout(instance.Name) {
		<div class="md:flex md:items-center md:justify-between mb-6">
			<div class="flex-1 min-w-0">
				<h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
					{ instance.Name }
				</h2>
				<p class="mt-1 text-sm text-gray-500">
					{ tmpl.DisplayName } • { string(instance.Status) }
				</p>
			</div>
			<div class="mt-4 flex md:mt-0 md:ml-4 space-x-3">
				<button hx-post={ "/services/" + instance.ID + "/restart" } class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none">
					Restart
				</button>
				<button hx-delete={ "/services/" + instance.ID } hx-confirm="Are you sure you want to delete this service? Data will be lost." class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none">
					Delete
				</button>
			</div>
		</div>

		<div class="bg-white shadow overflow-hidden sm:rounded-lg mb-6">
			<div class="px-4 py-5 sm:px-6">
				<h3 class="text-lg leading-6 font-medium text-gray-900">Connection Details</h3>
				<p class="mt-1 max-w-2xl text-sm text-gray-500">Use these details to connect to your service.</p>
			</div>
			<div class="border-t border-gray-200">
				<dl>
					// TODO: Decrypt and parse connection info
					<div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
						<dt class="text-sm font-medium text-gray-500">Internal Connection</dt>
						<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 font-mono select-all">
							postgres://user:pass@host:5432/db
						</dd>
					</div>
				</dl>
			</div>
		</div>
	}
}
