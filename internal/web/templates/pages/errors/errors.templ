package errors

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"strconv"
)

// ErrorPage renders a full error page. Signed-in users get the app shell
// (sidebar, Log out) and a link back to the dashboard; signed-out visitors get
// a standalone card that links to sign in, since /dashboard would only bounce
// them to /login.
templ ErrorPage(code int, title, message, csrfToken string, signedIn bool) {
	if signedIn {
		@layouts.AppLayout(title, csrfToken) {
			<div class="flex justify-center py-12">
				@errorCard(code, title, message, signedIn)
			</div>
		}
	} else {
		@layouts.Base(title, csrfToken) {
			<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8 dark:bg-gray-950">
				@errorCard(code, title, message, signedIn)
			</div>
		}
	}
}

templ errorCard(code int, title, message string, signedIn bool) {
	@ui.Card(ui.CardProps{Class: "max-w-md w-full !p-8 text-center"}) {
		<div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-red-50 ring-8 ring-red-50/50 dark:bg-red-950/40 dark:ring-red-950/20">
			<svg class="h-8 w-8 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
			</svg>
		</div>
		<p class="text-sm font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">Error { strconv.Itoa(code) }</p>
		if title != strconv.Itoa(code) {
			<h1 class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100">{ title }</h1>
			<p class="mt-3 text-gray-600 dark:text-gray-400">{ message }</p>
		} else {
			<h1 class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100">{ message }</h1>
		}
		<div class="mt-8">
			if signedIn {
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Href: "/dashboard"}) {
					<svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
					</svg>
					Back to dashboard
				}
			} else {
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Href: "/login"}) {
					Sign in
				}
			}
		</div>
	}
}

templ NotFound(csrfToken string, signedIn bool) {
	@ErrorPage(404, "404", "Page not found", csrfToken, signedIn)
}

templ InternalError(csrfToken string, signedIn bool) {
	@ErrorPage(500, "500", "Something went wrong", csrfToken, signedIn)
}

templ Forbidden(csrfToken string, signedIn bool) {
	@ErrorPage(403, "403", "Access denied", csrfToken, signedIn)
}
