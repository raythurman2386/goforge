package errors

import (
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"strconv"
)

templ ErrorPage(code int, title, message, csrfToken string) {
	@layouts.Base(title, csrfToken) {
		<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-md w-full bg-white p-8 shadow-lg rounded-xl text-center">
				<div class="flex justify-center mb-6">
					<div class="rounded-full bg-red-100 p-4">
						<svg class="h-12 w-12 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
						</svg>
					</div>
				</div>
				<h1 class="text-7xl font-extrabold text-gray-900 mb-2">{ strconv.Itoa(code) }</h1>
				<h2 class="text-2xl font-bold text-gray-800 mb-4">{ title }</h2>
				<p class="text-gray-600 mb-8">{ message }</p>
				<div class="mt-8">
					<a href="/dashboard" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors duration-200">
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Go back home
					</a>
				</div>
			</div>
		</div>
	}
}

templ NotFound(csrfToken string) {
	@ErrorPage(404, "404", "Page not found", csrfToken)
}

templ InternalError(csrfToken string) {
	@ErrorPage(500, "500", "Something went wrong", csrfToken)
}

templ Forbidden(csrfToken string) {
	@ErrorPage(403, "403", "Access denied", csrfToken)
}
