package errors

import (
	"github.com/raythurman2386/gocool/internal/web/templates/layouts"
)

templ ErrorPage(code int, title, message, csrfToken string) {
	@layouts.Base(title, csrfToken) {
		<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-md w-full text-center">
				<h1 class="text-9xl font-extrabold text-indigo-600">{ title }</h1>
				<p class="text-2xl font-bold text-gray-900 mt-4">{ message }</p>
				<div class="mt-6">
					<a href="/dashboard" class="text-indigo-600 hover:text-indigo-500 font-medium">
						Go back home &rarr;
					</a>
				</div>
			</div>
		</div>
	}
}

templ NotFound(csrfToken string) {
	@ErrorPage(404, "404", "Page not found", csrfToken)
}

templ InternalError(csrfToken string) {
	@ErrorPage(500, "500", "Something went wrong", csrfToken)
}

templ Forbidden(csrfToken string) {
	@ErrorPage(403, "403", "Access denied", csrfToken)
}
