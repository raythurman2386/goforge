package settings

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

// SettingsSection replaces the former filled cards with a flat settings group.
templ SettingsSection(title string, attrs templ.Attributes) {
	<section class="border-t border-divider py-6 first:border-t-0 first:pt-0" { attrs... }>
		<h2 class="text-base font-semibold text-foreground">{ title }</h2>
		<div class="mt-2">
			{ children... }
		</div>
	</section>
}

// SettingsRow keeps the setting's label and help together, with its control
// alongside on wide screens and below it on touch screens.
templ SettingsRow(label, description, controlID string) {
	<div class="flex flex-col gap-3 border-t border-divider py-4 first:border-t-0 sm:flex-row sm:items-start sm:justify-between sm:gap-6 md:flex-row md:items-start md:justify-between">
		<div class="min-w-0 flex-1">
			if controlID != "" {
				@ui.Label(ui.LabelProps{For: controlID, Class: "mb-0"}) {
					{ label }
				}
			} else {
				<p class="text-sm font-semibold text-label">{ label }</p>
			}
			if description != "" {
				<p class="mt-1 text-sm text-foreground-secondary">{ description }</p>
			}
		</div>
		<div class="min-w-0 w-full shrink-0 md:w-72">
			{ children... }
		</div>
	</div>
}

// SettingsActions aligns a form's actions with the setting rows.
templ SettingsActions() {
	<div class="flex flex-wrap justify-end gap-2 border-t border-divider pt-4">
		{ children... }
	</div>
}

// StatusPill is the single status-pill treatment used by settings rows.
templ StatusPill(tone ui.BadgeTone) {
	@ui.Badge(ui.BadgeProps{Tone: tone, Variant: ui.BadgeSoft, Size: ui.BadgeSM}) {
		{ children... }
	}
}

// SettingsFormGrid groups related fields without reintroducing a card.
templ SettingsFormGrid() {
	<div class="grid gap-x-4 sm:grid-cols-2">
		{ children... }
	</div>
}

// SettingsPage identifies the active full settings page.
type SettingsPage string

const (
	SettingsPageProfile  SettingsPage = "profile"
	SettingsPageSecurity SettingsPage = "security"
	SettingsPageActivity SettingsPage = "activity"
	SettingsPageSettings SettingsPage = "settings"
)

type settingsNavItem struct {
	page SettingsPage
	name string
	href string
}

var settingsNavItems = []settingsNavItem{
	{SettingsPageProfile, "Profile", "/settings/profile"},
	{SettingsPageSecurity, "Security", "/settings/security"},
	{SettingsPageActivity, "Activity", "/settings/activity"},
	{SettingsPageSettings, "Settings", "/settings/git"},
}

// SettingsLayout is the one shell shared by all settings pages. Its in-page
// navigation is for mobile; the global sidebar owns settings navigation at md+.
// Only the active page gets aria-current and the current-link style.
templ SettingsLayout(active SettingsPage, title, description, csrfToken string) {
	@layouts.AppLayout(title, csrfToken) {
		<div class="mx-auto max-w-5xl">
			<nav class="mb-6 flex gap-1 overflow-x-auto border-b border-divider md:hidden" aria-label="Settings pages" tabindex="0">
				for _, item := range settingsNavItems {
					<a href={ templ.SafeURL(item.href) } aria-current={ settingsCurrent(active, item.page) } class={ "shrink-0 rounded-md px-3 py-2 text-sm font-medium max-md:min-h-11 max-md:flex max-md:items-center " + settingsNavClass(active, item.page) }>{ item.name }</a>
				}
			</nav>
			<div class="min-w-0 max-w-3xl">
				<div class="mb-6"><h1 class="text-2xl font-semibold tracking-tight text-foreground">{ title }</h1><p class="mt-1 text-sm text-foreground-secondary">{ description }</p></div>
				{ children... }
			</div>
		</div>
	}
}

func settingsCurrent(active, item SettingsPage) string {
	if active == item {
		return "page"
	}
	return ""
}

func settingsNavClass(active, item SettingsPage) string {
	if active == item {
		return "text-foreground"
	}
	return settingsSecondaryTextClass
}
