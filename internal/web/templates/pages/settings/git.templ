package settings

import (
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

templ GitSources(sources []*models.GitSource, csrfToken string) {
	@layouts.AppLayout("Git Sources", csrfToken) {
		@components.PageHeader("Git Sources", "Manage your git provider integrations and access tokens.") {
				<button hx-get="/settings/git/new" hx-target="body" hx-swap="beforeend" class="btn-primary">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					Add Source
				</button>
		}

		if len(sources) == 0 {
			@components.EmptyState(components.EmptyStateProps{
				Title:       "No git sources",
				Description: "Connect your GitHub, GitLab or other git providers.",
				ButtonText:  "Add Source",
				HxGet:       "/settings/git/new",
				Icon:        "code",
			})
		} else {
			<div class="card overflow-hidden !p-0">
				<ul role="list" class="divide-y divide-gray-100 dark:divide-gray-800">
					for _, s := range sources {
						<li class="hover:bg-gray-50 transition-colors dark:hover:bg-gray-800/50">
							<div class="px-6 py-5 flex items-center justify-between">
								<div class="flex items-center">
									<div class="flex-shrink-0 w-12 h-12 bg-gray-50 rounded-xl flex items-center justify-center border border-gray-100 shadow-sm dark:bg-gray-800/50 dark:border-gray-800">
										if s.Type == models.GitSourceTypeGitHub {
											<svg class="h-7 min-w-7 text-gray-900 dark:text-gray-100" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
										} else {
											<svg class="h-7 min-w-7 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
										}
									</div>
									<div class="ml-4">
										<p class="text-base font-bold text-gray-900 truncate tracking-tight dark:text-gray-100">{ s.Name }</p>
										<p class="text-xs text-gray-500 uppercase tracking-widest mt-0.5 dark:text-gray-400">{ string(s.Type) }</p>
									</div>
								</div>
								<div class="flex space-x-2">
									<button hx-delete={ "/settings/git/" + s.ID } hx-confirm="Remove this source?" class="p-2 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 transition-all duration-200 dark:hover:text-red-400 dark:hover:bg-red-950/40">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
										</svg>
									</button>
								</div>
							</div>
						</li>
					}
				</ul>
			</div>
		}
	}
}

templ AddGitSourceModal(csrfToken string) {
	@components.Modal("Add Git Source") {
		<form hx-post="/settings/git" hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			
			@components.Input("Source Name", "name", "text", "", true)
			
			<div class="mb-6">
				<label class="label">Source Type</label>
				<div class="grid grid-cols-3 gap-4">
					<label class="relative flex flex-col p-4 border border-gray-100 rounded-xl cursor-pointer hover:bg-gray-50 transition-all focus-within:ring-2 focus-within:ring-primary-500/20 shadow-sm dark:border-gray-800 dark:hover:bg-gray-800/50">
						<div class="flex items-center justify-between mb-2">
							<span class="text-sm font-bold text-gray-900 tracking-tight dark:text-gray-100">GitHub</span>
							<input type="radio" name="type" value="github" checked class="h-4 w-4 text-primary-600 focus:ring-primary-500/20 border-gray-300 dark:text-primary-400 dark:border-gray-700" />
						</div>
					</label>
					<label class="relative flex flex-col p-4 border border-gray-100 rounded-xl cursor-pointer hover:bg-gray-50 transition-all focus-within:ring-2 focus-within:ring-primary-500/20 shadow-sm dark:border-gray-800 dark:hover:bg-gray-800/50">
						<div class="flex items-center justify-between mb-2">
							<span class="text-sm font-bold text-gray-900 tracking-tight dark:text-gray-100">GitLab</span>
							<input type="radio" name="type" value="gitlab" class="h-4 w-4 text-primary-600 focus:ring-primary-500/20 border-gray-300 dark:text-primary-400 dark:border-gray-700" />
						</div>
					</label>
					<label class="relative flex flex-col p-4 border border-gray-100 rounded-xl cursor-pointer hover:bg-gray-50 transition-all focus-within:ring-2 focus-within:ring-primary-500/20 shadow-sm dark:border-gray-800 dark:hover:bg-gray-800/50">
						<div class="flex items-center justify-between mb-2">
							<span class="text-sm font-bold text-gray-900 tracking-tight dark:text-gray-100">Gitea</span>
							<input type="radio" name="type" value="gitea" class="h-4 w-4 text-primary-600 focus:ring-primary-500/20 border-gray-300 dark:text-primary-400 dark:border-gray-700" />
						</div>
					</label>
				</div>
			</div>

			@components.Input("API URL (optional)", "api_url", "text", "", false)
			@components.Input("Access Token", "access_token", "password", "", true)

			<div class="mt-8 flex justify-end space-x-3">
				<button type="button" data-modal-close class="btn-secondary">
					Cancel
				</button>
				@components.Button("Add Source", "primary")
			</div>
		</form>
	}
}
