package settings

import (
	"github.com/raythurman2386/goforge/internal/notify"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
)

// NotifyCard is the admin-only Notifications card: one outbound ntfy topic,
// JSON webhook, or email (SMTP). The form never contains the URL path, the
// token, or the SMTP password; it only says whether each is stored.
templ NotifyCard(v *notify.SettingsView, csrfToken string) {
	@SettingsSection("Notifications", templ.Attributes{"id": "notify-settings"}) {
		<p class="text-sm text-foreground-secondary" data-testid="notify-status">{ notifyStatusLine(v) }</p>
		<form class="mt-4" data-testid="notify-settings-form" hx-put="/settings/notifications" hx-target="#notify-settings" hx-swap="outerHTML" hx-disable="find button" hx-indicator="find .htmx-indicator" autocomplete="off">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			@ui.Switch(ui.CheckboxProps{ID: "notify-enabled", Name: "enabled", Value: "true", Label: "Enabled", Description: "Turning this off stops every alert and keeps the settings.", Checked: v.Enabled, Class: ""})
			<div>
				@SettingsRow("Type", "", "notify-kind") {
					@ui.Select(ui.SelectProps{ID: "notify-kind", Name: "kind", Options: notifyKindOptions(), Selected: v.Kind})
				}
				<div class="sm:col-span-2">
					@SettingsRow("URL", "", "notify-url") {
						@ui.Input(ui.InputProps{ID: "notify-url", Name: "url", Type: "url", Autocomplete: "off", Placeholder: notifyURLPlaceholder(v), DescribedBy: "notify-url-state", Attrs: templ.Attributes{"spellcheck": "false"}})
					}
					<p id="notify-url-state" class="mt-1 text-xs text-foreground-secondary" data-testid="notify-url-state">{ notifyURLState(v) }</p>
				</div>
				<div class="sm:col-span-2">
					@SettingsRow("Access token", "", "notify-token") {
						@ui.Input(ui.InputProps{ID: "notify-token", Name: "token", Type: "password", Autocomplete: "new-password", Placeholder: notifyTokenPlaceholder(v), DescribedBy: "notify-token-state"})
					}
					<p id="notify-token-state" class="mt-1 text-xs text-foreground-secondary" data-testid="notify-token-state">{ notifyTokenState(v) }</p>
				</div>
				if v.TokenSet {
					@ui.Checkbox(ui.CheckboxProps{ID: "notify-clear-token", Name: "clear_token", Value: "true", Label: "Remove the stored token", Class: ""})
				}
			</div>
			<fieldset class="mt-4" data-testid="notify-smtp">
				<legend class="text-sm font-medium text-foreground">Email (SMTP)</legend>
				<p class="mt-1 text-xs text-foreground-secondary">Used when Type is Email. URL and token above are used for ntfy and webhook.</p>
				<div class="mt-4 grid gap-x-4 sm:grid-cols-2">
					@SettingsRow("SMTP host", "", "notify-smtp-host") {
						@ui.Input(ui.InputProps{ID: "notify-smtp-host", Name: "smtp_host", Type: "text", Value: v.SMTPHost, Autocomplete: "off", Placeholder: "smtp.example.com", Attrs: templ.Attributes{"spellcheck": "false"}})
					}
					@SettingsRow("SMTP port", "", "notify-smtp-port") {
						@ui.Input(ui.InputProps{ID: "notify-smtp-port", Name: "smtp_port", Type: "number", Value: notifySMTPPort(v), Placeholder: "587", Attrs: templ.Attributes{"min": "1", "max": "65535"}})
					}
					@SettingsRow("TLS", "", "notify-smtp-tls") {
						@ui.Select(ui.SelectProps{ID: "notify-smtp-tls", Name: "smtp_tls", Options: notifySMTPTLSOptions(), Selected: v.SMTPTLS})
					}
					@SettingsRow("SMTP username", "", "notify-smtp-username") {
						@ui.Input(ui.InputProps{ID: "notify-smtp-username", Name: "smtp_username", Type: "text", Value: v.SMTPUsername, Autocomplete: "off", Attrs: templ.Attributes{"spellcheck": "false"}})
					}
					<div class="sm:col-span-2">
						@SettingsRow("SMTP password", "", "notify-smtp-password") {
							@ui.Input(ui.InputProps{ID: "notify-smtp-password", Name: "smtp_password", Type: "password", Autocomplete: "new-password", Placeholder: notifySMTPPasswordPlaceholder(v), DescribedBy: "notify-smtp-password-state"})
						}
						<p id="notify-smtp-password-state" class="mt-1 text-xs text-foreground-secondary" data-testid="notify-smtp-password-state">{ notifySMTPPasswordState(v) }</p>
					</div>
					if v.SMTPPasswordSet {
						@ui.Checkbox(ui.CheckboxProps{ID: "notify-clear-smtp-password", Name: "clear_smtp_password", Value: "true", Label: "Remove the stored SMTP password", Class: ""})
					}
					@SettingsRow("From", "", "notify-smtp-from") {
						@ui.Input(ui.InputProps{ID: "notify-smtp-from", Name: "smtp_from", Type: "text", Value: v.SMTPFrom, Autocomplete: "off", Placeholder: "GoForge <goforge@example.com>"})
					}
					@SettingsRow("To", "Up to 10 addresses, separated by commas.", "notify-smtp-to") {
						@ui.Input(ui.InputProps{ID: "notify-smtp-to", Name: "smtp_to", Type: "text", Value: v.SMTPTo, Autocomplete: "off", Placeholder: "ops@example.com, me@example.com",})
					}
				</div>
			</fieldset>
			<p class="mt-4 text-xs text-foreground-secondary">Alerts carry the event, the resource, a redacted error, a link, and the audit id. Never passwords, tokens, or connection strings.</p>
			@SettingsActions() {
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonSecondary,
					Size: ui.ButtonSM,
					Attrs: templ.Attributes{
						"data-testid": "notify-test",
						"hx-post": "/settings/notifications/test",
						"hx-include": "closest form",
						"hx-swap": "none",
						"hx-target": "this",
					},
				}) {
					Send test
				}
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonPrimary,
					Size: ui.ButtonSM,
					Type: "submit",
					Attrs: templ.Attributes{
						"data-testid": "notify-save",
					},
				}) {
					Save notification settings
					@components.Spinner()
				}
			}
		</form>
	}
}
