package settings

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"time"

	"github.com/raythurman2386/goforge/internal/backup"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

// Profile renders the profile page. backups is nil for non-admins, which
// hides the Backups card. backupForm is the admin settings form; nil shows
// the card read-only. mcp is nil when /mcp is off (GOFORGE_MCP_HTTP=false),
// which hides the MCP card.
templ Profile(user *models.User, csrfToken string, backups *backup.Status, backupForm *backup.SettingsView, mcp *MCPCard) {
	@layouts.AppLayout("Profile Settings", csrfToken) {
		<div class="max-w-2xl mx-auto">
			@components.PageHeader("Profile Settings", "Manage your account information and security.")

			<!-- Profile Information -->
			@ui.Card(ui.CardProps{Class: "mb-8"}) {
				<div class="mb-4 flex items-center gap-4">
					@ui.Avatar(ui.AvatarProps{Name: components.UserDisplayName(user), Size: ui.AvatarLG})
					<div class="min-w-0">
						@ui.CardTitle(3, nil) {
							Account Information
						}
						<p class="truncate text-sm text-muted-foreground">{ components.UserDisplayName(user) }</p>
					</div>
				</div>
				<form hx-put="/settings/profile" hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
					<input type="hidden" name="csrf_token" value={ csrfToken } />
					
					@ui.Input(ui.InputProps{ID: "profile-email", Name: "email", Type: "email", Label: "Email Address", Value: user.Email, Autocomplete: "email", Required: true, Class: "mb-4"})

					<div class="mb-4">
						<p class={ ui.LabelClass("") }>Account Type</p>
						<div class="mt-1">
							if user.IsGitHubUser() {
								@ui.Badge(ui.BadgeProps{Variant: ui.BadgeSolid, Size: ui.BadgeMD}) {
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
									</svg>
									GitHub Account
								}
								<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Your account is linked to GitHub. Some settings may be managed through GitHub.</p>
							} else {
								@ui.Badge(ui.BadgeProps{Tone: ui.BadgePrimary, Size: ui.BadgeMD}) {
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
									</svg>
									Local Account
								}
							}
						</div>
					</div>

					<div class="flex justify-end">
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
							Save Changes
							@components.Spinner()
						}
					</div>
				</form>
			}

			<!-- Change Password (Local accounts only) -->
			if !user.IsGitHubUser() {
				@ui.Card(ui.CardProps{Class: "mb-8"}) {
					@ui.CardTitle(3, templ.Attributes{"class": "mb-4"}) {
						Change Password
					}
					<form hx-put="/settings/password" hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
						<input type="hidden" name="csrf_token" value={ csrfToken } />
						
						@ui.Input(ui.InputProps{ID: "password-current", Name: "current_password", Type: "password", Label: "Current Password", Autocomplete: "current-password", Required: true, Class: "mb-4"})
						@ui.Input(ui.InputProps{ID: "password-new", Name: "new_password", Type: "password", Label: "New Password", Autocomplete: "new-password", Required: true, Help: "At least 8 characters.", Class: "mb-4", Attrs: templ.Attributes{"minlength": "8"}})
						@ui.Input(ui.InputProps{ID: "password-confirm", Name: "confirm_password", Type: "password", Label: "Confirm New Password", Autocomplete: "new-password", Required: true, Class: "mb-4", Attrs: templ.Attributes{"minlength": "8"}})

						<div class="flex justify-end">
							@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
								Update Password
								@components.Spinner()
							}
						</div>
					</form>
				}
			}

			if backups != nil {
				@BackupCard(backups, backupForm, csrfToken)
			}

			if mcp != nil {
				@MCPCardView(mcp)
			}

			<!-- API Tokens -->
			@ui.Card(ui.CardProps{}) {
				<div class="flex items-center justify-between mb-4">
					@ui.CardTitle(3, nil) {
						API Tokens
					}
					@ui.Button(ui.ButtonProps{
						Variant: ui.ButtonSecondary,
						Size: ui.ButtonSM,
						Attrs: ui.OpenDialogAttrs("/settings/tokens/new"),
					}) {
						<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						Generate Token
					}
				</div>
				<p class="text-sm text-gray-500 mb-4 dark:text-gray-400">API tokens allow programmatic access to your account. Keep them secure!</p>
				
				<div class="mb-4">
					@ui.AlertMessage(ui.AlertInfo, "Send a token as Authorization: Bearer <token>. Scoped tokens (read, write, protected) work on the JSON API under /api/v1 and on the MCP endpoint at /mcp. Full tokens also work on the web routes and are refused on /mcp.")
				</div>

				<div id="tokens-list" hx-get="/settings/tokens" hx-trigger="load, tokenCreated from:body" hx-swap="innerHTML" class="divide-y divide-gray-100 animate-fade-in dark:divide-gray-800">
					@components.LoadingState("Loading tokens...")
				</div>
			}
		</div>
	}
}

// MCPCardView shows the /mcp endpoint, a copy-ready mcp.json, and the MCP
// token preset.
templ MCPCardView(mcp *MCPCard) {
	@ui.Card(ui.CardProps{Class: "mb-8", Attrs: templ.Attributes{"id": "mcp-card"}}) {
		<div class="flex items-center justify-between mb-4">
			@ui.CardTitle(3, nil) {
				MCP
			}
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonPrimary,
				Size: ui.ButtonSM,
				Attrs: ui.OpenDialogAttrs("/settings/tokens/new?preset=mcp"),
			}) {
				Generate MCP token
			}
		</div>
		<p class="text-sm text-gray-500 mb-4 dark:text-gray-400">
			Point an MCP client (Cursor, Claude, or any streamable HTTP client) at this endpoint with an MCP token. A read token gets { fmt.Sprint(MCPReadTools) } read-only tools; a token with write gets all { fmt.Sprint(MCPWriteTools) }, and every change is a dry run until you pass an approval_ref. Full tokens are refused.
		</p>
		<p class={ ui.LabelClass("") }>Endpoint</p>
		<code id="mcp-endpoint" class="mb-4 block w-full rounded-lg bg-gray-100 p-3 text-sm font-mono break-all border border-gray-200 dark:bg-gray-800 dark:border-gray-800">{ mcp.Endpoint }</code>
		<p class={ ui.LabelClass("") }>mcp.json</p>
		<pre id="mcp-snippet" class="mb-2 w-full overflow-x-auto rounded-lg bg-gray-100 p-3 text-xs font-mono border border-gray-200 dark:bg-gray-800 dark:border-gray-800">{ mcp.Snippet }</pre>
		<p class="text-xs text-gray-500 mb-4 dark:text-gray-400">Set <code>{ MCPTokenEnv }</code> in the client's environment to the token. The token is not stored in the file.</p>
		<div class="flex justify-end">
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Size: ui.ButtonSM, Attrs: ui.CopyAttrs("mcp-snippet")}) {
				Copy mcp.json
			}
		</div>
	}
}

templ APITokenRow(token *models.APIToken) {
	<div class="py-4 flex items-center justify-between hover:bg-gray-50 -mx-4 px-4 dark:hover:bg-gray-800/50" id={ "token-" + token.ID }>
		<div>
			<p class="text-sm font-medium text-gray-900 dark:text-gray-100">
				{ token.Name }
				if token.TokenHint != "" {
					<code class="ml-2 text-xs font-mono text-gray-500 dark:text-gray-400" data-token-hint>{ token.TokenHint }</code>
				}
			</p>
			<p class="text-xs text-gray-500 dark:text-gray-400">
				Created { formatDate(token.CreatedAt) }
				if token.LastUsedAt.Valid {
					• Last used { formatDate(token.LastUsedAt.Time) }
				}
				if token.ExpiresAt.Valid {
					• Expires { formatDate(token.ExpiresAt.Time) }
				}
			</p>
			<p class="mt-1 flex flex-wrap gap-1">
				for _, scope := range tokenScopes(token) {
					@ui.Badge(ui.BadgeProps{Variant: ui.BadgeSubtle, Square: true, Class: "px-2 text-gray-700 dark:text-gray-300"}) {
						{ scope }
					}
				}
			</p>
		</div>
		<div class="flex items-center gap-2">
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonSecondary,
				Size: ui.ButtonSM,
				Attrs: templ.Attributes{
					"hx-post": "/settings/tokens/" + token.ID + "/rotate",
					"hx-target": "body",
					"hx-swap": "beforeend",
					"aria-haspopup": "dialog",
					"hx-confirm": "Rotate this token? The current secret stops working immediately.",
					"data-ui-confirm-label": "Rotate",
				},
			}) {
				Rotate
			}
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonDanger,
				Size: ui.ButtonSM,
				Attrs: templ.Attributes{
					"hx-delete": "/settings/tokens/" + token.ID,
					"hx-target": "#tokens-list",
					"hx-swap": "innerHTML",
					"hx-confirm": "Revoke this token? Anything using it stops working immediately.",
					"data-ui-confirm-tone": "danger",
					"data-ui-confirm-label": "Revoke",
				},
			}) {
				Revoke
			}
		</div>
	</div>
}

templ EmptyTokenList() {
	@components.EmptyState(components.EmptyStateProps{
		Title:       "No API tokens yet",
		Description: "Generate one to get started.",
		Compact:     true,
	})
}

// TokenCreatedModal shows a new or rotated token once. mcp adds the
// GOFORGE_MCP_TOKEN hint for tokens /mcp accepts.
templ TokenCreatedModal(title, rawToken string, mcp bool) {
	@ui.Dialog(ui.DialogProps{Title: title, NonDismissible: true}) {
		<div class="flex items-start gap-3 mb-6">
			<div class="h-10 w-10 flex-shrink-0 rounded-full bg-primary-100 flex items-center justify-center dark:bg-primary-900/50">
				<svg class="h-6 w-6 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
			<div class="min-w-0 flex-1">
				<p class="text-sm text-gray-500 dark:text-gray-400">Copy this token now. You won't be able to see it again!</p>
				<code id="created-token" class="mt-3 block w-full rounded-lg bg-gray-100 p-3 text-sm font-mono break-all border border-gray-200 dark:bg-gray-800 dark:border-gray-800">{ rawToken }</code>
				if mcp {
					<p class="mt-3 text-xs text-gray-500 dark:text-gray-400">For MCP, set <code>{ MCPTokenEnv }</code> to this token where your client runs.</p>
				}
			</div>
		</div>
		<div class="flex justify-end gap-3">
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Attrs: templ.Attributes{"data-ui-dialog-close": true}}) {
				Close
			}
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Attrs: ui.CopyAttrs("created-token")}) {
				Copy to Clipboard
			}
		</div>
	}
}

// AddAPITokenModal is the token form. mcp is the MCP preset: read and
// write checked, 90 days by default, no never-expiring option, and the
// server refuses full.
templ AddAPITokenModal(csrfToken string, mcp bool) {
	@ui.Dialog(ui.DialogProps{Title: addTokenTitle(mcp)}) {
		<form hx-post="/settings/tokens" hx-target="closest dialog" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			if mcp {
				<input type="hidden" name="preset" value="mcp" />
			}
			@ui.Input(ui.InputProps{ID: "token-name", Name: "name", Label: "Token Name", Value: tokenNameDefault(mcp), Autocomplete: "off", Required: true, Help: "Give your token a descriptive name to help you identify it later.", Class: "mb-4"})
			@ui.Select(ui.SelectProps{ID: "token-expires", Name: "expires_in", Label: "Expires", Options: tokenExpiryOptions(mcp), Selected: tokenExpiryDefault(mcp), Class: "mb-4"})
			@ui.CheckboxGroup(ui.CheckboxGroupProps{Legend: "Scopes", DescribedBy: "token-scopes-help", Class: "mb-4"}) {
				if mcp {
					<p id="token-scopes-help" class="text-xs text-gray-500 dark:text-gray-400">An MCP token needs read. Add write for the gated mutation tools; add protected only if the agent may stop, reconfigure, or re-image protected services.</p>
				} else {
					<p id="token-scopes-help" class="text-xs text-gray-500 dark:text-gray-400">Leave all unchecked for a full token that also works on the web routes. A scoped token works only on <code>/api/v1</code> and <code>/mcp</code>.</p>
				}
				@ui.Checkbox(ui.CheckboxProps{ID: "token-scope-read", Name: "scopes", Value: "read", Label: "read: list and inspect projects, services, containers, logs", Checked: mcp})
				@ui.Checkbox(ui.CheckboxProps{ID: "token-scope-write", Name: "scopes", Value: "write", Label: "write: gated deploys, restarts, env vars, service changes", Checked: mcp})
				@ui.Checkbox(ui.CheckboxProps{ID: "token-scope-protected", Name: "scopes", Value: "protected", Label: "protected: stop, reconfigure, or re-image protected services"})
			}

			<div class="mt-8 flex justify-end space-x-3">
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonSecondary,
					Attrs: templ.Attributes{
						"data-ui-dialog-close": true,
					},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
					Generate Token
					@components.Spinner()
				}
			</div>
		</form>
	}
}

func addTokenTitle(mcp bool) string {
	if mcp {
		return "Generate MCP Token"
	}
	return "Generate API Token"
}

// tokenNameDefault prefills the MCP preset's token name.
func tokenNameDefault(mcp bool) string {
	if mcp {
		return "MCP"
	}
	return ""
}

// tokenExpiryOptions lists token lifetimes in days; the MCP preset has no
// never-expiring choice.
func tokenExpiryOptions(mcp bool) []ui.SelectOption {
	opts := []ui.SelectOption{
		{Value: "30", Label: "30 days"},
		{Value: "90", Label: "90 days"},
		{Value: "365", Label: "1 year"},
	}
	if !mcp {
		opts = append(opts, ui.SelectOption{Value: "0", Label: "Never"})
	}
	return opts
}

// tokenExpiryDefault is 90 days for MCP tokens and 1 year otherwise.
func tokenExpiryDefault(mcp bool) string {
	if mcp {
		return "90"
	}
	return "365"
}

// tokenScopes returns the scopes shown on a token row.
func tokenScopes(token *models.APIToken) []string {
	if len(token.Scopes) == 0 {
		return []string{models.ScopeFull}
	}
	return token.Scopes
}

func formatDate(t time.Time) string {
	return t.Format("Jan 2, 2006")
}

// BackupCard is the admin-only Backups card: the last-run status line and,
// when form is set, the settings form. The form never contains the secret
// access key; it only says whether one is stored. There is no run-now
// button; use `goforge backup run`.
templ BackupCard(st *backup.Status, form *backup.SettingsView, csrfToken string) {
	@ui.Card(ui.CardProps{Class: "mb-8", Attrs: templ.Attributes{"id": "backup-status"}}) {
		@ui.CardTitle(3, templ.Attributes{"class": "mb-2"}) {
			Backups
		}
		if !st.Enabled {
			<p class={ "text-sm", backupOffClass(form) } data-testid="backup-off">
				{ backupOffLine(st, form) }
			</p>
		} else {
			<p class={ "text-sm", backupLineClass(st) } data-testid="backup-last">
				{ backupLastLine(st) }
			</p>
			if st.LastRun != nil && st.LastRun.Status == statusFailed && st.LastRun.ErrorSummary != "" {
				<p class="mt-1 text-xs text-red-700 break-words dark:text-red-300">{ st.LastRun.ErrorSummary }</p>
			}
			<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
				{ backupScheduleLine(st) }
			</p>
		}
		<div
			id="backup-restore-points"
			class="mt-4 border-t border-gray-200 pt-4 dark:border-gray-700"
			data-testid="backup-restore-points"
			hx-get="/settings/backups/restore-points"
			hx-trigger="load"
			hx-swap="innerHTML"
		>
			<h4 class="text-sm font-medium text-gray-900 dark:text-gray-100">Restore points</h4>
			<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Loading restore points…</p>
		</div>
		if form != nil {
			@backupSettingsForm(form, csrfToken)
		}
	}
}

// BackupRestorePoints is the read-only Restore points list, loaded into the
// Backups card. There is no restore button: restoring is CLI-only.
templ BackupRestorePoints(v *backup.RestorePointsView) {
	<h4 class="text-sm font-medium text-gray-900 dark:text-gray-100">Restore points</h4>
	if v.Error != "" {
		<p class="mt-1 text-xs text-red-700 break-words dark:text-red-300" data-testid="restore-points-error">{ v.Error }</p>
	} else if len(v.Points) == 0 {
		<p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-testid="restore-points-empty">
			{ fmt.Sprintf("No complete backups in %s/%s yet.", v.Bucket, v.Prefix) }
		</p>
	} else {
		@ui.Table(ui.TableProps{Caption: "Restore points", Compact: true, WrapperClass: "mt-2", Attrs: templ.Attributes{"data-testid": "restore-points"}}) {
			<thead>
				@ui.TR(templ.Attributes{"class": "text-gray-500 dark:text-gray-400"}) {
					@ui.TH(ui.CellProps{Compact: true}) { Run key }
					@ui.TH(ui.CellProps{Compact: true}) { Taken }
					@ui.TH(ui.CellProps{Compact: true}) { Trigger }
					@ui.TH(ui.CellProps{Compact: true}) { Size }
					@ui.TH(ui.CellProps{Compact: true}) { Skipped }
				}
			</thead>
			<tbody>
				for _, p := range v.Points {
					@ui.TR(templ.Attributes{"class": "border-t border-gray-100 text-gray-700 dark:border-gray-800 dark:text-gray-300", "data-testid": "restore-point"}) {
						@ui.TD(ui.CellProps{Compact: true, Class: "font-mono"}) { { p.RunKey } }
						if p.Manifest == nil {
							@ui.TD(ui.CellProps{Compact: true, Colspan: 4, Class: "text-red-700 dark:text-red-300"}) { { p.Problem } }
						} else {
							@ui.TD(ui.CellProps{Compact: true}) { { restorePointTime(v, p.Manifest.StartedAt) } }
							@ui.TD(ui.CellProps{Compact: true}) { { p.Manifest.Trigger } }
							@ui.TD(ui.CellProps{Compact: true}) { { humanBytes(p.Manifest.TotalBytes()) } }
							@ui.TD(ui.CellProps{Compact: true}) { { fmt.Sprint(len(p.Manifest.Skipped)) } }
						}
					}
				}
			</tbody>
		}
		if v.Incomplete > 0 {
			<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{ fmt.Sprintf("%d incomplete run(s) without a manifest are not listed.", v.Incomplete) }</p>
		}
		<p class="mt-2 text-xs text-gray-500 dark:text-gray-400" data-testid="restore-points-howto">
			Restoring replaces the GoForge database (not service data) and is done from the command line. Stop GoForge, preview with a dry run, then add <code class="font-mono">--yes</code>:
		</p>
		<pre class="mt-1 overflow-x-auto rounded bg-gray-100 p-2 text-xs dark:bg-gray-800"><code>{ restoreCommand(v) }</code></pre>
	}
}

templ backupSettingsForm(f *backup.SettingsView, csrfToken string) {
	<form class="mt-6 border-t border-gray-100 pt-4 dark:border-gray-800" data-testid="backup-settings-form" hx-put="/settings/backups" hx-target="#backup-status" hx-swap="outerHTML" hx-disabled-elt="find button" hx-indicator="find .htmx-indicator" autocomplete="off">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<p class="mb-4 text-xs text-gray-500 dark:text-gray-400" data-testid="backup-source">{ backupSourceLine(f) }</p>
		@ui.Switch(ui.CheckboxProps{ID: "backup-enabled", Name: "enabled", Value: "true", Label: "Enabled", Description: "Turning this off stops the schedule and keeps the settings.", Checked: f.Enabled, Class: "mb-4"})
		<div class="grid gap-4 sm:grid-cols-2">
			@ui.Input(ui.InputProps{ID: "backup-endpoint", Name: "endpoint", Type: "url", Label: "Endpoint", Value: f.Endpoint, Placeholder: "https://<account>.r2.cloudflarestorage.com", Class: "sm:col-span-2"})
			@ui.Input(ui.InputProps{ID: "backup-bucket", Name: "bucket", Label: "Bucket", Value: f.Bucket})
			@ui.Input(ui.InputProps{ID: "backup-prefix", Name: "prefix", Label: "Prefix", Value: f.Prefix, Placeholder: "goforge/"})
			@ui.Input(ui.InputProps{ID: "backup-region", Name: "region", Label: "Region", Value: f.Region, Placeholder: "auto"})
			@ui.Checkbox(ui.CheckboxProps{ID: "backup-path-style", Name: "force_path_style", Value: "true", Label: "Path-style URLs (MinIO, Garage)", Checked: f.ForcePathStyle, Class: "self-end pb-2"})
			<div>
				@ui.Input(ui.InputProps{ID: "backup-access-key", Name: "access_key_id", Label: "Access key ID", Autocomplete: "off", Placeholder: accessKeyPlaceholder(f), DescribedBy: "backup-access-key-state", Attrs: templ.Attributes{"spellcheck": "false"}})
				<p id="backup-access-key-state" class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-testid="backup-access-key-state">{ accessKeyState(f) }</p>
			</div>
			<div>
				@ui.Input(ui.InputProps{ID: "backup-secret", Name: "secret_access_key", Type: "password", Label: "Secret access key", Autocomplete: "new-password", Placeholder: secretPlaceholder(f), DescribedBy: "backup-secret-state"})
				<p id="backup-secret-state" class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-testid="backup-secret-state">{ secretState(f) }</p>
			</div>
			if f.AccessKeySet || f.SecretSet {
				@ui.Checkbox(ui.CheckboxProps{ID: "backup-clear-creds", Name: "clear_credentials", Value: "true", Label: "Remove the stored keys (backups must be off)", Class: "sm:col-span-2"})
			}
			@ui.Input(ui.InputProps{ID: "backup-schedule-time", Name: "schedule_time", Type: "time", Label: "Nightly at", Value: f.ScheduleTime})
			@ui.Input(ui.InputProps{ID: "backup-schedule-zone", Name: "schedule_zone", Label: "Time zone", Value: f.ScheduleZone, Placeholder: "America/Chicago"})
			@ui.Switch(ui.CheckboxProps{ID: "backup-schedule-off", Name: "schedule_off", Value: "true", Checked: f.ScheduleOff, Class: "sm:col-span-2"}) {
				No nightly schedule (run with <code>goforge backup run</code>)
			}
			@ui.Input(ui.InputProps{ID: "backup-retention", Name: "retention_daily", Type: "number", Label: "Keep daily backups (days)", Value: fmt.Sprint(f.RetentionDaily), Attrs: templ.Attributes{"min": "1", "max": "366"}})
			@ui.Input(ui.InputProps{ID: "backup-timeout", Name: "timeout", Label: "Run timeout", Value: f.Timeout, Placeholder: "2h"})
		</div>
		<div class="mt-4 flex justify-end gap-2">
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonSecondary,
				Attrs: templ.Attributes{
					"data-testid": "backup-test",
					"hx-post": "/settings/backups/test",
					"hx-include": "closest form",
					"hx-swap": "none",
					"hx-target": "this",
				},
			}) {
				Test connection
			}
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonPrimary,
				Type: "submit",
				Attrs: templ.Attributes{
					"data-testid": "backup-save",
				},
			}) {
				Save backup settings
				@components.Spinner()
			}
		</div>
	</form>
}
