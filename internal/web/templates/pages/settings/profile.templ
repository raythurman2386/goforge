package settings

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"time"

	"github.com/raythurman2386/goforge/internal/backup"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
)

// Profile renders only personal identity; sign-in and instance settings
// live on their own pages.
templ Profile(user *models.User, csrfToken string) {
	@SettingsLayout(SettingsPageProfile, "Profile Settings", "Manage your account information.", csrfToken) {
		@SettingsSection("Account Information", nil) {
			@SettingsRow("Username", components.UserDisplayName(user), "") {
				<div class="flex items-center justify-between gap-3">
					@ui.Avatar(ui.AvatarProps{Name: components.UserDisplayName(user), Size: ui.AvatarLG})
					@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Size: ui.ButtonSM, Type: "submit", Attrs: templ.Attributes{"form": "profile-form", "hx-put": "/settings/profile", "hx-swap": "none", "hx-disable": "find button[type='submit']", "hx-indicator": "find .htmx-indicator"}}) {
						Save Changes
						@components.Spinner()
					}
				</div>
			}
			<form id="profile-form" hx-put="/settings/profile" hx-swap="none" hx-disable="find button[type='submit']" hx-indicator="find .htmx-indicator">
				<input type="hidden" name="csrf_token" value={ csrfToken } />
				@SettingsRow("Email Address", "The address used for your GoForge account.", "profile-email") {
					<div class="relative">
						@ui.Input(ui.InputProps{ID: "profile-email", Name: "email", Type: "email", Value: user.Email, Autocomplete: "email", Required: true, ControlClass: "pr-11"})
						<svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-foreground-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.5 10.5V6.75a4.5 4.5 0 00-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
					</div>
				}
				@SettingsRow("Account Type", "Your sign-in connection.", "") {
					if user.IsGitHubUser() {
						<div class="flex items-center gap-2">@StatusPill(ui.BadgePrimary) { GitHub Account }</div>
						<p class="mt-2 text-sm text-foreground-secondary">Your account is linked to GitHub. Some settings may be managed through GitHub.</p>
					} else {
						@StatusPill(ui.BadgePrimary) { Local Account }
					}
				}
			</form>
		}
	}
}

// MCPCardView shows the /mcp endpoint, a copy-ready mcp.json, and the MCP
// token preset.
templ MCPCardView(mcp *MCPCard) {
	@SettingsSection("MCP", templ.Attributes{"id": "mcp-card"}) {
		<p class="mb-4 text-sm text-foreground-secondary">Point an MCP client (Cursor, Claude, or any streamable HTTP client) at this endpoint with an MCP token. A read token gets { fmt.Sprint(MCPReadTools) } read-only tools; a token with write gets all { fmt.Sprint(MCPWriteTools) }, and every change is a dry run until you pass an approval_ref. Full tokens are refused.</p>
		@SettingsRow("Endpoint", "The streamable HTTP endpoint.", "") {
			<code id="mcp-endpoint" class="block w-full rounded-md bg-code p-3 text-sm font-mono break-all border border-border">{ mcp.Endpoint }</code>
		}
		@SettingsRow("mcp.json", "Client configuration.", "") {
			<pre id="mcp-snippet" tabindex="0" role="region" aria-label="MCP client configuration" class="w-full overflow-x-auto rounded-md bg-code p-3 text-xs font-mono border border-border">{ mcp.Snippet }</pre>
		}
		<p class="mt-2 text-xs text-foreground-secondary">Set <code>{ MCPTokenEnv }</code> in the client's environment to the token. The token is not stored in the file.</p>
		@SettingsActions() {
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Size: ui.ButtonSM, Attrs: ui.CopyAttrs("mcp-snippet")}) { Copy mcp.json }
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Size: ui.ButtonSM, Attrs: ui.OpenDialogAttrs("/settings/tokens/new?preset=mcp")}) { Generate MCP token }
		}
	}
}

// APITokenRow is one token on the Security list. res names the token's
// projects and services; nil shows short IDs.
templ APITokenRow(token *models.APIToken, res *TokenResources) {
	<div class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between" id={ "token-" + token.ID }>
		<div>
			<p class="text-sm font-medium text-foreground">
				{ token.Name }
				if token.TokenHint != "" {
					<code class="ml-2 text-xs font-mono text-foreground-secondary" data-token-hint>{ token.TokenHint }</code>
				}
			</p>
			<p class="text-xs text-foreground-secondary">
				Created { formatDate(token.CreatedAt) }
				if token.LastUsedAt.Valid {
					• Last used { formatDate(token.LastUsedAt.Time) }
				}
				if token.ExpiresAt.Valid {
					• Expires { formatDate(token.ExpiresAt.Time) }
				}
			</p>
			<p class="mt-1 flex flex-wrap gap-1">
				for _, scope := range tokenScopes(token) {
					@ui.Badge(ui.BadgeProps{Variant: ui.BadgeSubtle, Square: true, Class: "px-2 text-foreground-secondary"}) {
						{ scope }
					}
				}
			</p>
			if token.IsRestricted() {
				<p class="mt-1 flex flex-wrap items-center gap-1" data-token-restricted>
					<span class="text-xs text-foreground-secondary">Restricted to</span>
					for _, rr := range tokenRestrictions(token, res) {
						@ui.Badge(ui.BadgeProps{Variant: ui.BadgeSubtle, Square: true, Class: "px-2 text-foreground-secondary", Attrs: templ.Attributes{"data-token-" + rr.Kind: rr.ID, "title": rr.Kind + " " + rr.ID}}) {
							{ rr.Kind }: { rr.Name }
						}
					}
				</p>
			} else {
				<p class="mt-1 text-xs text-foreground-secondary" data-token-host-wide>All projects and services</p>
			}
		</div>
		<div class="flex items-center gap-2">
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonSecondary,
				Size: ui.ButtonSM,
				Attrs: templ.Attributes{
					"hx-post": "/settings/tokens/" + token.ID + "/rotate",
					"hx-target": "body",
					"hx-swap": "beforeend",
					"aria-haspopup": "dialog",
					"hx-confirm": "Rotate this token? The current secret stops working immediately.",
					"data-ui-confirm-label": "Rotate",
				},
			}) {
				Rotate
			}
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonDanger,
				Size: ui.ButtonSM,
				Attrs: templ.Attributes{
					"hx-delete": "/settings/tokens/" + token.ID,
					"hx-target": "#tokens-list",
					"hx-swap": "innerHTML",
					"hx-confirm": "Revoke this token? Anything using it stops working immediately.",
					"data-ui-confirm-tone": "danger",
					"data-ui-confirm-label": "Revoke",
				},
			}) {
				Revoke
			}
		</div>
	</div>
}

templ EmptyTokenList() {
	@components.EmptyState(components.EmptyStateProps{
		Title:       "No API tokens yet",
		Description: "Generate one to get started.",
		Compact:     true,
	})
}

// TokenCreatedModal shows a new or rotated token once. mcp adds the
// GOFORGE_MCP_TOKEN hint for tokens /mcp accepts.
templ TokenCreatedModal(title, rawToken string, mcp bool) {
	@ui.Dialog(ui.DialogProps{Title: title, NonDismissible: true}) {
		<div class="flex items-start gap-3 mb-6">
			<div class="h-10 w-10 shrink-0 rounded-full bg-primary-100 flex items-center justify-center dark:bg-primary-900/50">
				<svg class="h-6 w-6 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
			<div class="min-w-0 flex-1">
				<p class="text-sm text-foreground-secondary">Copy this token now. You won't be able to see it again!</p>
				<code id="created-token" class="mt-3 block w-full rounded-lg bg-code p-3 text-sm font-mono break-all border border-border">{ rawToken }</code>
				if mcp {
					<p class="mt-3 text-xs text-foreground-secondary">For MCP, set <code>{ MCPTokenEnv }</code> to this token where your client runs.</p>
				}
			</div>
		</div>
		<div class="flex justify-end gap-3">
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Attrs: templ.Attributes{"data-ui-dialog-close": true}}) {
				Close
			}
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Attrs: ui.CopyAttrs("created-token")}) {
				Copy to Clipboard
			}
		</div>
	}
}

// AddAPITokenModal is the token form. mcp is the MCP preset: read and
// write checked, 90 days by default, no never-expiring option, and the
// server refuses full.
// AddAPITokenModal is the token form. res lists the owner's projects and
// services for the optional restriction; nil or empty hides that section.
templ AddAPITokenModal(csrfToken string, mcp bool, res *TokenResources) {
	@ui.Dialog(ui.DialogProps{Title: addTokenTitle(mcp)}) {
		<form hx-post="/settings/tokens" hx-target="closest dialog" hx-swap="outerHTML" hx-disable="find button[type='submit']" hx-indicator="find .htmx-indicator">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			if mcp {
				<input type="hidden" name="preset" value="mcp" />
			}
			@ui.Input(ui.InputProps{ID: "token-name", Name: "name", Label: "Token Name", Value: tokenNameDefault(mcp), Autocomplete: "off", Required: true, Help: "Give your token a descriptive name to help you identify it later.", Class: "mb-4"})
			@ui.Select(ui.SelectProps{ID: "token-expires", Name: "expires_in", Label: "Expires", Options: tokenExpiryOptions(mcp), Selected: tokenExpiryDefault(mcp), Class: "mb-4"})
			@ui.CheckboxGroup(ui.CheckboxGroupProps{Legend: "Scopes", DescribedBy: "token-scopes-help", Class: "mb-4"}) {
				if mcp {
					<p id="token-scopes-help" class="text-xs text-foreground-secondary">An MCP token needs read. Add write for the gated mutation tools; add protected only if the agent may stop, reconfigure, or re-image protected services.</p>
				} else {
					<p id="token-scopes-help" class="text-xs text-foreground-secondary">Leave all unchecked for a full token that also works on the web routes. A scoped token works only on <code>/api/v1</code> and <code>/mcp</code>.</p>
				}
				@ui.Checkbox(ui.CheckboxProps{ID: "token-scope-read", Name: "scopes", Value: "read", Label: "read: list and inspect projects, services, containers, logs", Checked: mcp})
				@ui.Checkbox(ui.CheckboxProps{ID: "token-scope-write", Name: "scopes", Value: "write", Label: "write: gated deploys, restarts, env vars, service changes", Checked: mcp})
				@ui.Checkbox(ui.CheckboxProps{ID: "token-scope-protected", Name: "scopes", Value: "protected", Label: "protected: stop, reconfigure, or re-image protected services"})
			}
			if res.hasAny() {
				@ui.CheckboxGroup(ui.CheckboxGroupProps{Legend: "Restrict to (optional)", DescribedBy: "token-restrict-help", Class: "", Attrs: templ.Attributes{"data-token-restrict": true}}) {
					<p id="token-restrict-help" class="text-xs text-foreground-secondary">Leave all unchecked for every project and service. Check some to limit this token to them on <code>/api/v1</code> and <code>/mcp</code> (a project includes its deployments and containers). A restricted token needs at least one scope above.</p>
					for _, p := range res.Projects {
						@ui.Checkbox(ui.CheckboxProps{ID: "token-project-" + p.ID, Name: "project_ids", Value: p.ID, Label: "Project: " + p.Name})
					}
					for _, sv := range res.Services {
						@ui.Checkbox(ui.CheckboxProps{ID: "token-service-" + sv.ID, Name: "service_ids", Value: sv.ID, Label: "Service: " + sv.Name})
					}
				}
			}

			<div class="mt-8 flex justify-end space-x-3">
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonSecondary,
					Attrs: templ.Attributes{
						"data-ui-dialog-close": true,
					},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
					Generate Token
					@components.Spinner()
				}
			</div>
		</form>
	}
}

func addTokenTitle(mcp bool) string {
	if mcp {
		return "Generate MCP Token"
	}
	return "Generate API Token"
}

// tokenNameDefault prefills the MCP preset's token name.
func tokenNameDefault(mcp bool) string {
	if mcp {
		return "MCP"
	}
	return ""
}

// tokenExpiryOptions lists token lifetimes in days; the MCP preset has no
// never-expiring choice.
func tokenExpiryOptions(mcp bool) []ui.SelectOption {
	opts := []ui.SelectOption{
		{Value: "30", Label: "30 days"},
		{Value: "90", Label: "90 days"},
		{Value: "365", Label: "1 year"},
	}
	if !mcp {
		opts = append(opts, ui.SelectOption{Value: "0", Label: "Never"})
	}
	return opts
}

// tokenExpiryDefault is 90 days for MCP tokens and 1 year otherwise.
func tokenExpiryDefault(mcp bool) string {
	if mcp {
		return "90"
	}
	return "365"
}

// tokenScopes returns the scopes shown on a token row.
func tokenScopes(token *models.APIToken) []string {
	if len(token.Scopes) == 0 {
		return []string{models.ScopeFull}
	}
	return token.Scopes
}

func formatDate(t time.Time) string {
	return t.Format("Jan 2, 2006")
}

// BackupCard is the admin-only Backups card: the last-run status line and,
// when form is set, the settings form. The form never contains the secret
// access key; it only says whether one is stored. There is no run-now
// button; use `goforge backup run`.
templ BackupCard(st *backup.Status, form *backup.SettingsView, csrfToken string) {
	@SettingsSection("Backups", templ.Attributes{"id": "backup-status"}) {

		if !st.Enabled {
			<p class={ "text-sm", backupOffClass(form) } data-testid="backup-off">
				{ backupOffLine(st, form) }
			</p>
		} else {
			<p class={ "text-sm", backupLineClass(st) } data-testid="backup-last">
				{ backupLastLine(st) }
			</p>
			if st.LastRun != nil && st.LastRun.Status == statusFailed && st.LastRun.ErrorSummary != "" {
				<p class="mt-1 text-xs text-danger wrap-break-word">{ st.LastRun.ErrorSummary }</p>
			}
			<p class="mt-2 text-xs text-foreground-secondary">
				{ backupScheduleLine(st) }
			</p>
		}
		<div
			id="backup-restore-points"
			class="mt-4 border-t border-border pt-4"
			data-testid="backup-restore-points"
			hx-get="/settings/backups/restore-points"
			hx-trigger="load"
			hx-swap="innerHTML"
		>
			<h4 class="text-sm font-medium text-foreground">Restore points</h4>
			<p class="mt-1 text-xs text-foreground-secondary">Loading restore points…</p>
		</div>
		if form != nil {
			@backupSettingsForm(form, csrfToken)
		}
	}
}

// BackupRestorePoints is the read-only Restore points list, loaded into the
// Backups card. There is no restore button: restoring is CLI-only.
templ BackupRestorePoints(v *backup.RestorePointsView) {
	<h4 class="text-sm font-medium text-foreground">Restore points</h4>
	if v.Error != "" {
		<p class="mt-1 text-xs text-danger wrap-break-word" data-testid="restore-points-error">{ v.Error }</p>
	} else if len(v.Points) == 0 {
		<p class="mt-1 text-xs text-foreground-secondary" data-testid="restore-points-empty">
			{ fmt.Sprintf("No complete backups in %s/%s yet.", v.Bucket, v.Prefix) }
		</p>
	} else {
		@ui.Table(ui.TableProps{Caption: "Restore points", Compact: true, WrapperClass: "mt-2", Attrs: templ.Attributes{"data-testid": "restore-points"}}) {
			<thead>
				@ui.TR(templ.Attributes{"class": "text-foreground-secondary"}) {
					@ui.TH(ui.CellProps{Compact: true}) { Run key }
					@ui.TH(ui.CellProps{Compact: true}) { Taken }
					@ui.TH(ui.CellProps{Compact: true}) { Trigger }
					@ui.TH(ui.CellProps{Compact: true}) { Size }
					@ui.TH(ui.CellProps{Compact: true}) { Skipped }
				}
			</thead>
			<tbody>
				for _, p := range v.Points {
					@ui.TR(templ.Attributes{"class": "border-t border-divider text-foreground-secondary", "data-testid": "restore-point"}) {
						@ui.TD(ui.CellProps{Compact: true, Class: "font-mono"}) { { p.RunKey } }
						if p.Manifest == nil {
							@ui.TD(ui.CellProps{Compact: true, Colspan: 4, Class: "text-danger"}) { { p.Problem } }
						} else {
							@ui.TD(ui.CellProps{Compact: true}) { { restorePointTime(v, p.Manifest.StartedAt) } }
							@ui.TD(ui.CellProps{Compact: true}) { { p.Manifest.Trigger } }
							@ui.TD(ui.CellProps{Compact: true}) { { humanBytes(p.Manifest.TotalBytes()) } }
							@ui.TD(ui.CellProps{Compact: true}) { { fmt.Sprint(len(p.Manifest.Skipped)) } }
						}
					}
				}
			</tbody>
		}
		if v.Incomplete > 0 {
			<p class="mt-1 text-xs text-foreground-secondary">{ fmt.Sprintf("%d incomplete run(s) without a manifest are not listed.", v.Incomplete) }</p>
		}
		<p class="mt-2 text-xs text-foreground-secondary" data-testid="restore-points-howto">
			Restoring replaces the GoForge database (not service data) and is done from the command line. Stop GoForge, preview with a dry run, then add <code class="font-mono">--yes</code>:
		</p>
		<pre class="mt-1 overflow-x-auto rounded-sm bg-code p-2 text-xs"><code>{ restoreCommand(v) }</code></pre>
	}
}

templ backupSettingsForm(f *backup.SettingsView, csrfToken string) {
	<form class="mt-4 border-t border-divider pt-4" data-testid="backup-settings-form" hx-put="/settings/backups" hx-target="#backup-status" hx-swap="outerHTML" hx-disable="find button" hx-indicator="find .htmx-indicator" autocomplete="off">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<p class="mb-4 text-xs text-foreground-secondary" data-testid="backup-source">{ backupSourceLine(f) }</p>
		@ui.Switch(ui.CheckboxProps{ID: "backup-enabled", Name: "enabled", Value: "true", Label: "Enabled", Description: "Turning this off stops the schedule and keeps the settings.", Checked: f.Enabled, Class: ""})
		<div>
			@SettingsRow("Endpoint", "", "backup-endpoint") {
				@ui.Input(ui.InputProps{ID: "backup-endpoint", Name: "endpoint", Type: "url", Value: f.Endpoint, Placeholder: "https://<account>.r2.cloudflarestorage.com", Class: ""})
			}
			@SettingsRow("Bucket", "", "backup-bucket") {
				@ui.Input(ui.InputProps{ID: "backup-bucket", Name: "bucket", Value: f.Bucket})
			}
			@SettingsRow("Prefix", "", "backup-prefix") {
				@ui.Input(ui.InputProps{ID: "backup-prefix", Name: "prefix", Value: f.Prefix, Placeholder: "goforge/"})
			}
			@SettingsRow("Region", "", "backup-region") {
				@ui.Input(ui.InputProps{ID: "backup-region", Name: "region", Value: f.Region, Placeholder: "auto"})
			}
			@ui.Checkbox(ui.CheckboxProps{ID: "backup-path-style", Name: "force_path_style", Value: "true", Label: "Path-style URLs (MinIO, Garage)", Checked: f.ForcePathStyle, Class: "self-end pb-2"})
			<div>
				@SettingsRow("Access key ID", "", "backup-access-key") {
					@ui.Input(ui.InputProps{ID: "backup-access-key", Name: "access_key_id", Autocomplete: "off", Placeholder: accessKeyPlaceholder(f), DescribedBy: "backup-access-key-state", Attrs: templ.Attributes{"spellcheck": "false"}})
				}
				<p id="backup-access-key-state" class="mt-1 text-xs text-foreground-secondary" data-testid="backup-access-key-state">{ accessKeyState(f) }</p>
			</div>
			<div>
				@SettingsRow("Secret access key", "", "backup-secret") {
					@ui.Input(ui.InputProps{ID: "backup-secret", Name: "secret_access_key", Type: "password", Autocomplete: "new-password", Placeholder: secretPlaceholder(f), DescribedBy: "backup-secret-state"})
				}
				<p id="backup-secret-state" class="mt-1 text-xs text-foreground-secondary" data-testid="backup-secret-state">{ secretState(f) }</p>
			</div>
			if f.AccessKeySet || f.SecretSet {
				@ui.Checkbox(ui.CheckboxProps{ID: "backup-clear-creds", Name: "clear_credentials", Value: "true", Label: "Remove the stored keys (backups must be off)", Class: ""})
			}
			@SettingsRow("Nightly at", "", "backup-schedule-time") {
				@ui.Input(ui.InputProps{ID: "backup-schedule-time", Name: "schedule_time", Type: "time", Value: f.ScheduleTime})
			}
			@SettingsRow("Time zone", "", "backup-schedule-zone") {
				@ui.Input(ui.InputProps{ID: "backup-schedule-zone", Name: "schedule_zone", Value: f.ScheduleZone, Placeholder: "America/Chicago"})
			}
			@ui.Switch(ui.CheckboxProps{ID: "backup-schedule-off", Name: "schedule_off", Value: "true", Checked: f.ScheduleOff, Class: ""}) {
				No nightly schedule (run with <code>goforge backup run</code>)
			}
			@SettingsRow("Keep daily backups (days)", "", "backup-retention") {
				@ui.Input(ui.InputProps{ID: "backup-retention", Name: "retention_daily", Type: "number", Value: fmt.Sprint(f.RetentionDaily), Attrs: templ.Attributes{"min": "1", "max": "366"}})
			}
			@SettingsRow("Run timeout", "", "backup-timeout") {
				@ui.Input(ui.InputProps{ID: "backup-timeout", Name: "timeout", Value: f.Timeout, Placeholder: "2h"})
			}
		</div>
		@SettingsActions() {
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonSecondary,
				Attrs: templ.Attributes{
					"data-testid": "backup-test",
					"hx-post": "/settings/backups/test",
					"hx-include": "closest form",
					"hx-swap": "none",
					"hx-target": "this",
				},
			}) {
				Test connection
			}
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonPrimary,
				Type: "submit",
				Attrs: templ.Attributes{
					"data-testid": "backup-save",
				},
			}) {
				Save backup settings
				@components.Spinner()
			}
		}
	</form>
}
