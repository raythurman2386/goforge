package settings

import (
	"time"

	"github.com/raythurman2386/goforge/internal/backup"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

// Profile renders the profile page. backups is nil for non-admins, which
// hides the Backups card.
templ Profile(user *models.User, csrfToken string, backups *backup.Status) {
	@layouts.AppLayout("Profile Settings", csrfToken) {
		<div class="max-w-2xl mx-auto">
			@components.PageHeader("Profile Settings", "Manage your account information and security.")

			<!-- Profile Information -->
			<div class="card mb-8">
				<h3 class="card-title mb-4">Account Information</h3>
				<form hx-put="/settings/profile" hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
					<input type="hidden" name="csrf_token" value={ csrfToken } />
					
					<div class="mb-4">
						<label for="profile-email" class="label">Email Address</label>
						<input id="profile-email" type="email" name="email" value={ user.Email } class="input" required />
					</div>

					<div class="mb-4">
						<p class="label">Account Type</p>
						<div class="mt-1">
							if user.IsGitHubUser() {
								<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-900 text-white">
									<svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
										<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
									</svg>
									GitHub Account
								</span>
								<p class="mt-1 text-sm text-gray-500">Your account is linked to GitHub. Some settings may be managed through GitHub.</p>
							} else {
								<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-700 ring-1 ring-inset ring-primary-600/20">
									<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
									</svg>
									Local Account
								</span>
							}
						</div>
					</div>

					<div class="flex justify-end">
						<button type="submit" class="btn-primary">
							Save Changes
							@components.Spinner()
						</button>
					</div>
				</form>
			</div>

			<!-- Change Password (Local accounts only) -->
			if !user.IsGitHubUser() {
				<div class="card mb-8">
					<h3 class="card-title mb-4">Change Password</h3>
					<form hx-put="/settings/password" hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
						<input type="hidden" name="csrf_token" value={ csrfToken } />
						
						<div class="mb-4">
							<label for="current_password" class="label">Current Password</label>
							<input id="current_password" type="password" name="current_password" class="input" required />
						</div>

						<div class="mb-4">
							<label for="new_password" class="label">New Password</label>
							<input id="new_password" type="password" name="new_password" class="input" required minlength="8" />
						</div>

						<div class="mb-4">
							<label for="confirm_password" class="label">Confirm New Password</label>
							<input id="confirm_password" type="password" name="confirm_password" class="input" required minlength="8" />
						</div>

						<div class="flex justify-end">
							<button type="submit" class="btn-primary">
								Update Password
								@components.Spinner()
							</button>
						</div>
					</form>
				</div>
			}

			if backups != nil {
				@BackupCard(backups)
			}

			<!-- API Tokens -->
			<div class="card">
				<div class="flex items-center justify-between mb-4">
					<h3 class="card-title">API Tokens</h3>
					<button hx-get="/settings/tokens/new" hx-target="body" hx-swap="beforeend" class="btn-secondary btn-sm">
						<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						Generate Token
					</button>
				</div>
				<p class="text-sm text-gray-500 mb-4">API tokens allow programmatic access to your account. Keep them secure!</p>
				
				<div class="mb-4">
					@components.AlertMessage("warning", "Work in progress: API token authentication is planned for future releases. Currently tokens can be created for future use.")
				</div>

				<div id="tokens-list" hx-get="/settings/tokens" hx-trigger="load, tokenCreated from:body" hx-swap="innerHTML" class="divide-y divide-gray-100 animate-fade-in">
					@components.LoadingState("Loading tokens...")
				</div>
			</div>
		</div>
	}
}

templ APITokenRow(token *models.APIToken) {
	<div class="py-4 flex items-center justify-between hover:bg-gray-50 -mx-4 px-4" id={ "token-" + token.ID }>
		<div>
			<p class="text-sm font-medium text-gray-900">{ token.Name }</p>
			<p class="text-xs text-gray-500">
				Created { formatDate(token.CreatedAt) }
				if token.LastUsedAt.Valid {
					• Last used { formatDate(token.LastUsedAt.Time) }
				}
				if token.ExpiresAt.Valid {
					• Expires { formatDate(token.ExpiresAt.Time) }
				}
			</p>
			<p class="mt-1 flex flex-wrap gap-1">
				for _, scope := range tokenScopes(token) {
					<span class="inline-flex items-center rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">{ scope }</span>
				}
			</p>
		</div>
		<button 
			hx-delete={ "/settings/tokens/" + token.ID }
			hx-target="#tokens-list"
			hx-swap="innerHTML"
			hx-confirm="Are you sure you want to delete this token?"
			class="btn-danger btn-sm"
		>
			Delete
		</button>
	</div>
}

templ EmptyTokenList() {
	@components.EmptyState(components.EmptyStateProps{
		Title:       "No API tokens yet",
		Description: "Generate one to get started.",
		Compact:     true,
	})
}

templ TokenCreatedModal(rawToken string) {
	@components.Modal("API Token Created") {
		<div class="flex items-start gap-3 mb-6">
			<div class="h-10 w-10 flex-shrink-0 rounded-full bg-primary-100 flex items-center justify-center">
				<svg class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
			<div class="min-w-0 flex-1">
				<p class="text-sm text-gray-500">Copy this token now. You won't be able to see it again!</p>
				<code class="mt-3 block w-full rounded-lg bg-gray-100 p-3 text-sm font-mono break-all border border-gray-200">{ rawToken }</code>
			</div>
		</div>
		<div class="flex justify-end gap-3">
			<button type="button" data-modal-close class="btn-secondary">
				Close
			</button>
			<button type="button" onclick={ copyToken(rawToken) } class="btn-primary">
				Copy to Clipboard
			</button>
		</div>
	}
}

script copyToken(token string) {
	navigator.clipboard.writeText(token).then(function() {
		var btn = event.target;
		btn.innerText = 'Copied!';
		setTimeout(function() { btn.innerText = 'Copy to Clipboard'; }, 2000);
	});
}

templ AddAPITokenModal(csrfToken string) {
	@components.Modal("Generate API Token") {
		<form hx-post="/settings/tokens" hx-target="#modal" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			
			@components.Input("Token Name", "name", "text", "", true)
			<p class="text-xs text-gray-500 mb-4">Give your token a descriptive name to help you identify it later.</p>

			<div class="mb-4">
				<label for="expires_in" class="label">Expires</label>
				<select id="expires_in" name="expires_in" class="select">
					<option value="30">30 days</option>
					<option value="90">90 days</option>
					<option value="365" selected>1 year</option>
					<option value="0">Never</option>
				</select>
			</div>

			<fieldset class="mb-4">
				<legend class="label">Scopes</legend>
				<p class="text-xs text-gray-500 mb-2">Leave all unchecked for a full token that also works on the web routes. A scoped token works only on <code>/api/v1</code>.</p>
				<label class="flex items-center gap-2 text-sm text-gray-700">
					<input type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" name="scopes" value="read"/>
					read: list and inspect projects, services, containers, logs
				</label>
				<label class="flex items-center gap-2 text-sm text-gray-700">
					<input type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" name="scopes" value="write"/>
					write: gated deploys, restarts, env vars, service changes
				</label>
				<label class="flex items-center gap-2 text-sm text-gray-700">
					<input type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" name="scopes" value="protected"/>
					protected: stop, reconfigure, or re-image protected services
				</label>
			</fieldset>

			<div class="mt-8 flex justify-end space-x-3">
				<button type="button" data-modal-close class="btn-secondary">
					Cancel
				</button>
				@components.Button("Generate Token", "primary")
			</div>
		</form>
	}
}

// tokenScopes returns the scopes shown on a token row.
func tokenScopes(token *models.APIToken) []string {
	if len(token.Scopes) == 0 {
		return []string{models.ScopeFull}
	}
	return token.Scopes
}

func formatDate(t time.Time) string {
	return t.Format("Jan 2, 2006")
}

// BackupCard is the admin-only "Last backup" line. Read-only: v1 has no
// run-now button; use `goforge backup run`.
templ BackupCard(st *backup.Status) {
	<div class="card mb-8" id="backup-status">
		<h3 class="card-title mb-2">Backups</h3>
		if !st.Enabled {
			<p class="text-sm text-gray-500">
				Backups are off. Set <code>BACKUP_S3_BUCKET</code> and the other <code>BACKUP_*</code> settings to turn on nightly backups.
			</p>
		} else {
			<p class={ "text-sm", backupLineClass(st) } data-testid="backup-last">
				{ backupLastLine(st) }
			</p>
			if st.LastRun != nil && st.LastRun.Status == statusFailed && st.LastRun.ErrorSummary != "" {
				<p class="mt-1 text-xs text-red-700 break-words">{ st.LastRun.ErrorSummary }</p>
			}
			<p class="mt-2 text-xs text-gray-500">
				{ backupScheduleLine(st) }
			</p>
		}
	</div>
}
