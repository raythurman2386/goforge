package containers

import (
	"strings"

	"github.com/moby/moby/api/types/container"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

templ List(csrfToken string) {
	@layouts.AppLayout("Containers", csrfToken) {
		@components.PageHeader("Containers", "Containers that GoForge runs for your projects and services.")
		<div class="card !p-0 overflow-hidden">
			<div class="overflow-x-auto">
				<table class="min-w-full table-fixed divide-y divide-gray-100 dark:divide-gray-800">
					<colgroup>
						<col class="w-[28%]"/>
						<col class="w-[32%]"/>
						<col class="w-28"/>
						<col class="w-28"/>
						<col class="w-32"/>
					</colgroup>
					<thead class="bg-gray-50/60 dark:bg-gray-800/50">
						<tr>
							<th scope="col" class="table-th pl-6">Name</th>
							<th scope="col" class="table-th">Image</th>
							<th scope="col" class="table-th">Status</th>
							<th scope="col" class="table-th">Type</th>
							<th scope="col" class="table-th pr-6 text-right">
								<span class="sr-only">Actions</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100 bg-white dark:divide-gray-800 dark:bg-gray-900" id="container-list-body" hx-get="/containers/api" hx-trigger="load, containerStopped from:body, containerRestarted from:body" hx-swap="innerHTML">
						<tr>
							<td colspan="5">
								@components.LoadingState("Loading containers...")
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ ListAPI(trackedContainers []*models.Container, dockerContainers []container.Summary) {
	if len(dockerContainers) == 0 {
		<tr>
			<td colspan="5">
				@components.EmptyState(components.EmptyStateProps{
					Title:       "No containers yet",
					Description: "Deploy a project or a service and its containers show up here.",
					Icon:        "server",
					Compact:     true,
				})
			</td>
		</tr>
	}
	for _, dc := range dockerContainers {
		@ContainerRow(dc, trackedContainers)
	}
}

templ ContainerRow(dc container.Summary, tracked []*models.Container) {
	<tr class="hover:bg-gray-50/60 transition-colors dark:hover:bg-gray-800/50">
		<td class="table-td pl-6 font-medium text-gray-900 dark:text-gray-100">
			<a href={ templ.URL("/containers/" + dc.ID) } class="block truncate hover:text-primary-700 dark:hover:text-primary-300" title={ containerName(dc) }>
				{ containerName(dc) }
			</a>
		</td>
		<td class="table-td">
			<span class="block truncate font-mono text-xs text-gray-600 dark:text-gray-400" title={ dc.Image }>{ dc.Image }</span>
		</td>
		<td class="table-td">
			@components.StatusBadge("container", string(dc.State))
		</td>
		<td class="table-td text-gray-600 dark:text-gray-400">
			{ containerType(dc, tracked) }
		</td>
		<td class="table-td pr-6">
			<div class="flex items-center justify-end gap-1">
				if dc.State == "running" {
					<button
						type="button"
						hx-post={ "/containers/" + dc.ID + "/stop" }
						hx-confirm="Are you sure you want to stop this container?"
						hx-disabled-elt="this"
						class="icon-btn hover:text-amber-700 hover:bg-amber-50 dark:hover:text-amber-300 dark:hover:bg-amber-950/40"
						title="Stop"
						aria-label={ "Stop " + containerName(dc) }
					>
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<rect x="6" y="6" width="12" height="12" rx="1.5" stroke-width="2"></rect>
						</svg>
					</button>
					<button
						type="button"
						hx-post={ "/containers/" + dc.ID + "/restart" }
						hx-confirm="Are you sure you want to restart this container?"
						hx-disabled-elt="this"
						class="icon-btn hover:text-primary-700 hover:bg-primary-50 dark:hover:text-primary-300 dark:hover:bg-primary-900/30"
						title="Restart"
						aria-label={ "Restart " + containerName(dc) }
					>
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
					</button>
				}
				<a href={ templ.URL("/containers/" + dc.ID) } class="icon-btn hover:text-gray-900 hover:bg-gray-100 dark:hover:text-gray-100 dark:hover:bg-gray-800" title="View" aria-label={ "View " + containerName(dc) }>
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
					</svg>
				</a>
			</div>
		</td>
	</tr>
}

// containerName is the Docker name without the leading slash.
func containerName(dc container.Summary) string {
	if len(dc.Names) == 0 {
		return truncateID(dc.ID)
	}
	return strings.TrimPrefix(dc.Names[0], "/")
}

func containerType(dc container.Summary, tracked []*models.Container) string {
	for _, tc := range tracked {
		if tc.DockerID == dc.ID {
			if tc.DeploymentID.Valid {
				return "Deployment"
			}
			if tc.ServiceInstanceID.Valid {
				return "Service"
			}
		}
	}
	return "External"
}
