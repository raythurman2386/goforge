package containers

import (
	"github.com/docker/docker/api/types"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

templ List(csrfToken string) {
	@layouts.AppLayout("Containers", csrfToken) {
		<div class="px-4 sm:px-6 lg:px-8">
			<div class="sm:flex sm:items-center">
				<div class="sm:flex-auto">
					<h1 class="text-xl font-semibold text-gray-900">Containers</h1>
					<p class="mt-2 text-sm text-gray-700">
						A list of all containers managed by GoForge across all projects and services.
					</p>
				</div>
			</div>
			<div class="mt-8 flex flex-col">
				<div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
					<div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
						<div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
							<table class="min-w-full divide-y divide-gray-300">
								<thead class="bg-gray-50">
									<tr>
										<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Name</th>
										<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Image</th>
										<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
										<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Type</th>
										<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
											<span class="sr-only">Actions</span>
										</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200 bg-white" id="container-list-body">
									<tr>
										<td colspan="5" class="py-8 text-center text-gray-500">
											<div hx-get="/api/containers" hx-trigger="load" hx-swap="innerHTML">
												<svg class="animate-spin h-5 w-5 mx-auto text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
													<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
													<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
												</svg>
												<p class="mt-2 text-sm">Loading containers...</p>
											</div>
										</td>
									</tr>
								</tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
	}
}

templ ListAPI(trackedContainers []*models.Container, dockerContainers []types.Container) {
	for _, dc := range dockerContainers {
		@ContainerRow(dc, trackedContainers)
	}
}

templ ContainerRow(dc types.Container, tracked []*models.Container) {
	<tr>
		<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
			<a href={ templ.URL("/containers/" + dc.ID) } class="hover:text-indigo-600">
				{ dc.Names[0] }
			</a>
		</td>
		<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
			{ dc.Image }
		</td>
		<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
<span class={ "inline-flex items-center rounded-full px-2 py-1 text-xs font-medium " + statusClass(dc.State) }>
				{ dc.State }
            </span>
		</td>
		<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
			{{ containerType(dc, tracked) }}
		</td>
		<td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
			<div class="flex justify-end space-x-2">
				if dc.State == "running" {
					<button
						hx-post={ templ.URL("/containers/" + dc.ID + "/stop") }
						hx-confirm="Are you sure you want to stop this container?"
						class="text-gray-600 hover:text-gray-900"
						title="Stop">
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 9 0 11-9 9-9-9-9-9-9v-9a1 1 0 00-1-1v-3.5a1 1 0 001 1 1.5V18a1 1 0 001-1V6a1 1 0 00-1-1V3.5a1 1 0 01-1.414-1.414L4 12a1 1 0 010-1.414z"></path>
						</svg>
					</button>
					<button
						hx-post={ templ.URL("/containers/" + dc.ID + "/restart") }
						hx-confirm="Are you sure you want to restart this container?"
						class="text-gray-600 hover:text-gray-900 ml-2"
						title="Restart">
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.706 0A1.523 1.523 0 004 4v5z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.706 0A1.523 1.523 0 004 4v5zM15 15l5 5m0-5l-5 5"></path>
						</svg>
					</button>
				}
				<a href={ templ.URL("/containers/" + dc.ID) } class="text-gray-600 hover:text-gray-900 ml-2" title="View">
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
					</svg>
				</a>
			</div>
		</td>
	</tr>
}

func containerType(dc types.Container, tracked []*models.Container) string {
	for _, tc := range tracked {
		if tc.DockerID == dc.ID {
			if tc.DeploymentID.Valid {
				return "Deployment"
			}
			if tc.ServiceInstanceID.Valid {
				return "Service"
			}
		}
	}
	return "External"
}

func statusClass(state string) string {
	switch state {
	case "running":
		return "bg-green-100 text-green-800"
	case "exited", "dead":
		return "bg-red-100 text-red-800"
	case "paused":
		return "bg-yellow-100 text-yellow-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}
