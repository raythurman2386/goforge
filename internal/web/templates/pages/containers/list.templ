package containers

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"strings"

	"github.com/moby/moby/api/types/container"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

templ List(csrfToken string) {
	@layouts.AppLayout("Containers", csrfToken) {
		@components.PageHeader("Containers", "Containers that GoForge runs for your projects and services.")
		@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
			@ui.Table(ui.TableProps{ID: "container-list", Caption: "Containers", Fixed: true}) {
				<colgroup>
					<col class="w-[28%]"/>
					<col class="w-[32%]"/>
					<col class="w-28"/>
					<col class="w-28"/>
					<col class="w-32"/>
				</colgroup>
				@ui.THead(nil) {
					@ui.TR(nil) {
						@ui.TH(ui.CellProps{Class: "pl-6"}) { Name }
						@ui.TH(ui.CellProps{}) { Image }
						@ui.TH(ui.CellProps{}) { Status }
						@ui.TH(ui.CellProps{}) { Type }
						@ui.TH(ui.CellProps{Align: ui.CellEnd, Class: "pr-6"}) {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@ui.TBody(templ.Attributes{"id": "container-list-body", "hx-get": "/containers/api", "hx-trigger": "load, containerStopped from:body, containerRestarted from:body", "hx-swap": "innerHTML"}) {
					@ui.TableEmpty(5) {
						@components.LoadingState("Loading containers...")
					}
				}
			}
		}
	}
}

templ ListAPI(trackedContainers []*models.Container, dockerContainers []container.Summary) {
	if len(dockerContainers) == 0 {
		@ui.TableEmpty(5) {
			@components.EmptyState(components.EmptyStateProps{
				Title:       "No containers yet",
				Description: "Deploy a project or a service and its containers show up here.",
				Icon:        "server",
				Compact:     true,
			})
		}
	}
	for _, dc := range dockerContainers {
		@ContainerRow(dc, trackedContainers)
	}
}

templ ContainerRow(dc container.Summary, tracked []*models.Container) {
	@ui.TR(templ.Attributes{"class": "hover:bg-muted/60 transition-colors"}) {
		@ui.TD(ui.CellProps{Class: "pl-6 font-medium text-foreground"}) {
			<a href={ templ.URL("/containers/" + dc.ID) } class="block truncate hover:text-primary-700 dark:hover:text-primary-300" { ui.TooltipAttrs(tipID(dc, "name"))... }>
				{ containerName(dc) }
			</a>
			@ui.Tooltip(ui.TooltipProps{ID: tipID(dc, "name"), Text: containerName(dc), Align: ui.AlignStart})
		}
		@ui.TD(ui.CellProps{}) {
			<span tabindex="0" class="block truncate rounded font-mono text-xs text-foreground-secondary" { ui.TooltipAttrs(tipID(dc, "image"))... }>{ dc.Image }</span>
			@ui.Tooltip(ui.TooltipProps{ID: tipID(dc, "image"), Text: dc.Image, Align: ui.AlignStart, Class: "break-all font-mono"})
		}
		@ui.TD(ui.CellProps{}) {
			@components.StatusBadge("container", string(dc.State))
		}
		@ui.TD(ui.CellProps{Class: "text-foreground-secondary"}) {
			{ containerType(dc, tracked) }
		}
		@ui.TD(ui.CellProps{Class: "pr-6"}) {
			<div class="flex items-center justify-end gap-1">
				if dc.State == "running" {
					@ui.Button(ui.ButtonProps{
						Variant: ui.ButtonGhostWarning,
						Size: ui.ButtonIcon,
						Label: "Stop " + containerName(dc),
						Attrs: ui.Attrs(ui.TooltipAttrs(tipID(dc, "stop")), templ.Attributes{
							"hx-post": "/containers/" + dc.ID + "/stop",
							"hx-confirm": "Are you sure you want to stop this container?",
							"data-ui-confirm-tone": "danger",
							"data-ui-confirm-label": "Stop",
							"hx-disabled-elt": "this",
						}),
					}) {
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<rect x="6" y="6" width="12" height="12" rx="1.5" stroke-width="2"></rect>
						</svg>
					}
					@ui.Tooltip(ui.TooltipProps{ID: tipID(dc, "stop"), Text: "Stop"})
					@ui.Button(ui.ButtonProps{
						Variant: ui.ButtonGhostPrimary,
						Size: ui.ButtonIcon,
						Label: "Restart " + containerName(dc),
						Attrs: ui.Attrs(ui.TooltipAttrs(tipID(dc, "restart")), templ.Attributes{
							"hx-post": "/containers/" + dc.ID + "/restart",
							"hx-confirm": "Are you sure you want to restart this container?",
							"data-ui-confirm-label": "Restart",
							"hx-disabled-elt": "this",
						}),
					}) {
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
					}
					@ui.Tooltip(ui.TooltipProps{ID: tipID(dc, "restart"), Text: "Restart"})
				}
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonGhost,
					Size: ui.ButtonIcon,
					Href: templ.URL("/containers/" + dc.ID),
					Label: "View " + containerName(dc),
					Attrs: ui.TooltipAttrs(tipID(dc, "view")),
				}) {
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
					</svg>
				}
				@ui.Tooltip(ui.TooltipProps{ID: tipID(dc, "view"), Text: "View"})
			</div>
		}
	}
}

// tipID is the id of one row tooltip: unique per container and field.
func tipID(dc container.Summary, field string) string {
	return "tip-" + field + "-" + dc.ID
}

// containerName is the Docker name without the leading slash.
func containerName(dc container.Summary) string {
	if len(dc.Names) == 0 {
		return truncateID(dc.ID)
	}
	return strings.TrimPrefix(dc.Names[0], "/")
}

func containerType(dc container.Summary, tracked []*models.Container) string {
	for _, tc := range tracked {
		if tc.DockerID == dc.ID {
			if tc.DeploymentID.Valid {
				return "Deployment"
			}
			if tc.ServiceInstanceID.Valid {
				return "Service"
			}
		}
	}
	return "External"
}
