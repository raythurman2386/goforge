package containers

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"

	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

templ Detail(containerID string, csrfToken string) {
	@layouts.AppLayout(fmt.Sprintf("Container %s", truncateID(containerID)), csrfToken) {
		@ui.Breadcrumb([]ui.Crumb{
			{Label: "Containers", Href: "/containers"},
			{Label: truncateID(containerID)},
		})
		@components.PageHeaderWithBadge("Container "+truncateID(containerID), "", containerStatus()) {
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonSecondary,
				Attrs: templ.Attributes{
					"id": "restart-btn",
					"hx-post": fmt.Sprintf("/containers/%s/restart", containerID),
					"hx-confirm": "Are you sure you want to restart this container?",
					"data-ui-confirm-label": "Restart",
					"hx-disabled-elt": "this",
					"hx-indicator": "find .htmx-indicator",
				},
			}) {
				<svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
				</svg>
				Restart
				@components.Spinner()
			}
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonWarning,
				Attrs: templ.Attributes{
					"id": "stop-btn",
					"hx-post": fmt.Sprintf("/containers/%s/stop", containerID),
					"hx-confirm": "Are you sure you want to stop this container?",
					"data-ui-confirm-tone": "danger",
					"data-ui-confirm-label": "Stop",
					"hx-disabled-elt": "this",
					"hx-indicator": "find .htmx-indicator",
				},
			}) {
				<svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<rect x="6" y="6" width="12" height="12" rx="1.5" stroke-width="2"></rect>
				</svg>
				Stop
				@components.Spinner()
			}
		}

		<!-- Stats Card -->
		@ui.Card(ui.CardProps{Flush: true, Class: "mb-6"}) {
			@ui.CardHeader(nil) {
				@ui.CardTitle(3, nil) {
					Resource Usage
				}
			}
			@ui.CardContent(templ.Attributes{"id": "container-stats", "hx-ext": "sse", "sse-connect": fmt.Sprintf("/containers/%s/stats", containerID), "sse-swap": "stats,unavailable"}) {
				@components.LoadingState("Waiting for stats...")
			}
		}

		<!-- Container Logs -->
		@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
			@ui.CardHeader(nil) {
				@ui.CardTitle(3, nil) {
					Container Logs
				}
				<span class="inline-flex items-center gap-2 text-sm text-foreground-secondary">
					<span class="h-2 w-2 rounded-full bg-success animate-pulse" aria-hidden="true"></span>
					Live
				</span>
			}
			<div
				id="container-logs"
				class="bg-terminal text-foreground font-mono text-sm p-4 max-h-96 overflow-y-auto"
				hx-ext="sse"
				sse-connect={ fmt.Sprintf("/containers/%s/logs", containerID) }
				sse-swap="log"
				hx-swap="beforeend"
			>
				<p class="text-foreground-secondary italic">Waiting for logs...</p>
			</div>
		}

		<!-- Status badges app.js swaps into #container-status on the containerStopped and containerRestarted HX-Trigger events -->
		<template id="container-status-exited">
			@components.StatusBadge("container", "exited")
		</template>
		<template id="container-status-running">
			@components.StatusBadge("container", "running")
		</template>
	}
}

templ containerStatus() {
	<span id="container-status">
		@components.StatusBadge("container", "unknown")
	</span>
}

func truncateID(id string) string {
	if len(id) > 12 {
		return id[:12]
	}
	return id
}
