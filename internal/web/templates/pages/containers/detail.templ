package containers

import (
	"fmt"

	"github.com/raythurman2386/goforge/internal/web/templates/components"
	"github.com/raythurman2386/goforge/internal/web/templates/layouts"
)

templ Detail(containerID string, csrfToken string) {
	@layouts.AppLayout(fmt.Sprintf("Container %s", truncateID(containerID)), csrfToken) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Containers", Href: "/containers"},
			{Label: truncateID(containerID)},
		})
		@components.PageHeaderWithBadge("Container "+truncateID(containerID), "", containerStatus()) {
			<button
				id="restart-btn"
				type="button"
				hx-post={ fmt.Sprintf("/containers/%s/restart", containerID) }
				hx-confirm="Are you sure you want to restart this container?"
				hx-disabled-elt="this"
				hx-indicator="find .htmx-indicator"
				class="btn-secondary"
			>
				<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
				</svg>
				Restart
				@components.Spinner()
			</button>
			<button
				id="stop-btn"
				type="button"
				hx-post={ fmt.Sprintf("/containers/%s/stop", containerID) }
				hx-confirm="Are you sure you want to stop this container?"
				hx-disabled-elt="this"
				hx-indicator="find .htmx-indicator"
				class="btn-warning"
			>
				<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<rect x="6" y="6" width="12" height="12" rx="1.5" stroke-width="2"></rect>
				</svg>
				Stop
				@components.Spinner()
			</button>
		}

		<!-- Stats Card -->
		<div class="card !p-0 mb-6">
			<div class="card-header">
				<h3 class="card-title">Resource Usage</h3>
			</div>
			<div id="container-stats" class="card-body" hx-ext="sse" sse-connect={ fmt.Sprintf("/containers/%s/stats", containerID) } sse-swap="stats">
				@components.LoadingState("Waiting for stats...")
			</div>
		</div>

		<!-- Container Logs -->
		<div class="card !p-0 overflow-hidden">
			<div class="card-header">
				<h3 class="card-title">Container Logs</h3>
				<span class="inline-flex items-center gap-2 text-sm text-gray-500">
					<span class="h-2 w-2 rounded-full bg-green-400 animate-pulse" aria-hidden="true"></span>
					Live
				</span>
			</div>
			<div
				id="container-logs"
				class="bg-gray-900 text-gray-100 font-mono text-sm p-4 max-h-96 overflow-y-auto"
				hx-ext="sse"
				sse-connect={ fmt.Sprintf("/containers/%s/logs", containerID) }
				sse-swap="log"
				hx-swap="beforeend"
			>
				<p class="text-gray-500 italic">Waiting for logs...</p>
			</div>
		</div>

		<!-- Status badges swapped in by the script below on HX-Trigger events -->
		<template id="container-status-exited">
			@components.StatusBadge("container", "exited")
		</template>
		<template id="container-status-running">
			@components.StatusBadge("container", "running")
		</template>
	}

	<script>
		(function () {
			function setStatus(state) {
				var el = document.getElementById('container-status');
				var tpl = document.getElementById('container-status-' + state);
				if (el && tpl) el.innerHTML = tpl.innerHTML;
			}
			document.body.addEventListener('containerStopped', function () { setStatus('exited'); });
			document.body.addEventListener('containerRestarted', function () { setStatus('running'); });
		})();
	</script>
}

templ containerStatus() {
	<span id="container-status">
		@components.StatusBadge("container", "unknown")
	</span>
}

func truncateID(id string) string {
	if len(id) > 12 {
		return id[:12]
	}
	return id
}
