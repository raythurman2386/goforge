package ui

// Alert is an inline notice box. Children are the description.
//
//	@ui.Alert(ui.AlertProps{Tone: ui.AlertWarning, Title: "Heads up"}) {
//		<p>Saving recreates the container.</p>
//	}
templ Alert(p AlertProps) {
	<div { alertAttrs(p)... }>
		<svg class={ Class("h-5 w-5 flex-shrink-0", alertIconClass(p.Tone)) } viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
			switch p.Tone {
				case AlertError:
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
				case AlertWarning:
					<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
				case AlertSuccess:
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
				default:
					<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			}
		</svg>
		<div class="min-w-0 flex-1">
			if p.Title != "" {
				<p class="font-semibold">{ p.Title }</p>
				<div class="mt-1">
					{ children... }
				</div>
			} else {
				{ children... }
			}
		</div>
		if p.Dismissible {
			<button type="button" data-ui-dismiss class="-m-1.5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-ui opacity-70 hover:opacity-100 ui-focus-ring md:h-8 md:w-8" aria-label="Dismiss">
				<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"></path>
				</svg>
			</button>
		}
	</div>
}

// AlertMessage is an Alert with one line of text. Handlers use it for
// htmx error fragments.
templ AlertMessage(tone AlertTone, message string) {
	@Alert(AlertProps{Tone: tone}) {
		<p class="font-medium">{ message }</p>
	}
}
