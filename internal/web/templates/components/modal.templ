package components

templ Modal(title string) {
	<div id="modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black bg-opacity-50">
		<div class="bg-white rounded-lg shadow-xl max-w-lg w-full" hx-on::after-request="if(event.detail.successful) this.remove()">
			<div class="flex justify-between items-center px-6 py-4 border-b">
				<h3 class="text-lg font-medium text-gray-900">{ title }</h3>
				<button onclick="document.getElementById('modal').remove()" class="text-gray-400 hover:text-gray-500">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<div class="px-6 py-4">
				{ children... }
			</div>
		</div>
	</div>
}
