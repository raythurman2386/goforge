package components

import (
	"fmt"
	"time"

	"github.com/raythurman2386/goforge/internal/models"
)

// DeploymentProgressID is the detail page's out-of-band stage update target.
const DeploymentProgressID = "deployment-progress"

// DeploymentProgress reports only state and time present in the deployment
// model. It intentionally has no percentage or estimated completion.
templ DeploymentProgress(deployment *models.Deployment) {
	<div class="text-sm text-foreground" data-deployment-stage={ string(deployment.Status) }>
		<span class="font-medium">Stage: <span class="font-bold">{ string(deployment.Status) }</span></span>
		if label, elapsed, ok := deploymentElapsed(deployment); ok {
			<span class="ml-2 text-foreground-secondary">{ label }: { formatDeploymentElapsed(elapsed) }</span>
		}
		if deployment.Status == models.DeploymentStatusFailed && deployment.ErrorMessage.Valid && deployment.ErrorMessage.String != "" {
			<p class="mt-2 text-danger" role="alert">{ deployment.ErrorMessage.String }</p>
		}
	</div>
}

func deploymentElapsed(deployment *models.Deployment) (string, time.Duration, bool) {
	if deployment.StartedAt.Valid {
		return "Elapsed", nonnegativeDuration(deployment.Duration()), true
	}
	if deployment.Status == models.DeploymentStatusPending && !deployment.CreatedAt.IsZero() {
		return "Waiting", nonnegativeDuration(time.Since(deployment.CreatedAt)), true
	}
	return "", 0, false
}

func nonnegativeDuration(duration time.Duration) time.Duration {
	if duration < 0 {
		return 0
	}
	return duration
}

func formatDeploymentElapsed(duration time.Duration) string {
	seconds := int(duration / time.Second)
	if seconds < 60 {
		return fmt.Sprintf("%ds", seconds)
	}
	if seconds < 3600 {
		return fmt.Sprintf("%dm %ds", seconds/60, seconds%60)
	}
	return fmt.Sprintf("%dh %dm", seconds/3600, (seconds/60)%60)
}
