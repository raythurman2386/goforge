package components

import "github.com/raythurman2386/goforge/internal/web/templates/components/ui"

// ActivityTable lists audit rows newest first. Failed rows are tinted red and
// show their error. compact drops the approval and error columns (dashboard).
templ ActivityTable(id string, rows []ActivityRow, compact bool) {
	@ui.Table(ui.TableProps{ID: id, Caption: "Activity"}) {
		@ui.THead(nil) {
			@ui.TR(nil) {
				@ui.TH(ui.CellProps{Class: "pl-6"}) { Time }
				@ui.TH(ui.CellProps{}) { Source }
				@ui.TH(ui.CellProps{}) { Action }
				@ui.TH(ui.CellProps{}) { Token }
				@ui.TH(ui.CellProps{}) { Resource }
				if !compact {
					@ui.TH(ui.CellProps{}) { Approval }
					@ui.TH(ui.CellProps{Class: "pr-6"}) { Error }
				}
			}
		}
		@ui.TBody(nil) {
			if len(rows) == 0 {
				@ui.TableEmpty(activityColumns(compact)) {
					@EmptyState(EmptyStateProps{
						Title:       "No activity yet",
						Description: "Changes made in the UI, through the API, or by an MCP agent show up here.",
						Icon:        "server",
						Compact:     true,
					})
				}
			}
			for _, r := range rows {
				@ui.TR(templ.Attributes{"class": activityRowClass(r), "data-activity-id": r.ID, "data-failed": boolAttr(r.Failed)}) {
					@ui.TD(ui.CellProps{Class: "pl-6 whitespace-nowrap text-foreground-secondary"}) {
						<time datetime={ r.When.UTC().Format("2006-01-02T15:04:05Z") }>{ activityTime(r.When) }</time>
					}
					@ui.TD(ui.CellProps{}) {
						@ui.Badge(ui.BadgeProps{Tone: activitySourceTone(r.Source)}) {
							{ activitySourceLabel(r.Source) }
						}
					}
					@ui.TD(ui.CellProps{Class: "font-mono text-xs"}) {
						<a href={ r.RelatedURL } class="hover:text-primary-700 dark:hover:text-primary-300">{ r.Action }</a>
						if r.Failed {
							@ui.Badge(ui.BadgeProps{Tone: ui.BadgeDanger, Class: "ml-2"}) { failed }
						}
					}
					@ui.TD(ui.CellProps{Class: "text-foreground-secondary"}) {
						{ r.TokenName }
					}
					@ui.TD(ui.CellProps{}) {
						if r.ResourceURL != "" {
							<a href={ r.ResourceURL } class="text-primary-700 hover:underline dark:text-primary-300">{ r.Resource }</a>
						} else {
							<span class="text-foreground-secondary">{ r.Resource }</span>
						}
					}
					if !compact {
						@ui.TD(ui.CellProps{Class: "font-mono text-xs text-foreground-secondary"}) {
							{ r.ApprovalRef }
						}
						@ui.TD(ui.CellProps{Class: "pr-6 text-xs text-danger break-words"}) {
							{ r.Error }
						}
					}
				}
			}
		}
	}
}

// ActivityCard is the dashboard's recent agent actions card: the latest
// MCP and API changes, with a link to the full activity page. It is the kit's
// Flush card in both states: CardHeader holds the title block on the left and
// one ghost "View all" action on the right, then the body is the compact
// table (rows) or a compact EmptyState in CardContent (none). The empty card
// has no table chrome, and its header action goes to all activity, since the
// agent-only view would be empty too (t1683u, t1695u).
templ ActivityCard(rows []ActivityRow) {
	@ui.Card(ui.CardProps{Flush: true, Class: "mt-8 overflow-hidden", Attrs: templ.Attributes{"id": "recent-agent-actions"}}) {
		@ui.CardHeader(nil) {
			<div class="min-w-0">
				@ui.CardTitle(2, nil) { Recent agent actions }
				@ui.CardDescription(nil) { Changes made through the API or by an MCP agent. }
			</div>
			if len(rows) > 0 {
				@activityViewAll("/settings/activity?source=agent", "View all")
			} else {
				@activityViewAll("/settings/activity", "View all activity")
			}
		}
		if len(rows) == 0 {
			@ui.CardContent(templ.Attributes{"data-testid": "recent-agent-actions-empty"}) {
				@EmptyState(EmptyStateProps{
					Title:       "No recent agent actions",
					Description: "Changes from API tokens and MCP agents appear here.",
					Icon:        "server",
					Compact:     true,
				})
			}
		} else {
			@ActivityTable("recent-agent-actions-table", rows, true)
		}
	}
}

// activityViewAll is the card header's one action: a small ghost link with a
// trailing arrow, the same in both card states.
templ activityViewAll(href templ.SafeURL, label string) {
	@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, Size: ui.ButtonSM, Href: href, Attrs: templ.Attributes{"data-testid": "recent-agent-actions-view-all"}}) {
		{ label }
		<svg class="ml-1.5 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
		</svg>
	}
}
