package components

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"github.com/raythurman2386/goforge/internal/models"
)

// EnvironmentMenuID is the id of the project environment menu; its trigger
// is ui.TriggerID(EnvironmentMenuID).
const EnvironmentMenuID = "env-menu"

// EnvironmentSwitcher is the project header's environment menu on
// ui.Dropdown: a menu button (aria-haspopup="menu", aria-expanded kept in
// sync by ui.js) and a role="menu" popover with one link per environment
// and a "New Environment" item that opens the create dialog. It sits in the
// page header, outside the polled deployment banner.
templ EnvironmentSwitcher(projectID string, envs []*models.Environment, currentEnvID string) {
	<div class="inline-block text-left">
		@ui.DropdownTrigger(ui.DropdownProps{
			ID:      EnvironmentMenuID,
			Variant: ui.ButtonSecondary,
			Class:   "!py-1.5 !px-3 font-bold flex items-center shadow-sm",
			Attrs:   templ.Attributes{"aria-label": "Environment: " + currentEnvName(envs, currentEnvID)},
		}) {
			<span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse" aria-hidden="true"></span>
			{ currentEnvName(envs, currentEnvID) }
			<svg class="-mr-1 ml-2 h-4 w-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
			</svg>
		}
		@ui.DropdownMenu(ui.DropdownProps{ID: EnvironmentMenuID}) {
			for _, e := range envs {
				@ui.DropdownItem(ui.DropdownItemProps{
					Href:  templ.URL("/projects/" + projectID + "?env=" + e.ID),
					Attrs: envItemAttrs(e.ID == currentEnvID || (currentEnvID == "" && e == envs[0])),
				}) {
					{ e.Name }
				}
			}
			if len(envs) > 0 {
				@ui.DropdownSeparator()
			}
			@ui.DropdownItem(ui.DropdownItemProps{
				Tone:  ui.ItemPrimary,
				Attrs: ui.OpenDialogAttrs("/projects/" + projectID + "/envs/new"),
			}) {
				<span class="mr-1" aria-hidden="true">+</span> New Environment
			}
		}
	</div>
}

templ CreateEnvironmentModal(projectID string, csrfToken string) {
	@ui.Dialog(ui.DialogProps{Title: "Create New Environment"}) {
		<form hx-post={ "/projects/" + projectID + "/envs" } hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			@ui.Input(ui.InputProps{ID: "environment-name", Name: "name", Label: "Environment Name", Autocomplete: "off", Required: true, Class: "mb-4"})
			<p class="text-xs text-muted-foreground mb-4">Examples: staging, qa, feature-x</p>
			
			<div class="mt-8 flex justify-end space-x-3">
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonSecondary,
					Attrs: templ.Attributes{
						"data-ui-dialog-close": true,
					},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
					Create
					@Spinner()
				}
			</div>
		</form>
	}
}
