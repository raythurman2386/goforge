package components

import (
	"github.com/raythurman2386/goforge/internal/models"
)

templ EnvironmentSwitcher(projectID string, envs []*models.Environment, currentEnvID string) {
	<div class="relative inline-block text-left" onclick="event.stopPropagation()">
		<div>
			<button type="button" class="btn-secondary !py-1.5 !px-3 font-bold flex items-center shadow-sm" id="menu-button" aria-expanded="true" aria-haspopup="true" onclick="var dd = this.nextElementSibling; dd.classList.toggle('hidden'); if (!dd.classList.contains('hidden')) { var close = function(e) { if (!dd.contains(e.target) && e.target !== this) { dd.classList.add('hidden'); document.removeEventListener('click', close); } }.bind(this); document.addEventListener('click', close); }">
				<div class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></div>
				for _, e := range envs {
					if e.ID == currentEnvID {
						{ e.Name }
					}
				}
				if currentEnvID == "" && len(envs) > 0 {
					{ envs[0].Name }
				} else if len(envs) == 0 {
					No Environments
				}
				<svg class="-mr-1 ml-2 h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
				</svg>
			</button>
		</div>

		<div class="hidden origin-top-right absolute left-0 mt-2 w-56 rounded-xl shadow-xl bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-10 border border-gray-100 p-1.5" role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1">
			<div class="py-1" role="none">
				for _, e := range envs {
					<a href={ templ.URL("/projects/" + projectID + "?env=" + e.ID) } class="text-gray-700 block px-3 py-2 text-sm font-medium hover:bg-primary-50 hover:text-primary-700 rounded-lg transition-colors" role="menuitem" tabindex="-1">
						{ e.Name }
					</a>
				}
				<div class="my-1.5 border-t border-gray-100"></div>
				<button hx-get={ "/projects/" + projectID + "/envs/new" } hx-target="body" hx-swap="beforeend" class="text-primary-600 block w-full text-left px-3 py-2 text-sm font-bold hover:bg-primary-600 hover:text-white rounded-lg transition-colors" role="menuitem" tabindex="-1">
					<span class="mr-1">+</span> New Environment
				</button>
			</div>
		</div>
	</div>
}

templ CreateEnvironmentModal(projectID string, csrfToken string) {
	@Modal("Create New Environment") {
		<form hx-post={ "/projects/" + projectID + "/envs" } hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			@Input("Environment Name", "name", "text", "", true)
			<p class="text-xs text-gray-500 mb-4">Examples: staging, qa, feature-x</p>
			
			<div class="mt-8 flex justify-end space-x-3">
				<button type="button" onclick="document.getElementById('modal').remove()" class="btn-secondary">
					Cancel
				</button>
				@Button("Create", "primary")
			</div>
		</form>
	}
}
