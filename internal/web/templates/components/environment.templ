package components

import (
	"github.com/user/gocool/internal/models"
)

templ EnvironmentSwitcher(projectID string, envs []*models.Environment, currentEnvID string) {
	<div class="relative inline-block text-left">
		<div>
			<button type="button" class="inline-flex justify-center w-full rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" id="menu-button" aria-expanded="true" aria-haspopup="true" onclick="this.nextElementSibling.classList.toggle('hidden')">
				for _, e := range envs {
					if e.ID == currentEnvID {
						{ e.Name }
					}
				}
				if currentEnvID == "" && len(envs) > 0 {
					{ envs[0].Name }
				} else if len(envs) == 0 {
					No Environments
				}
				<svg class="-mr-1 ml-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
				</svg>
			</button>
		</div>

		<div class="hidden origin-top-right absolute left-0 mt-2 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-10" role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1">
			<div class="py-1" role="none">
				for _, e := range envs {
					<a href={ templ.URL("/projects/" + projectID + "?env=" + e.ID) } class="text-gray-700 block px-4 py-2 text-sm hover:bg-gray-100" role="menuitem" tabindex="-1">
						{ e.Name }
					</a>
				}
				<hr class="my-1"/>
				<button hx-get={ "/projects/" + projectID + "/envs/new" } hx-target="body" hx-swap="beforeend" class="text-indigo-600 block w-full text-left px-4 py-2 text-sm hover:bg-gray-100" role="menuitem" tabindex="-1">
					+ New Environment
				</button>
			</div>
		</div>
	</div>
}

templ CreateEnvironmentModal(projectID string, csrfToken string) {
	@Modal("Create New Environment") {
		<form hx-post={ "/projects/" + projectID + "/envs" } hx-swap="none">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			@Input("Environment Name", "name", "text", "", true)
			<p class="text-xs text-gray-500 mb-4">Examples: staging, qa, feature-x</p>
			
			<div class="mt-5 flex justify-end space-x-3">
				<button type="button" onclick="document.getElementById('modal').remove()" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
					Cancel
				</button>
				@Button("Create", "primary")
			</div>
		</form>
	}
}
