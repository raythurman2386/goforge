package components

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/pagination"
	"time"
)

// DeploymentListProps contains properties for the deployment list component.
type DeploymentListProps struct {
	Deployments []*models.Deployment
	Pagination  *pagination.Pagination
	ProjectID   string
	EnvID       string
}

templ DeploymentList(props DeploymentListProps) {
	@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
		@ui.CardHeader(nil) {
			<div>
				@ui.CardTitle(3, nil) {
					Deployment History
				}
				<p class="mt-1 text-sm text-muted-foreground">Recent deployments for this environment.</p>
			</div>
			if props.EnvID != "" {
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonPrimary,
					Size: ui.ButtonSM,
					Attrs: templ.Attributes{
						"hx-post": fmt.Sprintf("/projects/%s/deployments?env_id=%s", props.ProjectID, props.EnvID),
						"hx-disabled-elt": "this",
						"hx-indicator": "find .htmx-indicator",
					},
				}) {
					<svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
					Deploy Now
					@Spinner()
				}
			}
		}
		if len(props.Deployments) == 0 {
			@EmptyState(EmptyStateProps{
				Title:       "No deployments yet",
				Description: "Trigger your first deployment to see it here.",
				Icon:        "rocket",
				Compact:     true,
			})
		} else {
			<ul class="divide-y divide-divider">
				for _, d := range props.Deployments {
					@DeploymentRow(d, props.ProjectID)
				}
			</ul>
			if props.Pagination != nil && props.Pagination.ShowPagination() {
				@Pagination(props.Pagination)
			}
		}
	}
}

templ DeploymentRow(d *models.Deployment, projectID string) {
	<li class="hover:bg-muted/60 transition-colors">
		<a href={ templ.URL(fmt.Sprintf("/projects/%s/deployments/%s", projectID, d.ID)) } class="block">
			<div class="px-6 py-4">
				<div class="flex items-center justify-between">
					<div class="flex items-center">
						@DeploymentStatusBadge(d.Status)
						<p class="ml-3 text-sm font-medium text-foreground truncate">
							if d.CommitSHA.Valid {
								{ truncateCommit(d.CommitSHA.String) }
							} else {
								Manual Deploy
							}
						</p>
					</div>
					<div class="flex items-center space-x-4">
						@TriggerTypeBadge(d.TriggerType)
						<div class="text-sm text-muted-foreground">
							{ formatDuration(d.Duration()) }
						</div>
					</div>
				</div>
				<div class="mt-2 sm:flex sm:justify-between">
					<div class="sm:flex">
						if d.Branch.Valid {
							<p class="flex items-center text-sm text-muted-foreground">
								<svg class="flex-shrink-0 mr-1.5 h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
								</svg>
								{ d.Branch.String }
							</p>
						}
						if d.CommitMessage.Valid {
							<p class="mt-2 flex items-center text-sm text-muted-foreground sm:mt-0 sm:ml-6 truncate max-w-md">
								{ truncateMessage(d.CommitMessage.String, 60) }
							</p>
						}
					</div>
					<div class="mt-2 flex items-center text-sm text-muted-foreground sm:mt-0">
						<svg class="flex-shrink-0 mr-1.5 h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						{ formatTime(d.CreatedAt) }
					</div>
				</div>
			</div>
		</a>
	</li>
}

// DeploymentStatusBadge is StatusBadge for a deployment. The SSE handler
// renders it for the "status" event, so keep the name.
templ DeploymentStatusBadge(status models.DeploymentStatus) {
	@StatusBadge("deployment", string(status))
}

// TriggerTypeBadge labels how a deployment started: a square subtle badge,
// neutral for manual, primary for webhook, warning for rollback.
templ TriggerTypeBadge(trigger models.TriggerType) {
	switch trigger {
		case models.TriggerTypeManual:
			@ui.Badge(ui.BadgeProps{Tone: ui.BadgeNeutral, Variant: ui.BadgeSubtle, Square: true}) {
				Manual
			}
		case models.TriggerTypeWebhook:
			@ui.Badge(ui.BadgeProps{Tone: ui.BadgePrimary, Variant: ui.BadgeSubtle, Square: true}) {
				Webhook
			}
		case models.TriggerTypeRollback:
			@ui.Badge(ui.BadgeProps{Tone: ui.BadgeWarning, Variant: ui.BadgeSubtle, Square: true}) {
				Rollback
			}
	}
}

// Helper functions for formatting

func truncateCommit(sha string) string {
	if len(sha) > 7 {
		return sha[:7]
	}
	return sha
}

func truncateMessage(msg string, maxLen int) string {
	if len(msg) <= maxLen {
		return msg
	}
	return msg[:maxLen-3] + "..."
}

func formatDuration(d time.Duration) string {
	if d == 0 {
		return "-"
	}
	if d < time.Minute {
		return fmt.Sprintf("%ds", int(d.Seconds()))
	}
	if d < time.Hour {
		return fmt.Sprintf("%dm %ds", int(d.Minutes()), int(d.Seconds())%60)
	}
	return fmt.Sprintf("%dh %dm", int(d.Hours()), int(d.Minutes())%60)
}

func formatTime(t time.Time) string {
	now := time.Now()
	diff := now.Sub(t)

	if diff < time.Minute {
		return "just now"
	}
	if diff < time.Hour {
		mins := int(diff.Minutes())
		if mins == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", mins)
	}
	if diff < 24*time.Hour {
		hours := int(diff.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", hours)
	}
	if diff < 7*24*time.Hour {
		days := int(diff.Hours() / 24)
		if days == 1 {
			return "yesterday"
		}
		return fmt.Sprintf("%d days ago", days)
	}
	return t.Format("Jan 2, 2006")
}
