package components

// PageHeader is the page title block: title, optional subtitle, and an
// actions slot (children) on the right.
templ PageHeader(title, subtitle string) {
	@pageHeader(title, subtitle, nil) {
		{ children... }
	}
}

// PageHeaderWithBadge is PageHeader with a component (usually a StatusBadge
// inside an SSE swap target) next to the title.
templ PageHeaderWithBadge(title, subtitle string, badge templ.Component) {
	@pageHeader(title, subtitle, badge) {
		{ children... }
	}
}

templ pageHeader(title, subtitle string, badge templ.Component) {
	<div class="md:flex md:items-center md:justify-between gap-4 mb-8">
		<div class="flex-1 min-w-0">
			<div class="flex flex-wrap items-center gap-3">
				<h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl truncate">{ title }</h1>
				if badge != nil {
					@badge
				}
			</div>
			if subtitle != "" {
				<p class="mt-2 text-sm text-gray-500">{ subtitle }</p>
			}
		</div>
		<div class="mt-4 flex flex-wrap items-center gap-3 md:mt-0">
			{ children... }
		</div>
	</div>
}

// Crumb is one Breadcrumbs entry. The last entry is the current page and
// ignores Href.
type Crumb struct {
	Label string
	Href  string
}

templ Breadcrumbs(items []Crumb) {
	<nav class="mb-4" aria-label="Breadcrumb">
		<ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500">
			for i, c := range items {
				<li class="flex items-center gap-1.5">
					if i > 0 {
						<svg class="h-4 w-4 text-gray-300" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
							<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
						</svg>
					}
					if i == len(items)-1 {
						<span class="font-medium text-gray-700" aria-current="page">{ c.Label }</span>
					} else {
						<a href={ templ.SafeURL(c.Href) } class="font-medium hover:text-primary-700 transition-colors">{ c.Label }</a>
					}
				</li>
			}
		</ol>
	</nav>
}

// Alert is the soft notice box. level is "error", "warning", "info", or
// "success". Children are the message body.
templ Alert(level string) {
	<div
		class={ "flex gap-3 rounded-lg border p-4 text-sm", alertClass(level) }
		if level == "error" {
			role="alert"
		}
	>
		<svg class={ "h-5 w-5 flex-shrink-0", alertIconClass(level) } viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
			switch level {
				case "error":
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
				case "warning":
					<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
				case "success":
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
				default:
					<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			}
		</svg>
		<div class="min-w-0 flex-1">
			{ children... }
		</div>
	</div>
}

// AlertMessage is an Alert with a single line of text.
templ AlertMessage(level, message string) {
	@Alert(level) {
		<p class="font-medium">{ message }</p>
	}
}

func alertClass(level string) string {
	switch level {
	case "error":
		return "border-red-200 bg-red-50 text-red-800"
	case "warning":
		return "border-amber-200 bg-amber-50 text-amber-800"
	case "success":
		return "border-primary-200 bg-primary-50 text-primary-800"
	default:
		return "border-blue-200 bg-blue-50 text-blue-800"
	}
}

func alertIconClass(level string) string {
	switch level {
	case "error":
		return "text-red-400"
	case "warning":
		return "text-amber-400"
	case "success":
		return "text-primary-500"
	default:
		return "text-blue-400"
	}
}
