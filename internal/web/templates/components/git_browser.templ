package components

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"github.com/raythurman2386/goforge/internal/models"
)

templ GitRepositoryBrowser(sources []*models.GitSource) {
	@ui.Select(ui.SelectProps{
		ID:         "project-git-source",
		Name:       "git_source_id",
		Label:      "Git Source",
		Options:    gitSourceOptions(sources),
		Blank:      true,
		BlankLabel: "Manual / Public",
		Class:      "mb-4",
		Attrs: templ.Attributes{
			"hx-get":     "/api/git/repos",
			"hx-target":  "#project-repo-select",
			"hx-trigger": "change",
			"hx-include": "[name='git_source_id']",
			// app.js switches manual URL and repo select on change.
			"data-git-source-toggle": "",
		},
	})

	// app.js (data-git-source-toggle) keeps exactly one of these named
	// repository_url: the manual input when no source is picked, else the select.
	<div id="manual-repo-input">
		@ui.Input(ui.InputProps{ID: "project-repo-manual", Name: "repository_url_manual", Label: "Repository URL", Autocomplete: "off"})
	</div>

	<div id="repo-select-container" style="display:none;" class="mb-4">
		@ui.Select(ui.SelectProps{
			ID:         "project-repo-select",
			Name:       "repository_url",
			Label:      "Repository",
			Blank:      true,
			BlankLabel: "Select Source first",
			Attrs: templ.Attributes{
				"hx-get":     "/api/git/branches",
				"hx-target":  "#project-default-branch",
				"hx-trigger": "change",
				"hx-include": "[name='git_source_id']",
				"hx-vals":    "js:{repository_url: document.getElementById('project-repo-select').value}",
			},
		})
	</div>
}

// gitSourceOptions lists the user's git sources as "name (type)".
func gitSourceOptions(sources []*models.GitSource) []ui.SelectOption {
	opts := make([]ui.SelectOption, 0, len(sources))
	for _, s := range sources {
		opts = append(opts, ui.SelectOption{Value: s.ID, Label: s.Name + " (" + string(s.Type) + ")"})
	}
	return opts
}
