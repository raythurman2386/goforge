package components

import (
	"github.com/raythurman2386/goforge/internal/models"
)

templ VariableEditor(envID string, variables []*models.EnvVariable, csrfToken string, projectID string) {
	<div class="card !p-0 overflow-hidden">
		<div class="card-header">
			<div>
				<h3 class="card-title">Environment Variables</h3>
				<p class="mt-1 max-w-2xl text-sm text-gray-500">Variables for this environment.</p>
			</div>
			<div class="flex items-center gap-2">
				if projectID != "" {
					<button
						hx-post={ "/projects/" + projectID + "/envs/" + envID + "/variables/sync" }
						hx-swap="none"
						hx-headers={ `{"X-CSRF-Token": "` + csrfToken + `"}` }
						hx-disabled-elt="this"
						hx-indicator="find .htmx-indicator"
						class="btn-secondary btn-sm"
					>
						Sync from repo
						@Spinner()
					</button>
				}
				<button type="button" hx-get={ "/envs/" + envID + "/variables/new" } hx-target="body" hx-swap="beforeend" class="btn-primary btn-sm">
					+ Add Variable
				</button>
			</div>
		</div>
		
		<div class="card-body">
			if len(variables) == 0 {
				<p class="text-sm text-gray-500">No variables defined.</p>
			} else {
				<div class="space-y-2">
					for _, v := range variables {
						<div class="flex items-center gap-4 rounded-lg border border-gray-100 p-3 hover:bg-gray-50/60">
							<div class="flex-1 grid grid-cols-2 gap-4">
								<div class="text-sm font-mono font-medium text-gray-900">{ v.Key }</div>
								<div class="text-sm font-mono text-gray-500 truncate">
									if v.IsSecret {
										••••••••••••
									} else {
										{ v.Value }
									}
								</div>
							</div>
							<div class="flex items-center space-x-2">
								<button
									hx-delete={ "/envs/" + envID + "/variables/" + v.ID }
									hx-confirm="Delete this variable?"
									hx-swap="none"
									hx-headers={ `{"X-CSRF-Token": "` + csrfToken + `"}` }
									class="icon-btn hover:text-red-600 hover:bg-red-50"
									title="Delete"
									aria-label={ "Delete " + v.Key }
								>
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
								</button>
							</div>
						</div>
					}
				</div>
			}
		</div>
	</div>
}

templ AddVariableModal(envID string, csrfToken string) {
	@Modal("Add Environment Variable") {
		<form hx-post={ "/envs/" + envID + "/variables" } hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			@Input("Key", "key", "text", "", true)
			@Input("Value", "value", "text", "", true)
			
			<div class="flex items-center mb-4">
				<input id="is_secret" name="is_secret" type="checkbox" class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" />
				<label for="is_secret" class="ml-2 block text-sm text-gray-900">
					Is Secret (value will be masked)
				</label>
			</div>

			<div class="mt-5 flex justify-end space-x-3">
				<button type="button" data-modal-close class="btn-secondary">
					Cancel
				</button>
				@Button("Add Variable", "primary")
			</div>
		</form>
	}
}
