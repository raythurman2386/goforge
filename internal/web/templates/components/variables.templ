package components

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"github.com/raythurman2386/goforge/internal/models"
)

templ VariableEditor(envID string, variables []*models.EnvVariable, csrfToken string, projectID string) {
	@ui.Card(ui.CardProps{Flush: true, Class: "overflow-hidden"}) {
		@ui.CardHeader(nil) {
			<div>
				@ui.CardTitle(3, nil) {
					Environment Variables
				}
				<p class="mt-1 max-w-2xl text-sm text-muted-foreground">Variables for this environment.</p>
			</div>
			<div class="flex items-center gap-2">
				if projectID != "" {
					@ui.Button(ui.ButtonProps{
						Variant: ui.ButtonSecondary,
						Size: ui.ButtonSM,
						Attrs: templ.Attributes{
							"hx-post": "/projects/" + projectID + "/envs/" + envID + "/variables/sync",
							"hx-swap": "none",
							"hx-headers": `{"X-CSRF-Token": "` + csrfToken + `"}`,
							"hx-disabled-elt": "this",
							"hx-indicator": "find .htmx-indicator",
						},
					}) {
						Sync from repo
						@Spinner()
					}
				}
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonPrimary,
					Size: ui.ButtonSM,
					Attrs: ui.OpenDialogAttrs("/envs/" + envID + "/variables/new"),
				}) {
					+ Add Variable
				}
			</div>
		}
		
		@ui.CardContent(nil) {
			if len(variables) == 0 {
				<p class="text-sm text-muted-foreground">No variables defined.</p>
			} else {
				<div class="space-y-2">
					for _, v := range variables {
						<div class="flex items-center gap-4 rounded-lg border border-divider p-3 hover:bg-muted/60">
							<div class="flex-1 grid grid-cols-2 gap-4">
								<div class="text-sm font-mono font-medium text-foreground">{ v.Key }</div>
								<div class="text-sm font-mono text-muted-foreground truncate">
									if v.IsSecret {
										••••••••••••
									} else {
										{ v.Value }
									}
								</div>
							</div>
							<div class="flex items-center space-x-2">
								@ui.Button(ui.ButtonProps{
									Variant: ui.ButtonGhostDanger,
									Size: ui.ButtonIcon,
									Label: "Delete " + v.Key,
									Attrs: templ.Attributes{
										"hx-delete": "/envs/" + envID + "/variables/" + v.ID,
										"hx-confirm": "Delete this variable?",
										"data-ui-confirm-tone": "danger",
										"data-ui-confirm-label": "Delete",
										"hx-swap": "none",
										"hx-headers": `{"X-CSRF-Token": "` + csrfToken + `"}`,
										"title": "Delete",
									},
								}) {
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
								}
							</div>
						</div>
					}
				</div>
			}
		}
	}
}

templ AddVariableModal(envID string, csrfToken string) {
	@ui.Dialog(ui.DialogProps{Title: "Add Environment Variable"}) {
		<form hx-post={ "/envs/" + envID + "/variables" } hx-swap="none" hx-disabled-elt="find button[type='submit']" hx-indicator="find .htmx-indicator">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			@ui.Input(ui.InputProps{ID: "variable-key", Name: "key", Label: "Key", Autocomplete: "off", Required: true, Class: "mb-4", Attrs: templ.Attributes{"spellcheck": "false"}})
			@ui.Input(ui.InputProps{ID: "variable-value", Name: "value", Label: "Value", Autocomplete: "off", Required: true, Class: "mb-4", Attrs: templ.Attributes{"spellcheck": "false"}})
			@ui.Checkbox(ui.CheckboxProps{ID: "variable-secret", Name: "is_secret", Label: "Is Secret", Description: "The value will be masked.", Class: "mb-4"})

			<div class="mt-5 flex justify-end space-x-3">
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonSecondary,
					Attrs: templ.Attributes{
						"data-ui-dialog-close": true,
					},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: "submit"}) {
					Add Variable
					@Spinner()
				}
			</div>
		</form>
	}
}
