package components

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"time"

	"github.com/raythurman2386/goforge/internal/docker"
)

// ContainerCard summarizes one container from docker.SummarizeInspect, the
// same secret-free mapping /api/v1 returns. summary is nil when inspect
// failed; the card then says so and keeps the logs link.
templ ContainerCard(dockerID string, summary *docker.InspectSummary, class string) {
	@ui.Card(ui.CardProps{Flush: true, Class: ui.Class("overflow-hidden", class), Attrs: templ.Attributes{"id": "container-card", "data-container-card": true}}) {
		<div class="px-6 py-5 border-b border-divider bg-muted/30 flex items-center justify-between">
			<div>
				<h3 class="text-lg font-bold text-foreground tracking-tight">Container</h3>
				<p class="mt-1 text-sm text-foreground-secondary">What Docker reports for this container.</p>
			</div>
			<a href={ templ.SafeURL("/containers/" + dockerID) } class="text-sm text-primary-700 hover:text-primary-800 font-medium hover:underline dark:text-primary-400 dark:hover:text-primary-200">
				View logs &rarr;
			</a>
		</div>
		if summary == nil {
			<p class="px-6 py-5 text-sm text-foreground-secondary">Container details are not available: Docker did not answer for this container.</p>
		} else {
			<dl class="divide-y divide-divider">
				@containerRow("Image") {
					<span class="font-mono break-all">{ summary.Image }</span>
				}
				@containerRow("State") {
					@StatusBadge("container", summary.State)
				}
				@containerRow("Health") {
					{ containerHealth(summary) }
				}
				@containerRow("Started") {
					{ containerStarted(summary, time.Now()) }
				}
				@containerRow("Restarts") {
					{ fmt.Sprint(summary.RestartCount) }
					if summary.OOMKilled {
						@ui.Badge(ui.BadgeProps{Tone: ui.BadgeDanger, Variant: ui.BadgeSubtle, Square: true, Class: "ml-2 px-2 font-semibold"}) {
							OOM killed
						}
					}
				}
				@containerRow("Limits") {
					{ containerLimits(summary) }
				}
				@containerRow("Ports") {
					if ports := containerPorts(summary); len(ports) > 0 {
						for _, p := range ports {
							<div class="font-mono">{ p }</div>
						}
					} else {
						None
					}
				}
				if rules := summary.HostRules(); len(rules) > 0 {
					@containerRow("Traefik host rule") {
						for _, rule := range rules {
							<div class="font-mono break-all">{ rule }</div>
						}
					}
				}
			</dl>
		}
	}
}

templ containerRow(label string) {
	<div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
		<dt class="text-sm font-bold text-foreground-secondary uppercase tracking-wider">{ label }</dt>
		<dd class="mt-1 text-sm text-foreground sm:mt-0 sm:col-span-2">
			{ children... }
		</dd>
	</div>
}
