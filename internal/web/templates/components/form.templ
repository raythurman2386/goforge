package components

templ Input(label, name, inputType, value string, required bool) {
	<div class="mb-4">
		<label for={ name } class="label">
			{ label }
			if required {
				<span class="text-red-500">*</span>
			}
		</label>
		<input 
			id={ name }
			name={ name }
			type={ inputType }
			value={ value }
			if required {
				required
			}
			class="input"
		/>
	</div>
}

templ Button(text string, variant string) {
	<button
		type="submit"
		class={ "btn ",
			templ.KV("btn-primary", variant == "primary"),
			templ.KV("btn-secondary", variant == "secondary"),
			templ.KV("btn-danger", variant == "danger") }
	>
		{ text }
		@Spinner()
	</button>
}

templ Select(label, name string, options []string, selected string) {
	<div class="mb-4">
		<label for={ name } class="label">
			{ label }
		</label>
		<select
			id={ name }
			name={ name }
			class="select"
		>
			for _, opt := range options {
				<option value={ opt } if opt == selected { selected }>{ opt }</option>
			}
		</select>
	</div>
}

// Checkbox renders a bool config field. The hidden input after the checkbox
// sends "false" when it is unchecked; when checked the browser sends "true"
// first, and handlers read the first value.
templ Checkbox(label, name string, checked bool) {
	<div class="mb-4 flex items-center">
		<input
			id={ name }
			name={ name }
			type="checkbox"
			value="true"
			if checked {
				checked
			}
			class="h-4 w-4 rounded border-gray-300 text-primary-600 dark:border-gray-700 dark:text-primary-400"
		/>
		<input type="hidden" name={ name } value="false"/>
		<label for={ name } class="ml-2 block text-sm font-medium text-gray-700 dark:text-gray-300">
			{ label }
		</label>
	</div>
}

// ConfigSelect renders a select config field. An optional field gets a blank
// first choice.
templ ConfigSelect(label, name string, options []string, selected string, required bool) {
	<div class="mb-4">
		<label for={ name } class="label">
			{ label }
			if required {
				<span class="text-red-500">*</span>
			}
		</label>
		<select
			id={ name }
			name={ name }
			if required {
				required
			}
			class="select"
		>
			if !required {
				<option value="" if selected == "" { selected }></option>
			}
			for _, opt := range options {
				<option value={ opt } if opt == selected { selected }>{ opt }</option>
			}
		</select>
	</div>
}
