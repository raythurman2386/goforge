package components

templ Input(label, name, inputType, value string, required bool) {
	<div class="mb-4">
		<label for={ name } class="block text-sm font-medium text-gray-700 mb-1">
			{ label }
			if required {
				<span class="text-red-500">*</span>
			}
		</label>
		<input 
			id={ name }
			name={ name }
			type={ inputType }
			value={ value }
			if required {
				required
			}
			class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
		/>
	</div>
}

templ Button(text string, variant string) {
	<button
		type="submit"
		class={ "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 ",
			templ.KV("text-white bg-indigo-600 hover:bg-indigo-700 focus:ring-indigo-500", variant == "primary"),
			templ.KV("text-gray-700 bg-white border-gray-300 hover:bg-gray-50 focus:ring-indigo-500", variant == "secondary"),
			templ.KV("text-white bg-red-600 hover:bg-red-700 focus:ring-red-500", variant == "danger") }
	>
		{ text }
	</button>
}

templ Select(label, name string, options []string, selected string) {
	<div class="mb-4">
		<label for={ name } class="block text-sm font-medium text-gray-700 mb-1">
			{ label }
		</label>
		<select
			id={ name }
			name={ name }
			class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
		>
			for _, opt := range options {
				<option value={ opt } if opt == selected { selected }>{ opt }</option>
			}
		</select>
	</div>
}
