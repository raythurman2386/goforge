package components

import (
	"github.com/raythurman2386/goforge/internal/models"
)

templ Sidebar(projects []*models.Project) {
	<aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-64 glass border-r border-gray-200/60 transform -translate-x-full transition-transform duration-300 ease-in-out md:translate-x-0 md:static md:inset-0 bg-white h-full">
		<div class="h-full flex flex-col">
			<!-- Logo -->
			<div class="flex items-center h-16 px-6 border-b border-gray-200/60">
				<a href="/dashboard" class="flex items-center space-x-2">
					<div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center shadow-lg shadow-primary-200">
						<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
					</div>
					<span class="text-xl font-bold tracking-tight text-gray-900">GoForge</span>
				</a>
			</div>
			<!-- Main Navigation -->
			<nav class="px-4 py-6 space-y-1.5">
				<a href="/dashboard" class="sidebar-link-inactive">
					<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
					</svg>
					Dashboard
				</a>
				<a href="/projects" class="sidebar-link-inactive">
					<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
					</svg>
					Projects
				</a>
				<a href="/services" class="sidebar-link-inactive">
					<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
					</svg>
					Services
				</a>
				<a href="/settings/profile" class="sidebar-link-inactive">
					<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
					</svg>
					Profile
				</a>
				<a href="/settings/git" class="sidebar-link-inactive">
					<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
					</svg>
					Settings
				</a>
			</nav>
			<!-- Project List -->
			<div class="mt-4 flex-1 overflow-y-auto">
				<h3 class="px-6 text-[10px] font-bold text-gray-400 uppercase tracking-[0.1em]">
					Recent Projects
				</h3>
				<nav class="mt-3 px-4 space-y-1">
					for _, p := range projects {
						<a href={ templ.URL("/projects/" + p.ID) } class="sidebar-link-inactive justify-between group">
							<div class="flex items-center">
								<span class="w-1.5 h-1.5 mr-3 bg-primary-400 rounded-full group-hover:scale-125 transition-transform"></span>
								{ p.Name }
							</div>
						</a>
					}
					if len(projects) == 0 {
						<p class="px-3 py-2 text-xs text-gray-400 italic">No projects yet</p>
					}
				</nav>
			</div>
		</div>
	</aside>
}

