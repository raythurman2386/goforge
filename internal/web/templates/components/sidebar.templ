package components

import (
	"github.com/raythurman2386/goforge/internal/models"
)

templ Sidebar(projects []*models.Project) {
	<aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-72 bg-white/95 backdrop-blur-xl border-r border-gray-200/50 shadow-2xl md:shadow-none transform -translate-x-full transition-all duration-300 ease-in-out md:translate-x-0 md:static md:inset-0 h-full flex flex-col">
		<div class="flex-1 flex flex-col min-h-0">
			<!-- Logo -->
			<div class="flex-shrink-0 flex items-center h-16 px-6 border-b border-gray-100">
				<a href="/dashboard" class="flex items-center space-x-3 group">
					<div class="w-8 h-8 bg-primary-600 rounded-xl flex items-center justify-center shadow-lg shadow-primary-500/30 group-hover:scale-105 group-hover:shadow-primary-500/40 transition-all duration-200">
						<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
					</div>
					<span class="text-xl font-bold tracking-tight text-gray-900 group-hover:text-primary-600 transition-colors">GoForge</span>
				</a>
			</div>

			<!-- Main Navigation -->
			<div class="flex-1 overflow-y-auto py-6 px-4 space-y-8 no-scrollbar">
				<nav class="space-y-1.5">
					<a href="/dashboard" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 transition-all duration-200 group">
						<svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
						</svg>
						Dashboard
					</a>
					<a href="/projects" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 transition-all duration-200 group">
						<svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
						</svg>
						Projects
					</a>
					<a href="/services" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 transition-all duration-200 group">
						<svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
						</svg>
						Services
					</a>
				</nav>

				<!-- Project List -->
				<div>
					<h3 class="px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
						Recent Projects
					</h3>
					<nav class="space-y-1">
						for _, p := range projects {
							<a href={ templ.URL("/projects/" + p.ID) } class="flex items-center justify-between px-3 py-2.5 text-sm font-medium rounded-xl text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition-all duration-200 group">
								<div class="flex items-center truncate">
									<div class="w-2 h-2 mr-3 bg-primary-400 rounded-full group-hover:scale-150 transition-transform duration-200"></div>
									<span class="truncate">{ p.Name }</span>
								</div>
							</a>
						}
						if len(projects) == 0 {
							<p class="px-3 py-2 text-sm text-gray-400 italic">No projects yet</p>
						}
					</nav>
				</div>
			</div>

			<!-- Bottom settings navigation -->
			<div class="flex-shrink-0 p-4 border-t border-gray-100 bg-gray-50/50">
				<nav class="space-y-1">
					<a href="/settings/profile" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 transition-all duration-200 group">
						<svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
						</svg>
						Profile
					</a>
					<a href="/settings/git" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 transition-all duration-200 group">
						<svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
						Settings
					</a>
				</nav>
			</div>
		</div>
	</aside>
}

