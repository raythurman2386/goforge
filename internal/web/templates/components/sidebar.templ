package components

import (
	"github.com/raythurman2386/goforge/internal/auth"
	"github.com/raythurman2386/goforge/internal/models"
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
)

// MobileNavID is the id of the mobile navigation Sheet. The menu button in
// layouts.AppLayout opens it (ui.OpenSheetAttrs).
const MobileNavID = "mobile-nav"

// Sidebar renders the desktop app navigation: a static <aside>, shown from
// md up. Below md the same navigation (sidebarNav) renders in MobileNav, a
// Sheet. app.js marks every link whose data-nav prefix best matches the
// current path with aria-current="page"; the aria-[current=page] variants
// below style it.
//
// On md+ the aside is sticky and viewport-tall (md:h-screen) instead of
// stretching with <main>, so the settings footer (Log out) stays on screen
// however tall the page grows; the middle nav scrolls if the viewport is short.
// The footer names the signed-in user (from the request context) with an
// initials Avatar; it is omitted when there is no user.
templ Sidebar(csrfToken string) {
	<aside id="sidebar" aria-label="Sidebar" class="hidden w-72 flex-col border-r border-gray-200/50 bg-white/95 backdrop-blur-xl md:sticky md:top-0 md:flex md:h-screen md:flex-shrink-0 dark:border-gray-800/50 dark:bg-gray-900/95">
		<div class="flex-1 flex flex-col min-h-0">
			<!-- Logo -->
			<div class="flex-shrink-0 flex items-center h-16 px-6 border-b border-gray-100 dark:border-gray-800">
				<a href="/dashboard" aria-label="GoForge Home" class="flex items-center space-x-3 group">
					<div class="w-8 h-8 bg-primary-600 rounded-xl flex items-center justify-center shadow-lg shadow-primary-500/30 group-hover:scale-105 group-hover:shadow-primary-500/40 transition-all duration-200">
						<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
					</div>
					<span class="text-xl font-bold tracking-tight text-gray-900 group-hover:text-primary-600 transition-colors dark:text-gray-100 dark:group-hover:text-primary-400">GoForge</span>
				</a>
			</div>

			@sidebarNav(csrfToken)
		</div>
	</aside>
}

// MobileNav is the navigation Sheet for small screens. It closes itself
// when the viewport reaches md, where Sidebar shows the same links.
templ MobileNav(csrfToken string) {
	@ui.Sheet(ui.SheetProps{ID: MobileNavID, Title: "Menu", Side: ui.SheetLeft, CloseAt: "(min-width: 768px)", Class: "md:hidden"}) {
		@sidebarNav(csrfToken)
	}
}

// sidebarNav is the main navigation and the settings footer, shared by the
// desktop Sidebar and the MobileNav sheet.
templ sidebarNav(csrfToken string) {
	<!-- Main Navigation -->
	<div class="flex-1 overflow-y-auto py-6 px-4 space-y-8">
		<nav class="space-y-1.5" aria-label="Main navigation">
			<a href="/dashboard" data-nav="/dashboard" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 dark:aria-[current=page]:bg-primary-900/30 dark:aria-[current=page]:text-primary-300 transition-all duration-200 group dark:text-gray-300 dark:hover:text-primary-300 dark:hover:bg-primary-900/30">
				<svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-primary-500 group-aria-[current=page]:text-primary-500 dark:group-aria-[current=page]:text-primary-400 transition-colors dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
				</svg>
				Dashboard
			</a>
			<a href="/projects" data-nav="/projects" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 dark:aria-[current=page]:bg-primary-900/30 dark:aria-[current=page]:text-primary-300 transition-all duration-200 group dark:text-gray-300 dark:hover:text-primary-300 dark:hover:bg-primary-900/30">
				<svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-primary-500 group-aria-[current=page]:text-primary-500 dark:group-aria-[current=page]:text-primary-400 transition-colors dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
				</svg>
				Projects
			</a>
			<a href="/services" data-nav="/services" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 dark:aria-[current=page]:bg-primary-900/30 dark:aria-[current=page]:text-primary-300 transition-all duration-200 group dark:text-gray-300 dark:hover:text-primary-300 dark:hover:bg-primary-900/30">
				<svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-primary-500 group-aria-[current=page]:text-primary-500 dark:group-aria-[current=page]:text-primary-400 transition-colors dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
				</svg>
				Services
			</a>
			<a href="/containers" data-nav="/containers" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 dark:aria-[current=page]:bg-primary-900/30 dark:aria-[current=page]:text-primary-300 transition-all duration-200 group dark:text-gray-300 dark:hover:text-primary-300 dark:hover:bg-primary-900/30">
				<svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-primary-500 group-aria-[current=page]:text-primary-500 dark:group-aria-[current=page]:text-primary-400 transition-colors dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
				</svg>
				Containers
			</a>
		</nav>
	</div>

	<!-- Bottom settings navigation -->
	<div class="flex-shrink-0 p-4 border-t border-gray-100 bg-gray-50/50 dark:border-gray-800 dark:bg-gray-800/50">
		if user := auth.GetUserFromContext(ctx); user != nil {
			<div class="mb-3 flex items-center gap-3 px-3" data-sidebar-user>
				@ui.Avatar(ui.AvatarProps{Name: UserDisplayName(user), Size: ui.AvatarSM})
				<div class="min-w-0">
					<p class="truncate text-sm font-medium text-foreground">{ UserDisplayName(user) }</p>
					if UserDisplayName(user) != user.Email {
						<p class="truncate text-xs text-muted-foreground">{ user.Email }</p>
					}
				</div>
			</div>
		}
		<nav class="space-y-1" aria-label="Settings navigation">
			<a href="/settings/profile" data-nav="/settings/profile" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 dark:aria-[current=page]:bg-primary-900/30 dark:aria-[current=page]:text-primary-300 transition-all duration-200 group dark:text-gray-300 dark:hover:text-primary-300 dark:hover:bg-primary-900/30">
				<svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-primary-500 group-aria-[current=page]:text-primary-500 dark:group-aria-[current=page]:text-primary-400 transition-colors dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
				</svg>
				Profile
			</a>
			<a href="/settings/activity" data-nav="/settings/activity" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 dark:aria-[current=page]:bg-primary-900/30 dark:aria-[current=page]:text-primary-300 transition-all duration-200 group dark:text-gray-300 dark:hover:text-primary-300 dark:hover:bg-primary-900/30">
				<svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-primary-500 group-aria-[current=page]:text-primary-500 dark:group-aria-[current=page]:text-primary-400 transition-colors dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
				</svg>
				Activity
			</a>
			<a href="/settings/git" data-nav="/settings/git" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-primary-700 hover:bg-primary-50 aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 dark:aria-[current=page]:bg-primary-900/30 dark:aria-[current=page]:text-primary-300 transition-all duration-200 group dark:text-gray-300 dark:hover:text-primary-300 dark:hover:bg-primary-900/30">
				<svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-primary-500 group-aria-[current=page]:text-primary-500 dark:group-aria-[current=page]:text-primary-400 transition-colors dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
				</svg>
				Settings
			</a>
			<form action="/auth/logout" method="POST">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<button type="submit" class="w-full flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-gray-700 hover:text-red-700 hover:bg-red-50 transition-all duration-200 group dark:text-gray-300 dark:hover:text-red-300 dark:hover:bg-red-950/40">
					<svg class="w-5 h-5 mr-3 text-gray-500 group-hover:text-red-500 transition-colors dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
					</svg>
					Log out
				</button>
			</form>
		</nav>
	</div>
}



// UserDisplayName is the name shown for a user: the GitHub username when
// linked, otherwise the email address.
func UserDisplayName(u *models.User) string {
	if u.GitHubUsername.Valid && u.GitHubUsername.String != "" {
		return u.GitHubUsername.String
	}
	return u.Email
}
