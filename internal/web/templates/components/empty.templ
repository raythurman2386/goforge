package components

import "github.com/raythurman2386/goforge/internal/web/templates/components/ui"

// EmptyStateProps configures EmptyState. Set at most one action: ButtonURL
// for a plain link, HxGet for a fragment (such as a modal) appended to
// <body>, or HxPost for an action. Icon picks a glyph: "inbox" (default),
// "folder", "rocket", "key", "code", or "server". Compact drops the dashed
// card for use inside an existing card.
type EmptyStateProps struct {
	Title       string
	Description string
	ButtonText  string
	ButtonURL   string
	HxGet       string
	HxPost      string
	Icon        string
	Compact     bool
}

templ EmptyState(p EmptyStateProps) {
	if p.Compact {
		<div class="py-8 text-center">
			@emptyStateBody(p)
		</div>
	} else {
		@ui.Card(ui.CardProps{Class: "py-16 text-center bg-gray-50/30 border-dashed border-2 border-gray-200 shadow-none dark:bg-gray-800/50 dark:border-gray-800"}) {
			@emptyStateBody(p)
		}
	}
}

templ emptyStateBody(p EmptyStateProps) {
	<div
		class={ "bg-white rounded-2xl shadow-sm border border-gray-100 flex items-center justify-center mx-auto dark:bg-gray-900 dark:border-gray-800",
			templ.KV("w-16 h-16 mb-5", !p.Compact),
			templ.KV("w-12 h-12 mb-3", p.Compact) }
	>
		<svg class={ "text-gray-400", templ.KV("h-8 w-8", !p.Compact), templ.KV("h-6 w-6", p.Compact) } fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
			@emptyIcon(p.Icon)
		</svg>
	</div>
	<h3 class={ "font-bold text-gray-900 tracking-tight dark:text-gray-100", templ.KV("text-xl", !p.Compact), templ.KV("text-base", p.Compact) }>{ p.Title }</h3>
	if p.Description != "" {
		<p class="mt-2 text-sm text-gray-500 max-w-sm mx-auto leading-relaxed dark:text-gray-400">{ p.Description }</p>
	}
	if p.ButtonText != "" {
		<div class={ templ.KV("mt-8", !p.Compact), templ.KV("mt-4", p.Compact) }>
			if p.HxGet != "" {
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonPrimary,
					Attrs: templ.Attributes{
						"hx-get": p.HxGet,
						"hx-target": "body",
						"hx-swap": "beforeend",
					},
				}) {
					@plusIcon()
					{ p.ButtonText }
				}
			} else if p.HxPost != "" {
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonPrimary,
					Attrs: templ.Attributes{
						"hx-post": p.HxPost,
						"hx-disabled-elt": "this",
						"hx-indicator": "find .htmx-indicator",
					},
				}) {
					@plusIcon()
					{ p.ButtonText }
					@Spinner()
				}
			} else {
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Href: templ.SafeURL(p.ButtonURL)}) {
					@plusIcon()
					{ p.ButtonText }
				}
			}
		</div>
	}
}

templ plusIcon() {
	<svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
	</svg>
}

templ emptyIcon(name string) {
	switch name {
		case "folder":
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
		case "rocket":
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
		case "key":
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
		case "code":
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
		case "server":
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
		default:
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-3m-9 0H3m9 9v1m0-4v1m0-4v1"></path>
	}
}
