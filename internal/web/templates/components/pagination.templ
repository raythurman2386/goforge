package components

import (
	"github.com/raythurman2386/goforge/internal/web/templates/components/ui"
	"fmt"
	"strconv"

	"github.com/raythurman2386/goforge/internal/pagination"
)

// Pagination renders pagination controls.
templ Pagination(p *pagination.Pagination) {
	if p.ShowPagination() {
		<nav class="flex items-center justify-between border-t border-divider bg-card px-6 py-3" aria-label="Pagination">
			<div class="hidden sm:block">
				<p class="text-sm text-foreground-secondary">
					Showing
					<span class="font-medium">{ strconv.Itoa(p.StartItem()) }</span>
					to
					<span class="font-medium">{ strconv.Itoa(p.EndItem()) }</span>
					of
					<span class="font-medium">{ strconv.Itoa(p.Total) }</span>
					results
				</p>
			</div>
			<div class="flex flex-1 justify-between sm:justify-end">
				if p.HasPrevious() {
					@ui.Button(ui.ButtonProps{
						Variant: ui.ButtonSecondary,
						Size: ui.ButtonSM,
						Href: templ.URL(p.PreviousURL()),
						Attrs: templ.Attributes{
							"hx-get": p.PreviousURL(),
							"hx-target": "#content",
							"hx-push-url": "true",
						},
					}) {
						Previous
					}
				} else {
					<span class={ ui.ButtonClass(ui.ButtonSecondary, ui.ButtonSM) } aria-disabled="true">
						Previous
					</span>
				}
				if p.HasNext() {
					@ui.Button(ui.ButtonProps{
						Variant: ui.ButtonSecondary,
						Size: ui.ButtonSM,
						Href: templ.URL(p.NextURL()),
						Class: "ml-3",
						Attrs: templ.Attributes{
							"hx-get": p.NextURL(),
							"hx-target": "#content",
							"hx-push-url": "true",
						},
					}) {
						Next
					}
				} else {
					<span class={ ui.Class(ui.ButtonClass(ui.ButtonSecondary, ui.ButtonSM), "ml-3") } aria-disabled="true">
						Next
					</span>
				}
			</div>
		</nav>
	}
}

// PaginationFull renders full pagination with page numbers.
templ PaginationFull(p *pagination.Pagination) {
	if p.ShowPagination() {
		<nav class="flex items-center justify-between border-t border-divider bg-card px-6 py-3" aria-label="Pagination">
			<div class="hidden sm:block">
				<p class="text-sm text-foreground-secondary">
					Showing
					<span class="font-medium">{ strconv.Itoa(p.StartItem()) }</span>
					to
					<span class="font-medium">{ strconv.Itoa(p.EndItem()) }</span>
					of
					<span class="font-medium">{ strconv.Itoa(p.Total) }</span>
					results
				</p>
			</div>
			<div class="flex flex-1 items-center justify-between sm:justify-end">
				<div class="flex items-center space-x-1">
					// First page button
					if p.Page > 2 {
						@ui.Button(ui.ButtonProps{
							Variant: ui.ButtonSecondary,
							Size: ui.ButtonSM,
							Href: templ.URL(p.FirstURL()),
							Class: "!px-2 text-muted-foreground",
							Attrs: templ.Attributes{
								"hx-get": p.FirstURL(),
								"hx-target": "#content",
								"hx-push-url": "true",
								"title": "First page",
							},
						}) {
							<span class="sr-only">First</span>
							<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M15.79 14.77a.75.75 0 01-1.06.02l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 111.04 1.08L11.832 10l3.938 3.71a.75.75 0 01.02 1.06zm-6 0a.75.75 0 01-1.06.02l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 111.04 1.08L5.832 10l3.938 3.71a.75.75 0 01.02 1.06z" clip-rule="evenodd"></path>
							</svg>
						}
					}
					// Previous button
					if p.HasPrevious() {
						@ui.Button(ui.ButtonProps{
							Variant: ui.ButtonSecondary,
							Size: ui.ButtonSM,
							Href: templ.URL(p.PreviousURL()),
							Class: "!px-2 text-muted-foreground",
							Attrs: templ.Attributes{
								"hx-get": p.PreviousURL(),
								"hx-target": "#content",
								"hx-push-url": "true",
							},
						}) {
							<span class="sr-only">Previous</span>
							<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd"></path>
							</svg>
						}
					}
					// Page numbers
					for _, pageNum := range p.PageRange(5) {
						if pageNum == p.Page {
							<span class={ ui.ButtonClass(ui.ButtonPrimary, ui.ButtonSM) } aria-current="page">
								{ strconv.Itoa(pageNum) }
							</span>
						} else {
							@ui.Button(ui.ButtonProps{
								Variant: ui.ButtonSecondary,
								Size: ui.ButtonSM,
								Href: templ.URL(p.PageURL(pageNum)),
								Attrs: templ.Attributes{
									"hx-get": p.PageURL(pageNum),
									"hx-target": "#content",
									"hx-push-url": "true",
								},
							}) {
								{ strconv.Itoa(pageNum) }
							}
						}
					}
					// Next button
					if p.HasNext() {
						@ui.Button(ui.ButtonProps{
							Variant: ui.ButtonSecondary,
							Size: ui.ButtonSM,
							Href: templ.URL(p.NextURL()),
							Class: "!px-2 text-muted-foreground",
							Attrs: templ.Attributes{
								"hx-get": p.NextURL(),
								"hx-target": "#content",
								"hx-push-url": "true",
							},
						}) {
							<span class="sr-only">Next</span>
							<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
							</svg>
						}
					}
					// Last page button
					if p.Page < p.TotalPages-1 {
						@ui.Button(ui.ButtonProps{
							Variant: ui.ButtonSecondary,
							Size: ui.ButtonSM,
							Href: templ.URL(p.LastURL()),
							Class: "!px-2 text-muted-foreground",
							Attrs: templ.Attributes{
								"hx-get": p.LastURL(),
								"hx-target": "#content",
								"hx-push-url": "true",
								"title": "Last page",
							},
						}) {
							<span class="sr-only">Last</span>
							<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M4.21 5.23a.75.75 0 011.06-.02l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08L8.168 10 4.23 6.29a.75.75 0 01-.02-1.06zm6 0a.75.75 0 011.06-.02l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08L14.168 10l-3.938-3.71a.75.75 0 01-.02-1.06z" clip-rule="evenodd"></path>
							</svg>
						}
					}
				</div>
			</div>
		</nav>
	}
}

// PaginationInfo renders just the item count info (e.g., "Showing 1 to 20 of 100 results").
templ PaginationInfo(p *pagination.Pagination) {
	<p class="text-sm text-foreground-secondary">
		if p.IsEmpty() {
			No results found
		} else {
			Showing
			<span class="font-medium">{ strconv.Itoa(p.StartItem()) }</span>
			to
			<span class="font-medium">{ strconv.Itoa(p.EndItem()) }</span>
			of
			<span class="font-medium">{ strconv.Itoa(p.Total) }</span>
			results
		}
	</p>
}

// PerPageSelector renders a dropdown to select items per page.
templ PerPageSelector(p *pagination.Pagination, options []int) {
	<div class="flex items-center space-x-2">
		@ui.Label(ui.LabelProps{For: "per-page", Class: "mb-0 font-normal"}) {
			Show
		}
		@ui.Select(ui.SelectProps{
			ID:           "per-page",
			Name:         "per_page",
			Options:      perPageOptions(options),
			Selected:     strconv.Itoa(p.PerPage),
			ControlClass: "w-auto py-1.5",
			Attrs: templ.Attributes{
				"hx-get":      p.BaseURL,
				"hx-target":   "#content",
				"hx-push-url": "true",
				"hx-include":  "[name='page']",
			},
		})
	</div>
}

// perPageOptions renders page sizes as "N per page".
func perPageOptions(sizes []int) []ui.SelectOption {
	opts := make([]ui.SelectOption, 0, len(sizes))
	for _, n := range sizes {
		opts = append(opts, ui.SelectOption{Value: strconv.Itoa(n), Label: fmt.Sprintf("%d per page", n)})
	}
	return opts
}
