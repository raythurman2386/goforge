package components

// LoadingState is the block placeholder shown while a region loads (lists,
// stats panels). It is not an htmx indicator: it is replaced by the swap.
templ LoadingState(label string) {
	<div class="flex flex-col items-center justify-center gap-2 py-8 text-sm text-gray-500" role="status">
		<svg class="h-6 w-6 animate-spin text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
			<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
			<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
		</svg>
		if label != "" {
			<span>{ label }</span>
		}
	</div>
}

// Skeleton is a pulsing placeholder bar. class sets its size, for example
// "h-8 w-24".
templ Skeleton(class string) {
	<div class={ "animate-pulse rounded-lg bg-gray-200", class } aria-hidden="true"></div>
}

// Spinner is a small inline request indicator. It uses the .htmx-indicator
// class from input.css, so it is hidden until the element named by
// hx-indicator (or an ancestor) carries htmx-request.
templ Spinner() {
	<svg class="htmx-indicator animate-spin ml-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
		<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
		<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
	</svg>
}
