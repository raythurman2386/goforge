package components

templ Nav() {
	<nav class="bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between h-16">
				<div class="flex">
					<div class="flex-shrink-0 flex items-center">
						<a href="/dashboard" class="text-xl font-bold text-gray-900">
							GoForge
						</a>
					</div>
				</div>
				<div class="flex items-center">
					<form action="/auth/logout" method="POST">
						// CSRF token will be added by middleware/JS or manually if needed
						<button type="submit" class="ml-4 px-4 py-2 border border-transparent text-sm font-medium rounded-md text-gray-700 bg-gray-100 hover:bg-gray-200 focus:outline-none">
							Logout
						</button>
					</form>
				</div>
			</div>
		</div>
	</nav>
}
