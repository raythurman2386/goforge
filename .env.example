# GoForge Environment Configuration
# Copy to .env and fill in your values
#
# Quick Start for Development:
#   1. Copy this file: cp .env.example .env
#   2. Set GOFORGE_DEV_MODE=true (auto-generates secrets)
#   3. Run: docker compose up -d
#   4. Visit: http://localhost:8080

# =============================================================================
# Development Mode
# =============================================================================

# Enable development mode (auto-generates secrets, relaxed validation, debug logging)
# Set to true for local development, false for production
GOFORGE_DEV_MODE=true

# =============================================================================
# Server
# =============================================================================

# Host to bind to (default: 0.0.0.0)
GOFORGE_HOST=0.0.0.0

# Port to listen on (default: 8080)
GOFORGE_PORT=8080

# Public base URL (used for OAuth callbacks, webhooks, etc.)
# In production, set this to your actual domain
GOFORGE_BASE_URL=http://localhost:8080

# Domain for Traefik routing (used in docker-compose labels)
# In production, set this to your domain without https://
GOFORGE_DOMAIN=localhost

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# Database connection URL (PostgreSQL)
# For Docker Compose: postgres://goforge:password@db:5432/goforge?sslmode=disable
# For local dev: postgres://goforge:password@localhost:5432/goforge?sslmode=disable
DATABASE_URL=postgres://goforge:password@db:5432/goforge?sslmode=disable

# PostgreSQL container credentials (used by docker-compose db service)
# These should match the credentials in DATABASE_URL
POSTGRES_USER=goforge
POSTGRES_PASSWORD=password
POSTGRES_DB=goforge

# =============================================================================
# Security (required in production, auto-generated in dev mode)
# =============================================================================

# 32-byte encryption key for secrets (base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Secret for session cookie signing
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Secret for CSRF token generation
# Generate with: openssl rand -base64 32
CSRF_SECRET=

# =============================================================================
# GitHub OAuth (required for GitHub login)
# =============================================================================

# Create an OAuth App at: https://github.com/settings/developers
# Set callback URL to: {GOFORGE_BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Docker
# =============================================================================

# Docker host (default: unix socket)
DOCKER_HOST=unix:///var/run/docker.sock

# =============================================================================
# Traefik / Reverse Proxy
# =============================================================================

# Docker network that Traefik uses for service discovery
TRAEFIK_NETWORK=traefik

# Email for Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# Traefik dashboard port (access at http://localhost:8081)
TRAEFIK_DASHBOARD_PORT=8081

# Enable insecure dashboard access (set to true for local dev only!)
# WARNING: Never enable this in production
TRAEFIK_DASHBOARD_INSECURE=false

# Traefik logging level: DEBUG, INFO, WARN, ERROR (default: INFO)
TRAEFIK_LOG_LEVEL=INFO

# =============================================================================
# Service Templates
# =============================================================================

# Directory containing service template YAML files
TEMPLATES_DIR=./templates

# =============================================================================
# Deployment Limits
# =============================================================================

# Maximum concurrent builds (default: 2)
MAX_CONCURRENT_BUILDS=2

# Build timeout in Go duration format (default: 15m)
BUILD_TIMEOUT=15m

# =============================================================================
# Monitoring
# =============================================================================

# Enable Prometheus metrics endpoint at /metrics (default: true)
ENABLE_METRICS=true

# How long to retain container metrics (default: 168h = 7 days)
METRICS_RETENTION=168h

# =============================================================================
# Logging
# =============================================================================

# Log level: debug, info, warn, error (default: info, debug in dev mode)
LOG_LEVEL=info

# Log format: json, text (default: json, text in dev mode)
LOG_FORMAT=json
