# GoForge Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# Development Mode
# =============================================================================

# Enable development mode (auto-generates secrets, uses SQLite, relaxed validation)
# Set to true for local development, false for production
GOFORGE_DEV_MODE=false

# =============================================================================
# Server
# =============================================================================

# Host to bind to (default: 0.0.0.0)
GOFORGE_HOST=0.0.0.0

# Port to listen on (default: 8080)
GOFORGE_PORT=8080

# Public base URL (used for OAuth callbacks, webhooks, etc.)
GOFORGE_BASE_URL=http://localhost:8080

# =============================================================================
# Database
# =============================================================================

# Database connection URL
# For SQLite (default in dev mode): sqlite://./data/goforge.db
# For PostgreSQL: postgres://user:password@localhost:5432/goforge?sslmode=disable
DATABASE_URL=postgres://goforge:password@localhost:5432/goforge?sslmode=disable

# =============================================================================
# Security (required in production, auto-generated in dev mode)
# =============================================================================

# 32-byte encryption key for secrets (base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Secret for session cookie signing
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Secret for CSRF token generation
# Generate with: openssl rand -base64 32
CSRF_SECRET=

# =============================================================================
# GitHub OAuth (required for GitHub login)
# =============================================================================

# Create an OAuth App at: https://github.com/settings/developers
# Set callback URL to: {GOFORGE_BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Docker
# =============================================================================

# Docker host (default: unix socket)
DOCKER_HOST=unix:///var/run/docker.sock

# =============================================================================
# Traefik / Reverse Proxy
# =============================================================================

# Docker network that Traefik uses
TRAEFIK_NETWORK=traefik

# Email for Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# =============================================================================
# Service Templates
# =============================================================================

# Directory containing service template YAML files
TEMPLATES_DIR=./templates

# =============================================================================
# Deployment Limits
# =============================================================================

# Maximum concurrent builds (default: 2)
MAX_CONCURRENT_BUILDS=2

# Build timeout in Go duration format (default: 15m)
BUILD_TIMEOUT=15m

# =============================================================================
# Monitoring
# =============================================================================

# Enable Prometheus metrics endpoint at /metrics (default: true)
ENABLE_METRICS=true

# How long to retain container metrics (default: 168h = 7 days)
METRICS_RETENTION=168h

# =============================================================================
# Logging
# =============================================================================

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Log format: json, text (default: json)
LOG_FORMAT=json
